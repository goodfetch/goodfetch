# Local secrets for developing and testing Goodfetch (ADR 0076).
#
# Copy nothing by hand: run `scripts/env-setup.sh`, which asks for each value
# without echoing it and writes `.env` (git-ignored, readable only by you).
# Leave a value empty until the milestone that needs it.
#
# Tests never read this file: test support starts every test with a cleared
# environment (ADR 0059). Only the recipes that run Live checks load it.
# CI reads the same names from GitHub Actions secrets, never from this file.
#
# Format of each entry, read by the script:
#   # <what it is> | needed from: <milestone> | create: <page>
#   NAME=

# Vercel AI Gateway key: every live model call (provider check, recordings, Evaluations, skill Evaluations) goes through it, on the free monthly credit and free-tier models only; never buy credits, keep auto top-up and the billable add-ons off | needed from: M4 (optional earlier for local experiments) | create: https://vercel.com/d?to=%2F%5Bteam%5D%2F%7E%2Fai-gateway%2Fapi-keys&title=AI+Gateway+API+Keys
AI_GATEWAY_API_KEY=

# Hugging Face read token, only for downloading gated local models (public GGUF models need none) | needed from: M4, optional | create: https://huggingface.co/settings/tokens
HF_TOKEN=

# Zapier deploy key for the Zapier Integration's `zapier validate` and test Zaps (free developer account) | needed from: M4 | create: https://developer.zapier.com/partner-settings/deploy-keys/
ZAPIER_DEPLOY_KEY=

# Make API token (free plan; create it in your profile, API tab, with the scenarios and connections scopes) | needed from: M4 | create: https://www.make.com/en/login (avatar, bottom left > Profile > API > Add token)
MAKE_API_TOKEN=

# Make zone host of your account, for example eu1.make.com or us1.make.com (not a secret) | needed from: M4 | create: shown in your browser's address bar after signing in to Make
MAKE_ZONE=

# Pipedream user API key (free plan) | needed from: M4 | create: https://pipedream.com/user (My Account > API Key)
PIPEDREAM_API_KEY=

# Power Apps Developer Plan environment URL for the Power Automate Integration's account check, for example https://org1234abcd.crm.dynamics.com (not a secret; sign-in stays interactive, so no password or client secret is stored) | needed from: M4 | create: https://www.microsoft.com/en-us/power-platform/products/power-apps/free (then the environment's URL in https://admin.powerplatform.microsoft.com/)
POWER_PLATFORM_ENVIRONMENT_URL=

# LocalStack auth token for the AWS queue and stream Sink suites (SQS, SNS, Kinesis, Firehose), on LocalStack's free open-source licence only; if it is refused, those suites use free emulators or wait | needed from: the first pull request with an AWS queue or stream Sink suite | create: https://app.localstack.cloud/ (Auth Tokens, after the open-source licence is granted)
LOCALSTACK_AUTH_TOKEN=
