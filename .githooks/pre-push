#!/usr/bin/env bash
# Opt in with `just hooks`: runs the pre-push tier, `just quick`, before a push;
# it picks the docs gate's checks for a change of documents alone (TESTING.md).
# It runs no check twice on one tree (TESTING.md, Checks by role; ADR 0135's
# amendment of 2026-11-22): a push whose heads a green `just quick` already
# holds (`just _quick-held`: a run on the same tree against the same base, on
# this host and in this environment, within a day, which any worktree's
# layer recorded in the gate's records) runs no `just quick`. Otherwise
# `just quick` runs as the layer `pre-push`, which its record names, and
# reads the change against the commit the remote ref holds, so it checks
# what the push adds, when the push only adds the branch's own commits to
# it. After a rebase, or a merge of the branch's own base (ci/change-base.sh:
# its integration branch, else `origin/main`, or `GOODFETCH_QUICK_BASE` when
# the pusher names one), that commit is no base: read against it, the change
# would hold every file the base gained since. The hook then says so in one
# line and gives `just quick` no base of its own, so it reads the change
# against the branch's own. Each pushed head is held against the base `just
# quick` would read it against.
#
# A held run says nothing of the messages of the commits that hold its tree,
# since a reworded commit keeps its tree. So every push first judges the
# sign-offs (`just dco`) and the subjects (`just commit-messages`) of each
# pushed head's commits since its merge base with `origin/main`, as the gate
# does at merge, and a red one refuses the push before `just quick` runs:
# such a commit is only mended by rewriting it, after which a gate that ran
# on it reuses nothing (ADR 0135). Each records the commits it judged green
# in the gate's records, so neither this hook nor `just merge` judges one of
# them again; a reworded commit is another commit, and is judged. A head a
# green run holds also takes the floor guard (`just floor-guard`), which
# reads the commits' `Quality-change:` trailers, and the scan for secrets
# (`just commit-leaks`), which reads each commit's patch, against the base it
# was held against, as a held `just quick` runs them: a reword, or a history
# that adds a secret and removes it again, keeps the tree (issue 3497). A
# head that is due takes both from `just quick`.
#
# A push of a branch the hosted tier serves, a batch's or a spec's (`batch/…`,
# `spec/<n>`) with an open pull request to `main` while the pull-request
# workflow is active, judges its commits alone: the hosted run the push
# starts runs the Quick suite, and `just merge` waits for it (ADR 0135's
# amendment of 2026-11-22). When GitHub cannot say, the hook keeps the rule
# above.
#
# A push to `spec/<n>`, a run's ticket, runs no `just quick`: the batch that
# holds the spec's pull request runs it once on the combined tree (`just
# batch-check`; TESTING.md, Checks by role, the owner's decision of
# 2026-11-23). Its commits are judged all the same, and it runs the static
# steps that take seconds and that a red batch-check, a rerun of the whole
# batch, would otherwise be the first to name: the floor guard over what each
# pushed head adds to `origin/main` (`just floor-guard`), and the module check
# (`xtask modules`), which reads the checkout, so it runs when the checkout's
# head is among those pushed. A red one refuses the push. Clippy over the
# touched crates stays in the batch: warm, over one crate, it took 24
# seconds for xtask and 35 for goodfetch-engine (2026-11-23), against under
# a second for the floor guard and about 11 for the module check.
#
# When that head's change against `origin/main` also reaches a file the
# drift checks read (`drift_paths` below: the SDKs and the Products' crates
# they mirror, the protocol crate, the Compatibility corpus and its writers'
# launchers, the client conformance cases, a settings module, a generated
# folder, a source codegen reads, or a step's own code), the push runs them
# too: the xtask steps of `just lint-drift` and `just lint`'s containment
# check, which read the checkout as the module check does, then all of
# xtask's Quick tests, unfiltered (`just test quick xtask`, about 25 seconds
# of tests warm), since a codegen input lists itself in them. PRs 3891, 3898
# and 3907 each reached their gate red on a drift step on 2026-11-26 (retro
# of #607), and 3975 on codegen's emit tests after a filtered run. Warm, the
# installs and the steps take about two minutes; on a cold target, `compat
# check` alone builds every writer, about 25 minutes beside a gate. When
# that head's change reaches the Rust under `crates/` that is not a test,
# or the copy check's script or list (`copies_paths` below), the push also
# runs the copy check (`ci/copies.sh`, about 3 seconds, `just lint`'s step),
# which reads the checkout too: 3975 reached its gate red on it the same
# day. A change that reaches none of those paths pays two `git diff`s.
set -euo pipefail
# git gives this hook the push's GIT_DIR (a linked worktree's), and a build
# script's `git init` under `just quick` (btls-sys's) would then reinitialize
# the repository as bare: every `just` here finds the repository from its
# folder.
for variable in $(git rev-parse --local-env-vars); do unset "$variable"; done
# shellcheck source=ci/change-base.sh
source "$(dirname "${BASH_SOURCE[0]}")/../ci/change-base.sh"
head=$(git rev-parse HEAD)
own=${GOODFETCH_QUICK_BASE:-$(branch_base)}
base=""
due=0
pushed=""
specs=""
# Each held head and the base it was held against, a pair a line.
held=""
# Whether the hosted tier serves the remote ref `$1`, as GitHub says it.
served() {
  local branch=${1#refs/heads/} open state
  [[ $branch =~ ^(batch/.+|spec/[0-9]+)$ ]] || return 1
  open=$(gh pr list --head "$branch" --base main --state open --json number --jq length </dev/null 2>/dev/null) || return 1
  [[ $open =~ ^[1-9][0-9]*$ ]] || return 1
  state=$(gh api 'repos/{owner}/{repo}/actions/workflows/pull-request.yml' --jq .state </dev/null 2>/dev/null) || return 1
  [[ $state == active ]]
}
while read -r _local_ref local_oid remote_ref remote_oid; do
  # A deletion pushes no tree.
  [[ $local_oid =~ ^0+$ ]] && continue
  pushed="$pushed $local_oid"
  if [[ $remote_ref == refs/heads/spec/* ]]; then
    specs="$specs $local_oid"
    echo "pre-push: a push to ${remote_ref#refs/heads/} runs no \`just quick\`: its batch's \`just batch-check\` runs it on the combined tree."
    continue
  elif served "$remote_ref"; then
    echo "pre-push: ${remote_ref#refs/heads/} has an open pull request to main that the hosted tier serves, so its hosted run runs the Quick suite and the hook judges the commits alone."
    continue
  fi
  ref_base=""
  if [[ $local_oid == "$head" && ! $remote_oid =~ ^0+$ ]] && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    ref_base=$remote_oid
    if ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
      echo "pre-push: the commit the remote ref holds, $remote_oid, is no ancestor of the pushed head (a rebase or another rewrite), so \`just quick\` reads the change against the branch's own base, $own."
      ref_base=""
    elif fork=$(git merge-base "$local_oid" "$own" 2>/dev/null) && ! git merge-base --is-ancestor "$fork" "$remote_oid"; then
      echo "pre-push: the push brings commits of $own (a merge of it) after the commit the remote ref holds, $remote_oid, so \`just quick\` reads the change against the branch's own base, $own."
      ref_base=""
    fi
  fi
  # The ref list is this loop's input, which no command under it reads.
  if just _quick-held "$local_oid" "${ref_base:-$own}" changed < /dev/null; then
    held="$held$local_oid ${ref_base:-$own}"$'\n'
    continue
  fi
  due=1
  if [[ $local_oid == "$head" ]]; then
    base=$ref_base
  fi
done
# Every check runs on every head it judges even after one failed, so one
# push names every commit to rewrite. The empty base is the recipes' own.
commits=0
for oid in $pushed; do
  just dco "" "$oid" || commits=1
  just commit-messages "" "$oid" || commits=1
done
while read -r oid held_base; do
  [[ -n $oid ]] || continue
  just floor-guard "$held_base" "$oid" < /dev/null || commits=1
  just commit-leaks "$held_base" "$oid" < /dev/null || commits=1
done <<< "$held"
# The static steps of a push to `spec/<n>`, all of them even after one
# failed, as the commit checks.
static=0
modules=0
# What the drift steps read, by the paths their `xtask` code names: the SDKs
# and the Rust Products' crates they mirror, the protocol crate, the
# Compatibility corpus and its writers' launchers, the client conformance
# cases, the journeys, settings, every generated folder and the sources
# codegen reads outside them, and each step's own code. A format's writer
# under a crate's `src/` is left to the merge gate: matching every source
# file would run the steps on nearly every change.
drift_paths=(sdks/ tsconfig.base.json crates/goodfetch-protocol/ compat/ conformance/clients/
  journeys/ ':(glob)**/generated/**' ':(glob)**/settings.rs' ':(glob)**/settings/**'
  ':(glob)crates/**/examples/compat-*' crates/goodfetch-collie/ crates/goodfetch-collie-client/
  crates/foxhound/goodfetch-foxhound/ crates/foxhound/goodfetch-fetch-tier/src/light_browser/pins.json
  crates/goodfetch-cdp/protocol.json crates/goodfetch-cdp/src/generated.rs
  crates/goodfetch-engine/iana/ crates/goodfetch-engine/src/rpc.rs
  crates/goodfetch-engine/src/runs/outcome.rs crates/goodfetch-counted-work/src/lib.rs
  crates/goodfetch-test-support/src/browsers.rs crates/goodfetch-test-support/src/exercise.rs
  ci/deny/collie.toml test-support/fixtures/canaries/gitleaks.toml test-support/fixtures/schemas/
  xtask/src/codegen.rs xtask/src/codegen/ xtask/src/clients.rs xtask/src/sdk_manifests.rs
  xtask/src/sdk_manifests/ xtask/src/compat.rs xtask/src/compat/ xtask/src/api_check.rs
  xtask/src/api_check/ xtask/src/sdk_api.rs xtask/src/containment.rs)
# What the copy check (ci/copies.sh) reads: the Rust under crates/ but its
# tests, which the script leaves out, and the script and its list. It reads
# the whole tree, but a change that reaches none of these cannot turn it red.
copies_paths=(':(glob)crates/**/*.rs' ':(exclude,glob)crates/**/tests/**'
  ':(exclude,glob)crates/**/tests.rs' ':(exclude,glob)crates/**/benches/**'
  ':(exclude,glob)crates/**/fixtures/**' ci/copies.sh ci/copies.json)
drift=0
copies=0
for oid in $specs; do
  just floor-guard origin/main "$oid" </dev/null || static=1
  reaches_drift=0
  reaches_copies=0
  git diff --quiet origin/main..."$oid" -- "${drift_paths[@]}" || reaches_drift=1
  git diff --quiet origin/main..."$oid" -- "${copies_paths[@]}" || reaches_copies=1
  if [[ $oid == "$head" ]]; then
    modules=1
    drift=$((drift | reaches_drift))
    copies=$((copies | reaches_copies))
  elif ((reaches_drift || reaches_copies)); then
    echo "pre-push: $oid reaches what the drift steps, xtask's tests or the copy check read, but they read the checkout, whose head it is not: run them in its own worktree (\`just lint-drift\`, \`cargo run --bin xtask -- containment\`, \`just test quick xtask\` and \`ci/copies.sh\`)."
  fi
done
# pnpm's locked install, run once for the steps that need it: a new worktree
# has no `node_modules`, through which the SDK steps read the TypeScript
# packages and the copy check runs jscpd.
node_installed=""
node_install() {
  if [[ -z $node_installed ]]; then
    node_installed=0
    pnpm install --frozen-lockfile --reporter=silent </dev/null && node_installed=1
  fi
  ((node_installed))
}
if ((copies)); then
  echo "pre-push: the change reaches the Rust that \`ci/copies.sh\` reads, so it runs (PR 3975 reached its gate red on an 18-line copy, 2026-11-26)."
  if ! node_install; then
    echo "pre-push: pnpm's locked install failed (above), so the copy check did not run."
    static=1
  else
    ci/copies.sh </dev/null || static=1
  fi
fi
if ((modules)); then
  cargo run --quiet --bin xtask -- modules </dev/null || static=1
fi
if ((drift)); then
  echo "pre-push: the change reaches what the drift steps read (\`drift_paths\` in this hook), so they run."
  # The steps' commands come from the recipes that own them, as their step
  # list prints them (ci/keep-going.sh): every `xtask` step of `just
  # lint-drift` but the module check, which ran above, and `just lint`'s
  # containment check.
  drift_steps=()
  while IFS= read -r line; do
    [[ $line =~ ^(cargo\ run\ --quiet\ --bin\ xtask\ --\ .+)\ \ \#\ (xtask-[a-z-]+),\ after\ xtask$ ]] || continue
    case ${BASH_REMATCH[2]} in
      xtask-modules) ;;
      *) drift_steps+=("${BASH_REMATCH[1]}") ;;
    esac
  done < <(GOODFETCH_STEPS_LIST=1 just lint-drift </dev/null
    GOODFETCH_STEPS_LIST=1 just lint </dev/null | grep -F '# xtask-containment,')
  # The SDK steps read the TypeScript packages through `node_modules` and the
  # Python one through `.venv`, which a new worktree has neither of: the
  # locked installs first, as `just batch-check` does. xtask builds once, as
  # `lint-drift`'s steps wait on its build.
  if ((${#drift_steps[@]} < 2)); then
    echo "pre-push: the step lists of \`just lint-drift\` and \`just lint\` gave ${#drift_steps[@]} drift steps, so none ran."
    static=1
  elif ! node_install || ! uv sync --frozen --all-extras --quiet </dev/null; then
    echo "pre-push: the locked installs failed (above), so the drift steps did not run."
    static=1
  elif ! cargo build --quiet --bin xtask </dev/null; then
    echo "pre-push: xtask does not build (above), so the drift steps did not run."
    static=1
  else
    for step in "${drift_steps[@]}"; do
      echo "pre-push: $step"
      bash -c "$step" </dev/null || static=1
    done
  fi
  # A codegen input lists itself in xtask's own tests too, the bundle's list
  # of Formats among them: PR 3975 added a Format, ran xtask's tests filtered
  # to the compat ones, and reached its gate red on codegen's emit tests
  # (2026-11-26). So all of xtask's Quick tests run, unfiltered, whatever
  # the steps above gave.
  echo "pre-push: just test quick xtask"
  just test quick xtask </dev/null || static=1
fi
if ((commits)); then
  echo "error: pre-push refuses this push: a commit it adds is not signed off, its subject is no Conventional Commit, or, on a tree a green \`just quick\` holds, the floor guard or the scan for secrets is red (above, CONTRIBUTING.md, TESTING.md's Quality register). Rewrite it and push again; \`just quick\` did not run." >&2
fi
if ((static)); then
  echo "error: pre-push refuses this push: the floor guard, the module check, the copy check, a drift step or xtask's tests failed on what it pushes to a \`spec/\` branch (above). Fix it and push again." >&2
fi
if ((commits || static)); then
  exit 1
fi
((due)) || exit 0
# The pusher's own base, when the hook keeps none: `just quick` then reads
# the branch's own, as the held check did.
GOODFETCH_GATE_LAYER=pre-push GOODFETCH_QUICK_BASE=${base:-${GOODFETCH_QUICK_BASE:-}} exec just quick
