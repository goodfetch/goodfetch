#!/usr/bin/env bash
# Opt in with `just hooks`: runs the pre-push tier, `just quick`, before a push;
# it picks the docs gate's checks for a change of documents alone (TESTING.md).
# It runs no check twice on one tree (TESTING.md, Checks by role): a push whose
# trees a green `just quick` already recorded (ci/quick.sh, in the repository's
# common folder) runs nothing. Otherwise `just quick` reads the change against
# the commit the remote ref holds, so it checks what the push adds.
set -euo pipefail
stamps="$(git rev-parse --path-format=absolute --git-common-dir)/goodfetch-quick-green"
head=$(git rev-parse HEAD)
base=""
due=0
while read -r _local_ref local_oid _remote_ref remote_oid; do
  # A deletion pushes no tree.
  [[ $local_oid =~ ^0+$ ]] && continue
  tree=$(git rev-parse "$local_oid^{tree}")
  if grep -qxF "$tree" "$stamps" 2>/dev/null; then
    echo "pre-push: \`just quick\` already passed on tree $tree, so it does not run again."
    continue
  fi
  due=1
  if [[ $local_oid == "$head" && ! $remote_oid =~ ^0+$ ]] && git cat-file -e "$remote_oid^{commit}" 2>/dev/null; then
    base=$remote_oid
  fi
done
((due)) || exit 0
GOODFETCH_QUICK_BASE=$base exec just quick
