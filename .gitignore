.DS_Store
node_modules/
# Cargo's builds, and every runner's JUnit XML and test output under target/:
# the root's (without a slash, so a link to a build folder elsewhere counts)
# and any other, such as a workspace's outside the root one or one a tool
# makes in a package's folder. A source folder named `target` stays tracked
# (#1761); ci/ignored-sources.sh checks both.
/target
target/
!**/src/**/target/
# Output of a failing insta assertion, which `cargo insta review` reads
*.snap.new
*.pending-snap
# A local `cargo fuzz run`'s corpus, crashes and coverage (the seeds are
# tracked in each fuzz crate's folders named after their targets)
/crates/**/fuzz/artifacts/
/crates/**/fuzz/corpus/
/crates/**/fuzz/coverage/
# The folders test support's own tests copy a runner's configuration into
# (test-support/typescript/tests/runner-project.ts)
.runner-projects/
# mutmut's copy of a Python SDK package, mutated in place of its sources
# (`just mutants-sdks python`)
/sdks/python/*/mutants/
# StrykerJS's Vitest setup files, left by a run that stops (`just mutants-sdks`)
/stryker-setup-*.js
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local secrets (ADR 0076): only .env.example is committed
.env
.env.*
!.env.example
