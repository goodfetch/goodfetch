{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "rnd/**",
    "**/generated/**",
    "**/features/inventory.json",
    "**/features/*.schema.json",
    "**/fixtures/schemas/**",
    "proving-ground/fixtures/archive/**",
    "**/journeys/journey.schema.json",
    "**/compat/**",
    ".agents/**",
    "ci/proofs/**",
    "**/*.md",
    "**/*.toml",
    "pnpm-lock.yaml"
  ]
}
