{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-deprecated": "error",
    "vitest/no-restricted-vi-methods": [
      "error",
      {
        "mock": "Mocks owned code (ADR 0062); test through the interface with a local stand-in.",
        "doMock": "Mocks owned code (ADR 0062); test through the interface with a local stand-in.",
        "importMock": "Mocks owned code (ADR 0062); test through the interface with a local stand-in.",
        "mockObject": "Mocks owned code (ADR 0062); test through the interface with a local stand-in.",
        "spyOn": "Mocks owned code (ADR 0062); test through the interface with a local stand-in.",
        "stubGlobal": "Patches a global (ADR 0062); pass the value through an option instead.",
        "stubEnv": "Patches the environment (ADR 0062); pass the environment map through an option instead."
      }
    ],
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["test", "test.fails", "test.for", "test.concurrent"]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.spec.ts",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx"
      ],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "property": "newContext",
            "message": "Makes a context of its own, or an API request context (ADR 0068); take the context or request fixture of @goodfetch/test-support/playwright."
          },
          {
            "object": "browser",
            "property": "newPage",
            "message": "Makes a context of its own (ADR 0068); take the page fixture, or call context.newPage()."
          },
          {
            "property": "launchPersistentContext",
            "message": "Makes a browser and context of its own (ADR 0068); take the fixtures of @goodfetch/test-support/playwright."
          },
          {
            "property": "launch",
            "message": "Starts a browser of its own (ADR 0068); take the fixtures of @goodfetch/test-support/playwright."
          },
          {
            "property": "connect",
            "message": "Connects to a browser of its own (ADR 0068); take the fixtures of @goodfetch/test-support/playwright. A Node socket uses net.createConnection."
          },
          {
            "property": "connectOverCDP",
            "message": "Connects to a browser of its own (ADR 0068); take the fixtures of @goodfetch/test-support/playwright."
          },
          {
            "property": "waitForTimeout",
            "message": "Sleeps (ADR 0068); wait with a web-first assertion or expect.poll."
          },
          {
            "object": "Object",
            "property": "defineProperty",
            "message": "Redefines a property (ADR 0068); set browser state through Playwright, or pass the value as an option."
          },
          {
            "object": "Object",
            "property": "defineProperties",
            "message": "Redefines a property (ADR 0068); set browser state through Playwright, or pass the value as an option."
          },
          {
            "object": "Reflect",
            "property": "defineProperty",
            "message": "Redefines a property (ADR 0068); set browser state through Playwright, or pass the value as an option."
          },
          {
            "property": "addCookies",
            "message": "Writes a cookie the Console did not set (ADR 0068); sign in through the signIn fixture of @goodfetch/test-support/playwright."
          },
          {
            "property": "setStorageState",
            "message": "Writes cookies and storage the Console did not set (ADR 0068); sign in through the signIn fixture of @goodfetch/test-support/playwright."
          },
          {
            "object": "document",
            "property": "cookie",
            "message": "Touches a cookie in the page (ADR 0068); sign in through the signIn fixture of @goodfetch/test-support/playwright."
          }
        ]
      }
    },
    {
      "files": ["console/**"],
      "plugins": ["jsx-a11y"],
      "jsPlugins": ["eslint-plugin-lingui"],
      "rules": {
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/anchor-ambiguous-text": "error",
        "jsx-a11y/anchor-has-content": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/aria-activedescendant-has-tabindex": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-proptypes": "error",
        "jsx-a11y/aria-role": "error",
        "jsx-a11y/aria-unsupported-elements": "error",
        "jsx-a11y/autocomplete-valid": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        "jsx-a11y/control-has-associated-label": "error",
        "jsx-a11y/heading-has-content": "error",
        "jsx-a11y/html-has-lang": "error",
        "jsx-a11y/iframe-has-title": "error",
        "jsx-a11y/img-redundant-alt": "error",
        "jsx-a11y/interactive-supports-focus": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/lang": "error",
        "jsx-a11y/media-has-caption": "error",
        "jsx-a11y/mouse-events-have-key-events": "error",
        "jsx-a11y/no-access-key": "error",
        "jsx-a11y/no-aria-hidden-on-focusable": "error",
        "jsx-a11y/no-autofocus": "error",
        "jsx-a11y/no-distracting-elements": "error",
        "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
        "jsx-a11y/no-noninteractive-element-interactions": "error",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": ["error", { "table": ["grid"] }],
        "jsx-a11y/no-noninteractive-tabindex": [
          "error",
          { "tags": ["section"], "roles": ["tabpanel"] }
        ],
        "jsx-a11y/no-redundant-roles": "error",
        "jsx-a11y/no-static-element-interactions": "error",
        "jsx-a11y/prefer-tag-over-role": "error",
        "jsx-a11y/role-has-required-aria-props": "error",
        "jsx-a11y/role-supports-aria-props": "error",
        "jsx-a11y/scope": "error",
        "jsx-a11y/tabindex-no-positive": "error",
        "import/no-relative-parent-imports": "error",
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@goodfetch/console-foxhound", "@goodfetch/console-foxhound*"],
                "message": "Collie's Console never imports Foxhound's screens (ADR 0087); Foxhound's build composes Collie's screens with its own."
              }
            ]
          }
        ],
        "lingui/no-unlocalized-strings": [
          "error",
          {
            "ignore": ["^(?![A-Z])\\S+$", "^[A-Z0-9_-]+$"],
            "ignoreNames": [
              { "regex": { "pattern": "className", "flags": "i" } },
              "id",
              "src",
              "type",
              "displayName"
            ],
            "ignoreFunctions": [
              "cva",
              "cn",
              "Error",
              "console.*",
              "*.getElementById",
              "*.addEventListener",
              "*.removeEventListener"
            ]
          }
        ]
      }
    },
    {
      "files": ["console/foxhound/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["console/*/*.config.ts"],
      "jsPlugins": ["eslint-plugin-lingui"],
      "rules": {
        "lingui/no-unlocalized-strings": "off"
      }
    },
    {
      "files": [
        "console/**/*.test.{ts,tsx}",
        "console/*.spec.ts",
        "console/**/*.stories.tsx",
        "console/tests/**",
        "console/*/tests/**",
        "console/*/perf/**"
      ],
      "jsPlugins": ["eslint-plugin-lingui"],
      "rules": {
        "lingui/no-unlocalized-strings": "off"
      }
    }
  ],
  "ignorePatterns": [
    "rnd/**",
    "**/generated/**",
    "ci/proofs/**",
    "crates/goodfetch-clean-up-rules/stand-ins/**",
    "crates/goodfetch-clean-up-rules/consent/autoconsent/**"
  ]
}
