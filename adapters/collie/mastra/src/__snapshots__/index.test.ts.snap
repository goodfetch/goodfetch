      "hasObjectSchema": true,
      "id": "daemon_health",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Says what the Daemon runs as, where it listens, how many Clients and live Runs it has, when it stops idle, and its live heap.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "daemon_status",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Stops the Daemon once it answered: its live Runs stop, each resumable from its own state, and its runtime file and socket are removed.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "daemon_stop",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Says which Product the engine runs as, its Product version and major, and the protocol version it speaks.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "engine_info",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Removes a key from a live Run's Key-value store and answers whether it existed. Through a crawl attempt (\`attempt\`), the removal is staged with the attempt, and whether the key existed counts what the attempt staged.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "key_value_store_delete",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Answers the JSON value a Run's Key-value store holds for a key, as committed, or null when the key is absent. A key holding bytes fails with \`value_invalid\`, naming \`getBytes\`. Takes no writer lock, so it reads a Run no program holds without resuming it. Through a crawl attempt (\`attempt\`), it reads what the attempt staged first.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "key_value_store_get",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Answers the bytes and content type a Run's Key-value store holds for a key, as committed, or null when the key is absent. A key holding JSON fails with \`value_invalid\`, naming \`get\`. Takes no writer lock. Through a crawl attempt (\`attempt\`), it reads what the attempt staged first.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "key_value_store_get_bytes",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Commits a JSON value for a key in a live Run's Key-value store, replacing the one it held: the last commit wins. A null value fails with \`value_invalid\`; remove a key with \`delete\`. Through a crawl attempt (\`attempt\`), the write is staged with the attempt and commits or is discarded with it; once the attempt ended, it fails with \`attempt_ended\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "key_value_store_set",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Commits bytes with their content type for a key in a live Run's Key-value store, replacing what it held: the last commit wins. Bytes over 1 MiB are kept as a file in the Run's folder, which its Checkpoints carry.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "key_value_store_set_bytes",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Clicks the element the locator matches once it is unique, visible, enabled, stable and receiving the click (the guard, ADR 0019); a click that lands on another element is cancelled and sent again, until \`timeout.action\` passes. A click that starts a navigation of the page answers once that navigation's document committed or it ended without one, within \`timeout.navigation\` (ADR 0085).",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "locator_click",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Replaces the text of the field the locator matches, once it is unique, visible, enabled and editable, with text the page receives as typed input, until \`timeout.action\` passes. An input whose value a person picks rather than types (a date, a time, a month, a week, a local date and time, a colour or a range) has its value set, firing \`input\` and \`change\`, and a value it does not take fails with \`invalid_params\`.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "locator_fill",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Focuses the element the locator matches, once it is unique, visible and enabled, and presses a key or a combination on it as a keyboard does, until \`timeout.action\` passes. A press that starts a navigation of the page answers once that navigation's document committed or it ended without one, within \`timeout.navigation\` (ADR 0085).",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "locator_press",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Hides an item of "Needs you" whose source lets a person dismiss it, for every Client, and answers whether it did; an item the list no longer holds, or one only resolving it removes, stays as it is. The item leaves the list with \`needs_you.changed\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "needs_you_dismiss",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Lists what waits for a person across every Run in the Run index and the stores beside it, the longest waiting first, a page at a time: \`after\` takes the \`next\` of the page before. \`kinds\` keeps the items of those kinds. Each change after the answer arrives as \`needs_you.changed\` on the event stream.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "needs_you_list",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Closes the page, a popup as any other: its calls in flight raise \`call_cancelled\` naming the program, it emits \`close\`, and a later call on it raises \`closed\`, while closing it again changes nothing. Its \`beforeunload\` handlers do not run unless \`run_before_unload\` is set: the page then closes once they let it, a dialog they raise going to its dialog handlers, and the call answers without waiting for that.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "page_close",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Reads the formats a request names from the page's current document, each read from one serialization of it, and answers only those, with the document's URL, its base URL and, when a format it names is read from the main content (\`markdown\` of the main content or fit, \`html\` of the main content, \`text\`), whether the document has main content. A document with no main content answers those formats empty and \`main_content: "none"\`, a value. It needs neither layout nor pixels, so every tier serves it.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "page_formats",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Goes back one entry in the page's history and waits for its \`load\` event, answering the document's response. It answers none only when no document loads: for a same-document entry, or when there is no entry to go back to. The back/forward cache is off, so a document always loads again (ADR 0121).",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "page_go_back",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Goes forward one entry in the page's history and waits for its \`load\` event, answering the document's response. It answers none only when no document loads: for a same-document entry, or when there is no entry to go forward to. The back/forward cache is off, so a document always loads again (ADR 0121).",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "page_go_forward",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Navigates the page to a URL and waits for its document's \`load\` event, or the state \`wait_until\` names, answering the document's response: a 404 or a 500 is a response, a value. A file the browser downloads, such as a PDF, answers no response and emits \`page.download\`. A navigation that reaches no document raises \`navigation_failed\`, one another navigation supersedes before it committed \`navigation_interrupted\`, a redirect loop \`too_many_redirects\`, a document whose body broke off \`response_truncated\`, unless the navigation answered at \`commit\`, and one past its \`timeout\`, or \`timeout.navigation\` without one, \`deadline_exceeded\`.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "page_goto",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Reads the named fields from the page's current document in one call and answers each one's value: a value field's from the first element its CSS or XPath locator finds, its text or one attribute, optionally a \`match\` group, then its Value transform; a list's from every element its locator finds; rows' from each element a base locator finds, each row one object of its fields read under that element. A value the page does not give is null, and \`unread\` names it with why: a row lacking a field keeps its other fields. It never waits: an absent element is an answer. It needs neither layout nor pixels, so every tier serves it, and in the browser it is one read of the page whatever the number of fields.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "page_read",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Loads the page's document again and waits for its \`load\` event, answering the document's response: a 404 or a 500 is a response, a value. A navigation that reaches no document raises \`navigation_failed\`, and one another navigation supersedes before it committed \`navigation_interrupted\`.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "page_reload",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Starts a Recipe's run, a Run with no handler in the program, and answers once it is started. Its Run ID works as \`run.start\`'s. With \`detached\`, the Run outlives the program that started it: closing its value frees only the value, \`run.finish\` waits for its end and \`run.stop\` stops it.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "recipe_start",
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Reads the body of the response a page's request got, once the request finished, as a page body's handle: kept already for a response \`page.wait_for_request_finished\` answered, and otherwise read from the browser, on the session of the frame that loaded it. A body the browser no longer holds, or a redirect's, which has none, raises \`body_unavailable\`, whose fix names \`page.wait_for_request_finished\`; one that broke off raises \`response_truncated\`, never returned as whole. Past its \`timeout\`, \`timeout.wait\` when the call gives none, a request that has not ended fails it with \`deadline_exceeded\`; a page that ends under it raises what ended it, as a call on the page does.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "response_body",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Stops a Run at its next safe point, \`stopped\` and \`incomplete\`: no attempt in flight commits, and its work items return to pending. Answers its Run report; an ended Run's report is answered as it is. A Run whose engine died is stopped by this engine, which takes its writer role at the next run epoch; a Run another engine writes is stopped by that engine, the owner the Run index names.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_abort",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Writes a Checkpoint of a live Run now, through SQLite's online backup, where the engine keeps the Run's Checkpoints, or where \`location\` says, a path on the engine's machine that only the catalog's caller gives, an SDK's \`checkpoint()\` taking none, and answers it once its file is complete, with its size, digest, run epoch and journal position. A Checkpoint the engine cannot write fails with \`file_write_failed\` and leaves no file.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "run_checkpoint",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Lets a Run finish and answers its Run report: a Run its program drives ends at once, \`finished\` and \`complete\`; a crawl ends once its work items are done, and a keep-alive crawl (\`crawl.keep_alive\`), which waits for new work while nothing is left, ends once this call lets it and its work items are done. A Run something stopped first answers its report saying \`stopped\`. A Run that ended \`failed\` fails the call with the error that failed it, and a write at its end that failed, such as its Plan file's, with that write's error. Cancelling the call, or its \`timeout\` passing, which fails it with \`deadline_exceeded\`, ends only the wait.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_finish",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Lists the Runs of the Run index of the user and major, of either Product (ADRs 0031 and 0098): each row with its tags, Lifecycle, Verdict, Completeness, start and end, the engine that owns it while it is live, and its presence, a Run whose state is gone \`missing\` and one discarded on purpose \`erased\`, never left out. The engine filters by tags, the Recipe, Schedule, occurrence and trigger its reserved \`goodfetch.\` tags name, Product, each axis, start and end time, and a text found in its Run ID or tags, and sorts by the key given; Watch runs are left out unless \`watch_runs\` asks for them (ADR 0036).",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_list",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Migrates a live Run: checkpoints it where \`location\` says or where the engine keeps its Checkpoints, then stops it at its next safe point, \`stopped\` with the stop reason \`migrate\`, to be resumed from that Checkpoint on another machine. Answers its Run report, which names the Checkpoint.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_migrate",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Opens a page in the Run's default Session, which the first call opens with the Run's settings and every later call shares; \`page.session()\` reaches it. The first page launches the Run's browser, so a missing browser build raises its code from this call.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "run_new_page",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Opens a Session of the Run's own: its own browser context, with its own cookies, storage, identity and proxy, sharing the Run's browser process, so two Sessions of a Run never share a login. It opens from \`source\`, or else from the Run's \`session.source\`, or fresh; \`session.source\` in its own \`settings\` is refused with \`setting_not_applicable\`. The Run's first Session launches its browser, so a missing browser build raises its code from this call.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "run_new_session",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Pauses a live Run: checkpoints it, then stops it at its next safe point, \`stopped\` with the stop reason \`pause\` and resumable by its Run ID with \`run.resume\`, after a restart too. Answers its Run report, which names the Checkpoint.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_pause",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Reads a Run's progress: what it does and why it waits. Without \`after\`, it answers at once; given \`after\`, the position of the value the reader last read, it waits for a change and answers the latest value, so values in between are coalesced. The value whose \`last\` is true ends the sequence: the Run ended, and its \`lifecycle\` and \`stop_reason\` say how, or no engine works it (\`writer: none\`) until a start with its Run ID resumes it. A Run another engine works is read through that engine, the owner the Run index names, and one no engine works from its committed state; a read never takes the Run's writer lock. A Run ID the Run index does not list fails with \`run_not_found\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_progress",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Reads a Run's report: at once for a Run that ended, and at its end for a live one, which the read never ends. A Run another engine works is read through that engine, and one no engine works from its committed state, never taking its writer lock. A Run that has no live writer and has not ended fails with \`run_interrupted\`, whose \`fix\` names a start with its Run ID, and a Run ID the Run index does not list with \`run_not_found\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_report",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Resumes an interrupted Run from its committed state, its run file on this machine or the Checkpoint \`checkpoint\` names: it takes the Run's writer lock and the next run epoch, so every write of an earlier writer is refused, and redoes the work since that state; its recorded Clean-up rules digest is kept. A Run this engine runs already fails with \`run_in_use\`, as one another engine writes does; a finished one is answered as it ended, \`ended\`. A Run bound to another machine fails with \`session_bound_to_machine\`, a Checkpoint of a format version this engine cannot read with \`format_version_unsupported\`, and a Checkpoint behind the Run's run file on this machine with \`checkpoint_behind\`, or with the error that file's read gives when it cannot be read, unless \`rollback\` replaces that file, as the Audit log records.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_resume",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Starts a Run its program drives, and answers once it is started. A Run ID names the Run for good, and a start under one acts on what the Run index holds (ADR 0102): no such Run begins it, \`new\`; an interrupted Run, stopped, failed, or running with no live writer, resumes from its committed state at the next run epoch, \`resumed\`, as \`run.resume\` does; a finished Run is answered as it ended with no handler called, \`ended\`. A Run live with a writer, in this engine or another, fails with \`run_in_use\`; a Run started with other inputs or by another caller with \`run_conflict\` listing each difference; a Run the Run index lists whose state is missing or unreadable with \`run_state_unavailable\`, never starting afresh.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_start",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Stops a Run at its next safe point with a Checkpoint, \`stopped\` and \`incomplete\` as an abort by its program, resumable by its Run ID, and answers its Run report; an ended Run's report is answered as it is. The wait is bounded by \`timeout.close\`, or the call's \`timeout\`: past it, the call fails with \`deadline_exceeded\` and the Run still stops at its next safe point. A Run that ended \`failed\` fails the call as \`run.finish\` does.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_stop",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Answers what a Run used, as the Usage ledger charged it: its model calls and tokens, browser time, proxy bytes, requests, paid solves and Paid fetches, each Limit that applies to it with what is left of it, and whether it is uncapped. An ended Run answers its report's Usage.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_usage",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Deprecated: removed in 1. Repeats a text back to the caller.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "sample_echo",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Records a Schedule in the Schedule store, which the Daemon keeps, and answers its ID, as given or made (\`s\` and a lowercase ULID), with warnings. Nothing fires yet. A taken ID fails with \`schedule_exists\`, a trigger that does not parse with \`schedule_trigger_invalid\`. Its time zone is the Daemon host's when the definition names none. One store transaction: a cancel stops it only before it commits.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "schedule_create",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Deletes the Schedule from its store, so it never fires again, and answers whether it did: false when the store held none of that ID, as after a resent delete. One store transaction: a cancel stops it only before it commits.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "schedule_delete",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Reads the Schedule of an ID. An ID the store does not hold fails with \`schedule_not_found\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "schedule_get",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Reads the Schedule as its store holds it now. One the store no longer holds fails with \`schedule_not_found\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "schedule_info",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Lists every Schedule of the Schedule store, by ID.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "schedule_list",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Describes a Schedule's trigger in plain words and lists its next Occurrences in a time zone strictly after \`after\` (now when absent; 5 by default, at most 100), including DST transitions. A trigger that does not parse fails with \`schedule_trigger_invalid\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "schedule_preview",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Closes the Session: its pages and its browser context close, and its pages' admissions go back to the Resource governor; a Borrowed browser is never closed. A later call on the Session or one of its pages raises \`closed\`, and closing it again changes nothing.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "session_close",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Opens a page in the Session, with its cookies and storage, and its own settings. Once the Session is closed, it raises \`closed\`.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "session_new_page",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
