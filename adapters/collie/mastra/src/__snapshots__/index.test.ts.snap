// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`@goodfetch/collie-mastra > snapshots the converted Mastra tools per profile and maps MCP annotations 1`] = `
{
  "agent": [
    {
      "description": "Clicks the element the locator matches once it is unique, visible, enabled, stable and receiving the click (the guard, ADR 0019); a click that lands on another element is cancelled and sent again, until \`timeout.action\` passes. A click that starts a navigation of the page answers once that navigation's document committed or it ended without one, within \`timeout.navigation\` (ADR 0085).",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "locator_click",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Replaces the text of the field the locator matches, once it is unique, visible, enabled and editable, with text the page receives as typed input, until \`timeout.action\` passes. An input whose value a person picks rather than types (a date, a time, a month, a week, a local date and time, a colour or a range) has its value set, firing \`input\` and \`change\`, and a value it does not take fails with \`invalid_params\`.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "locator_fill",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Focuses the element the locator matches, once it is unique, visible and enabled, and presses a key or a combination on it as a keyboard does, until \`timeout.action\` passes. A press that starts a navigation of the page answers once that navigation's document committed or it ended without one, within \`timeout.navigation\` (ADR 0085).",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "locator_press",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Closes the page, a popup as any other: its calls in flight raise \`call_cancelled\` naming the program, it emits \`close\`, and a later call on it raises \`closed\`, while closing it again changes nothing. Its \`beforeunload\` handlers do not run unless \`run_before_unload\` is set: the page then closes once they let it, a dialog they raise going to its dialog handlers, and the call answers without waiting for that.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "page_close",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Reads the formats a request names from the page's current document, each read from one serialization of it, and answers only those, with the document's URL, its base URL and, when a format it names is read from the main content (\`markdown\` of the main content or fit, \`html\` of the main content, \`text\`), whether the document has main content. A document with no main content answers those formats empty and \`main_content: "none"\`, a value. It needs neither layout nor pixels, so every tier serves it.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "page_formats",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Goes back one entry in the page's history and waits for its \`load\` event, answering the document's response. It answers none only when no document loads: for a same-document entry, or when there is no entry to go back to. The back/forward cache is off, so a document always loads again (ADR 0121).",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "page_go_back",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Goes forward one entry in the page's history and waits for its \`load\` event, answering the document's response. It answers none only when no document loads: for a same-document entry, or when there is no entry to go forward to. The back/forward cache is off, so a document always loads again (ADR 0121).",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "page_go_forward",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Navigates the page to a URL and waits for its document's \`load\` event, or the state \`wait_until\` names, answering the document's response: a 404 or a 500 is a response, a value. A file the browser downloads, such as a PDF, answers no response and emits \`page.download\`. A navigation that reaches no document raises \`navigation_failed\`, one another navigation supersedes before it committed \`navigation_interrupted\`, a redirect loop \`too_many_redirects\`, a document whose body broke off \`response_truncated\`, unless the navigation answered at \`commit\`, and one past its \`timeout\`, or \`timeout.navigation\` without one, \`deadline_exceeded\`.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "page_goto",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Reads the named fields from the page's current document in one call and answers each one's value: a value field's from the first element its CSS or XPath locator finds, its text or one attribute, optionally a \`match\` group, then its Value transform; a list's from every element its locator finds; rows' from each element a base locator finds, each row one object of its fields read under that element. A value the page does not give is null, and \`unread\` names it with why: a row lacking a field keeps its other fields. It never waits: an absent element is an answer. It needs neither layout nor pixels, so every tier serves it, and in the browser it is one read of the page whatever the number of fields.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "page_read",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Loads the page's document again and waits for its \`load\` event, answering the document's response: a 404 or a 500 is a response, a value. A navigation that reaches no document raises \`navigation_failed\`, and one another navigation supersedes before it committed \`navigation_interrupted\`.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "page_reload",
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false,
    },
    {
      "description": "Lets a Run finish and answers its Run report: a Run its program drives ends at once, \`finished\` and \`complete\`; a crawl ends once its work items are done, and a keep-alive crawl (\`crawl.keep_alive\`), which waits for new work while nothing is left, ends once this call lets it and its work items are done. A Run something stopped first answers its report saying \`stopped\`. A Run that ended \`failed\` fails the call with the error that failed it, and a write at its end that failed, such as its Plan file's, with that write's error. Cancelling the call, or its \`timeout\` passing, which fails it with \`deadline_exceeded\`, ends only the wait.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_finish",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Opens a Session of the Run's own: its own browser context, with its own cookies, storage, identity and proxy, sharing the Run's browser process, so two Sessions of a Run never share a login. It opens from \`source\`, or else from the Run's \`session.source\`, or fresh; \`session.source\` in its own \`settings\` is refused with \`setting_not_applicable\`. The Run's first Session launches its browser, so a missing browser build raises its code from this call.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "run_new_session",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Reads a Run's progress: what it does and why it waits. Without \`after\`, it answers at once; given \`after\`, the position of the value the reader last read, it waits for a change and answers the latest value, so values in between are coalesced. The value whose \`last\` is true ends the sequence: the Run ended, and its \`lifecycle\` and \`stop_reason\` say how, or no engine works it (\`writer: none\`) until a start with its Run ID resumes it. A Run another engine works is read through that engine, the owner the Run index names, and one no engine works from its committed state; a read never takes the Run's writer lock. A Run ID the Run index does not list fails with \`run_not_found\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_progress",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Reads a Run's report: at once for a Run that ended, and at its end for a live one, which the read never ends. A Run another engine works is read through that engine, and one no engine works from its committed state, never taking its writer lock. A Run that has no live writer and has not ended fails with \`run_interrupted\`, whose \`fix\` names a start with its Run ID, and a Run ID the Run index does not list with \`run_not_found\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_report",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    {
      "description": "Starts a Run its program drives, and answers once it is started. A Run ID names the Run for good, and a start under one acts on what the Run index holds (ADR 0102): no such Run begins it, \`new\`; an interrupted Run, stopped, failed, or running with no live writer, resumes from its committed state at the next run epoch, \`resumed\`, as \`run.resume\` does; a finished Run is answered as it ended with no handler called, \`ended\`. A Run live with a writer, in this engine or another, fails with \`run_in_use\`; a Run started with other inputs or by another caller with \`run_conflict\` listing each difference; a Run the Run index lists whose state is missing or unreadable with \`run_state_unavailable\`, never starting afresh.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_start",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Stops a Run at its next safe point with a Checkpoint, \`stopped\` and \`incomplete\` as an abort by its program, resumable by its Run ID, and answers its Run report; an ended Run's report is answered as it is. The wait is bounded by \`timeout.close\`, or the call's \`timeout\`: past it, the call fails with \`deadline_exceeded\` and the Run still stops at its next safe point. A Run that ended \`failed\` fails the call as \`run.finish\` does.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "run_stop",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Closes the Session: its pages and its browser context close, and its pages' admissions go back to the Resource governor; a Borrowed browser is never closed. A later call on the Session or one of its pages raises \`closed\`, and closing it again changes nothing.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "session_close",
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Opens a page in the Session, with its cookies and storage, and its own settings. Once the Session is closed, it raises \`closed\`.",
      "destructiveHint": true,
      "hasObjectSchema": true,
      "id": "session_new_page",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    {
      "description": "Lists the Session's open pages, in the order they opened: those the program opened and the popups its pages opened. Once the Session is closed, it raises \`closed\`.",
      "destructiveHint": false,
      "hasObjectSchema": true,
      "id": "session_pages",
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
  ],
