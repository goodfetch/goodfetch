{
  "id": "extraction",
  "host_class": { "requested": "local-controlled", "allow_downgrade": true },
  "order_seed": 18503,
  "blocks": 5,
  "warmup": 1,
  "iterations": 3,
  "concurrency": 1,
  "concurrency_levels": [1, 8, 64, 256],
  "timeout_ms": 30000,
  "max_duration_ms": 180000,
  "max_restarts": 2,
  "tasks": ["catalog/2"],
  "registry": {
    "folder": "registry",
    "decisions": ["D-extraction-latency"]
  },
  "adapters": [
    {
      "id": "collie-default",
      "command": ["node", "../adapters/goodfetch/src/adapter.ts", "--product", "collie"]
    },
    {
      "id": "crawlee-js",
      "command": [
        "node",
        "../adapters/_shared/http-adapter.ts",
        "--config",
        "../adapters/crawlee-js/configuration.json"
      ],
      "configuration": "../adapters/crawlee-js/configuration.json"
    },
    {
      "id": "crawlee-py",
      "command": ["python3", "../adapters/crawlee-py/adapter.py"],
      "configuration": "../adapters/crawlee-py/configuration.json"
    },
    {
      "id": "scrapy",
      "command": ["python3", "../adapters/scrapy/adapter.py"],
      "configuration": "../adapters/scrapy/configuration.json"
    },
    {
      "id": "scrapling",
      "command": ["python3", "../adapters/scrapling/adapter.py"],
      "configuration": "../adapters/scrapling/configuration.json"
    },
    {
      "id": "firecrawl-self-hosted",
      "command": [
        "node",
        "../adapters/_shared/http-adapter.ts",
        "--config",
        "../adapters/firecrawl-self-hosted/configuration.json"
      ],
      "configuration": "../adapters/firecrawl-self-hosted/configuration.json"
    },
    {
      "id": "spider",
      "command": [
        "node",
        "../adapters/_shared/http-adapter.ts",
        "--config",
        "../adapters/spider/configuration.json"
      ],
      "configuration": "../adapters/spider/configuration.json"
    },
    {
      "id": "colly",
      "command": [
        "node",
        "../adapters/_shared/http-adapter.ts",
        "--config",
        "../adapters/colly/configuration.json"
      ],
      "configuration": "../adapters/colly/configuration.json"
    }
  ]
}
