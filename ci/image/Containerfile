# The pull-request tier's Linux x86-64 userland (ADR 0135): every toolchain
# and tool `just` calls, at pinned versions, on a base pinned by digest. It
# runs inside each job's Lima VM under Rosetta for Linux. The cache-warming
# job builds it on `main` and saves it to the cache folder; a pull-request VM
# loads it from there, and builds it only when the folder lacks this version.
#
# The layers run from the slowest to build and least often changed to the
# quickest: the Cargo tools compile from source (over an hour under
# emulation), so an edit lower down rebuilds from that edit on and reuses
# them. Each ARG sits right above the layer that reads it, since a changed
# ARG misses the cache of every RUN after its declaration.
FROM docker.io/library/rust:1.99.0-slim-trixie@sha256:458b145eb2406e832adc9c9536d487c5d264401a4ce63adbeced3fe91292616c

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

# What the later layers fetch and unpack with, and the make some Cargo
# tools' build scripts call.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl git make xz-utils \
 && rm -rf /var/lib/apt/lists/*

# The Cargo tools at pinned versions.
RUN cargo install --locked --root /usr/local \
      just@1.46.0 cargo-nextest@0.9.149 cargo-deny@0.20.2 cargo-insta@1.49.0 \
      cargo-shear@1.14.0 typos-cli@1.50.3 zizmor@1.30.1 \
      cargo-audit@0.22.0 cargo-hack@0.6.45 cargo-hakari@0.9.39 \
 && rm -rf "${CARGO_HOME}/registry" "${CARGO_HOME}/git"

# `xtask perf`'s tools (ADR 0071): Valgrind, and gungraun's runner at the
# version of the workspace's `gungraun` dependency, which it must match.
RUN apt-get update \
 && apt-get install -y --no-install-recommends valgrind \
 && rm -rf /var/lib/apt/lists/* \
 && cargo install --locked --root /usr/local gungraun-runner@0.20.0 \
 && rm -rf "${CARGO_HOME}/registry" "${CARGO_HOME}/git"

# rust-toolchain.toml's components, and the MSRV's toolchain (the
# workspace's `rust-version`, ADR 0030; raise both together).
RUN rustup component add rustfmt clippy \
 && rustup toolchain install 1.97 --profile minimal

# The nightly toolchain fuzzing, the AddressSanitizer run and Miri share
# (ci/miri.toml pins the same one), with the standard library's source the
# run and Miri's sysroot rebuild, Miri itself, and cargo-fuzz for `cargo fuzz
# check` (ADR 0067), at ci/sanitizer-toolchain.toml's versions
# (ci/tool-versions.sh checks they agree).
ARG SANITIZER_TOOLCHAIN=nightly-2026-10-05
ARG CARGO_FUZZ_VERSION=0.13.2
RUN rustup toolchain install "${SANITIZER_TOOLCHAIN}" --profile minimal --component rust-src --component miri \
 && cargo "+${SANITIZER_TOOLCHAIN}" install --locked --root /usr/local "cargo-fuzz@${CARGO_FUZZ_VERSION}" \
 && rm -rf "${CARGO_HOME}/registry" "${CARGO_HOME}/git"

# The linters' and scripts' system tools.
RUN apt-get update \
 && apt-get install -y --no-install-recommends jq shellcheck libxml2-utils \
 && rm -rf /var/lib/apt/lists/*

ARG NODE_VERSION=24.19.0
ARG NODE_SHA256=14b342e71204f811bde6153be8e04b62aef63c236fef92b55f9c83154b409647
ARG PNPM_VERSION=12.9.1
RUN curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
 && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
 && rm /tmp/node.tar.xz \
 && npm install --global "pnpm@${PNPM_VERSION}"

ARG UV_VERSION=0.9.28
ARG UV_SHA256=66ad1822dd9cf96694b95c24f25bc05cff417a65351464da01682a91796d1f2b
RUN curl -fsSLo /tmp/uv.tar.gz "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
 && echo "${UV_SHA256}  /tmp/uv.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/uv.tar.gz -C /usr/local/bin --strip-components=1 \
 && rm /tmp/uv.tar.gz

ARG ACTIONLINT_VERSION=1.7.12
ARG ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
RUN curl -fsSLo /tmp/actionlint.tar.gz "https://github.com/rhysd/actionlint/releases/download/v${ACTIONLINT_VERSION}/actionlint_${ACTIONLINT_VERSION}_linux_amd64.tar.gz" \
 && echo "${ACTIONLINT_SHA256}  /tmp/actionlint.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/actionlint.tar.gz -C /usr/local/bin actionlint \
 && rm /tmp/actionlint.tar.gz

# gitleaks, which `just lint` shows catching every Secret canary with the
# rule test support generates (ci/canary-rule.sh, ADR 0067).
ARG GITLEAKS_VERSION=8.30.1
ARG GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
RUN curl -fsSLo /tmp/gitleaks.tar.gz "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
 && echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
 && rm /tmp/gitleaks.tar.gz

# OSV-Scanner, which `just audit` checks the pnpm and uv lockfiles with
# against OSV's pinned databases, offline (ci/audit.sh, ADR 0064), at
# ci/host/osv-scanner.sh's version (ci/tool-versions.sh checks they agree).
ARG OSV_SCANNER_VERSION=2.7.0
ARG OSV_SCANNER_SHA256=160c6253e2922e9e0a6a9771c5c4c40a4b3c6090b34a3cdd5e80c96cc2e4218b
RUN curl -fsSLo /tmp/osv-scanner "https://github.com/google/osv-scanner/releases/download/v${OSV_SCANNER_VERSION}/osv-scanner_linux_amd64" \
 && echo "${OSV_SCANNER_SHA256}  /tmp/osv-scanner" | sha256sum -c - \
 && install -m 0755 /tmp/osv-scanner /usr/local/bin/osv-scanner \
 && rm /tmp/osv-scanner

# Test builds link with mold, as the hosted Linux jobs do through the
# host-tools action; local builds keep the default linker. Rust's own
# default on this target is rust-lld, which `-fuse-ld=mold` replaces.
ARG MOLD_VERSION=2.42.1
ARG MOLD_SHA256=6ff270c9bf07d2bec5c98aa324eb7c4daf6a1a4d815c05ff1708049616047855
RUN curl -fsSLo /tmp/mold.tar.gz "https://github.com/rui314/mold/releases/download/v${MOLD_VERSION}/mold-${MOLD_VERSION}-x86_64-linux.tar.gz" \
 && echo "${MOLD_SHA256}  /tmp/mold.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/mold.tar.gz -C /usr/local --strip-components=1 \
 && rm /tmp/mold.tar.gz
ENV CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS=-Clink-arg=-fuse-ld=mold

# The Secret Service the keychain tests meet (ci/os-services.sh starts it):
# a D-Bus session bus, gnome-keyring and libsecret's secret-tool; and
# iproute2's `tc`, which the Proving ground's netem tests shape `lo` with
# (the container gets CAP_NET_ADMIN from ci/vm/start.sh); and `lsof`, whose
# list of listening sockets shows that a launched browser opens no port.
RUN apt-get update \
 && apt-get install -y --no-install-recommends dbus-daemon gnome-keyring libsecret-tools iproute2 lsof \
 && rm -rf /var/lib/apt/lists/*

# libclang and Clang's own headers, which sqlite-plugin's build script loads
# through bindgen to build goodfetch-test-support's crash VFS (ADR 0060), so
# every crate that tests or benchmarks with goodfetch-test-support builds.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libclang-dev \
 && rm -rf /var/lib/apt/lists/*

# TLC's Java (ADR 0060): the pinned TLA+ tools need Java 11 or later.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-21-jre-headless \
 && rm -rf /var/lib/apt/lists/*

# The Pre-merge suite's browser (TESTING.md, Browsers): Playwright's Chromium
# and the system libraries it needs, at the pnpm catalog's Playwright version
# (ci/tool-versions.sh checks they agree), in a folder every user reads.
ARG PLAYWRIGHT_VERSION=1.64.1
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx --yes "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/* /root/.npm

# cargo-mutants, the in-diff mutation job's tool (ADR 0072; ci/mutants.sh).
# It has a layer of its own at the end, so adding it rebuilt no other layer;
# it joins the Cargo tools' layer above when that layer next changes.
RUN cargo install --locked --root /usr/local cargo-mutants@27.1.0 \
 && rm -rf "${CARGO_HOME}/registry" "${CARGO_HOME}/git"

# strace for `xtask counts --strace` (ADR 0140), which cross-checks the
# counted opens, folders and syncs from outside the process in the merge
# gate's perf step, at the base's Debian version. A layer of its own at the
# end, as cargo-mutants', so adding it rebuilt no other layer.
ARG STRACE_VERSION=6.13+ds-1
RUN apt-get update \
 && apt-get install -y --no-install-recommends "strace=${STRACE_VERSION}" \
 && rm -rf /var/lib/apt/lists/*

ENV CI=true
WORKDIR /work
