#!/usr/bin/env bash
# rustc's linker for the static musl build (ADR 0024's note of 2026-11-12):
# an executable links as a static-PIE with packed relative relocations
# (`DT_RELR`), so it loads at a randomised base. ci/musl/cargo names this
# script as the target's linker, and cargo-zigbuild, which keeps a linker
# already named, still sets `CC_<target>` to its wrapper of Zig's `cc`. Its
# name ends in `-cc` so that rustc, which reads a linker's kind from its
# name, passes it a C compiler's arguments.
#
# Zig's `cc` alone cannot make that link: it ignores rustc's `-static-pie`
# and links a non-PIE at a fixed base, and it refuses
# `-z pack-relative-relocs`. So the link runs twice. Zig's `cc` first links
# with `-pie`, which makes it pick musl's self-relocating `rcrt1.o` and its
# runtime archives built position-independent, and prints the command it
# ran its bundled LLD with (`ZIG_VERBOSE_LINK`). That command then runs
# again through `zig ld.lld` with `-z pack-relative-relocs` added, over the
# first link's output. rustc's static executable at a fixed base, which
# it links on aarch64-unknown-linux-musl, becomes a static-PIE first. Any
# other link goes to Zig's `cc` unchanged.
set -euo pipefail

target=${GOODFETCH_MUSL_LINK_TARGET:?ci/musl/cargo sets the target this links for}
variable=CC_${target//-/_}
cc=${!variable:?cargo-zigbuild sets $variable to its wrapper of Zig\'s cc}
zig=${CARGO_ZIGBUILD_ZIG_PATH:?ci/musl/cargo sets the path of Zig}

scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT

# An instrumented build (ADR 0057's note of 2026-11-14) asks the linker to
# keep the profile runtime with `-u __llvm_profile_runtime`: two arguments,
# which Zig's `cc` reads as an option it ignores and an input file it
# cannot open. Each such pair reaches it as `-Wl,-u,<symbol>`, among the
# arguments and in a copy of the response file rustc passes them in when
# they are too long for a command (one argument a line).
arguments=()
while [[ $# -gt 0 ]]; do
  if [[ "$1" == -u && $# -gt 1 ]]; then
    arguments+=("-Wl,-u,$2")
    shift 2
    continue
  fi
  if [[ "$1" == @* && -f "${1#@}" ]] && grep -qx -e '-u' -e '"-u"' "${1#@}"; then
    copy=$(mktemp "$scratch/arguments.XXXXXX")
    awk '
      pending != "" { quote = ($0 ~ /^".*"$/) ? "\"" : ""; symbol = $0; gsub(/^"|"$/, "", symbol); print quote "-Wl,-u," symbol quote; pending = ""; next }
      $0 == "-u" || $0 == "\"-u\"" { pending = $0; next }
      { print }
      END { if (pending != "") print pending }
    ' "${1#@}" >"$copy"
    arguments+=("@$copy")
  else
    arguments+=("$1")
  fi
  shift
done
set -- ${arguments[@]+"${arguments[@]}"}

# Whether rustc passes the option $1 among the arguments after it, or in the
# response file it passes them in when they are too long for a command.
passes() {
  local option=$1 argument
  shift
  for argument in "$@"; do
    if [[ "$argument" == "$option" ]]; then
      return 0
    elif [[ "$argument" == @* && -f "${argument#@}" ]] && grep -qx -e "$option" -e "\"$option\"" "${argument#@}"; then
      return 0
    fi
  done
  return 1
}

# rustc asks for a static-PIE only on a target whose specification offers
# one: x86_64-unknown-linux-musl's does, aarch64-unknown-linux-musl's does
# not, so there rustc links each executable at a fixed base, with `-static`,
# `-no-pie` and the start files for that, though it compiles the code
# position-independent all the same. Such a link becomes the one rustc asks
# for on x86_64: `-static-pie`, and the position-independent start files
# of the same self-contained folder, `rcrt1.o`, `crtbeginS.o` and
# `crtendS.o`. A response file is rewritten in a copy, one argument a line.
to_static_pie='/^"?-no-pie"?$/d
s/^("?)-static("?)$/\1-static-pie\2/
s#(/self-contained/)crt1\.o("?)$#\1rcrt1.o\2#
s#(/self-contained/)crtbegin\.o("?)$#\1crtbeginS.o\2#
s#(/self-contained/)crtend\.o("?)$#\1crtendS.o\2#'
if passes -static "$@" && passes -no-pie "$@"; then
  arguments=()
  for argument in "$@"; do
    if [[ "$argument" == @* && -f "${argument#@}" ]]; then
      copy=$(mktemp "$scratch/arguments.XXXXXX")
      sed -E "$to_static_pie" "${argument#@}" >"$copy"
      arguments+=("@$copy")
    else
      argument=$(sed -E "$to_static_pie" <<<"$argument")
      if [[ -n "$argument" ]]; then
        arguments+=("$argument")
      fi
    fi
  done
  set -- ${arguments[@]+"${arguments[@]}"}
fi

if ! passes -static-pie "$@"; then
  # Not `exec`: the scratch folder goes when the link ends.
  status=0
  "$cc" "$@" || status=$?
  exit "$status"
fi

log=$scratch/log
status=0
ZIG_VERBOSE_LINK=1 "$cc" "$@" -pie 2>"$log" || status=$?
# What Zig's `cc` wrote beside the commands it printed: its errors and
# warnings, which rustc shows.
grep -v -e '^ld\.lld ' -e '^ar rcs ' "$log" >&2 || true
[[ "$status" -eq 0 ]] || exit "$status"

# The executable's link is the last LLD command Zig ran; the ones before it
# build Zig's own runtime objects, on a first link.
command=$(grep '^ld\.lld ' "$log" | tail -n 1 || true)
if [[ " $command " != *" -pie "* || "$command" != *"/rcrt1.o "* ]]; then
  echo "error: Zig's cc did not link $target's executable as a static-PIE: its LLD command has no \`-pie\` or no \`rcrt1.o\`: ${command:-none printed}" >&2
  exit 1
fi
# Zig prints the arguments separated by spaces and unquoted, so a path
# holding a space splits here and LLD fails on a file it cannot open.
read -r -a arguments <<<"${command#ld.lld }"

# A profile-guided build's order file (ADR 0057's note of 2026-11-14),
# which ci/musl/cargo names: LLD lays the executable's sections out in the
# order of the symbols it lists. A constant's section with no named
# symbol, an anonymous constant's (`.rodata..L*`, `.data.rel.ro..L*`) or a
# function's jump table (`.rodata.<function>`), is listed by its section's
# name (`.rodata.*`, `.data.rel.ro.*`), and each Rust object holding such a
# section is linked from a copy in which the section has a symbol of that
# name: hidden, which the executable keeps local, since llvm-objcopy writes
# an added local symbol after the global ones, which LLD refuses.
extra=()
order=${GOODFETCH_MUSL_ORDER_FILE:-}
if [[ -n "$order" ]]; then
  remaining=$scratch/anonymous
  grep -E '^\.(rodata|data\.rel\.ro)\.' "$order" >"$remaining" || true
  if [[ -s "$remaining" ]]; then
    tools=${GOODFETCH_MUSL_LLVM_TOOLS:?ci/musl/cargo sets the folder of the toolchain\'s LLVM tools}
    for index in "${!arguments[@]}"; do
      object=${arguments[$index]}
      [[ "$object" == *.rcgu.o && -s "$remaining" ]] || continue
      # The sections the object holds, among those still to name: each
      # named once, so no two objects define the same symbol.
      "$tools/llvm-objdump" -h "$object" | awk '$1 ~ /^[0-9]+$/ && NF >= 4 { print $2 }' |
        grep -Fx -f "$remaining" >"$scratch/held" || true
      [[ -s "$scratch/held" ]] || continue
      awk '{ print "--add-symbol"; print $0 "=" $0 ":0,global,hidden,object" }' "$scratch/held" >"$scratch/symbols"
      copy="$scratch/$index-$(basename "$object")"
      "$tools/llvm-objcopy" "@$scratch/symbols" "$object" "$copy"
      arguments[index]=$copy
      grep -Fxv -f "$scratch/held" "$remaining" >"$remaining.next" || true
      mv "$remaining.next" "$remaining"
    done
  fi
  # The link map, beside the executable, places each section: `xtask pgo
  # check` reads `.text`'s order there, as `xtask pgo refresh` reads which
  # sections the training touched, by the names the order file holds.
  output=""
  previous=""
  for argument in "${arguments[@]}"; do
    [[ "$previous" == -o ]] && output=$argument
    previous=$argument
  done
  extra+=("--symbol-ordering-file=$order" --no-warn-symbol-ordering "-Map=$output.map" --no-demangle)
fi
"$zig" ld.lld "${arguments[@]}" ${extra[@]+"${extra[@]}"} -z pack-relative-relocs
