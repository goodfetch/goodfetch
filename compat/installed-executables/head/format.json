{
  "name": "installed-executables",
  "schema": {
    "$defs": {
      "ArtifactId": {
        "description": "Which Pinned artifact: its kind, its name and its build.",
        "properties": {
          "build": {
            "arrived_in": "0.1",
            "description": "Its build ID, such as `141.0.7390.54-linux64`.",
            "type": "string"
          },
          "kind": {
            "$ref": "#/$defs/ArtifactKind",
            "arrived_in": "0.1",
            "description": "What it is."
          },
          "name": {
            "arrived_in": "0.1",
            "description": "Its name, such as `chrome-for-testing`.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name",
          "build"
        ],
        "type": "object"
      },
      "ArtifactKind": {
        "description": "What a Pinned artifact is (ADR 0098: the clean-up's rule covers every\nkind). An entry of a kind the engine does not know is one it cannot read,\nand keeps.",
        "oneOf": [
          {
            "const": "browser",
            "description": "A browser build, such as Chrome for Testing's.",
            "type": "string"
          },
          {
            "const": "driver",
            "description": "Playwright's driver (ADR 0019).",
            "type": "string"
          },
          {
            "const": "executable_copy",
            "description": "The versioned copy of an executable a Daemon runs from (ADR 0024).",
            "type": "string"
          },
          {
            "const": "engine_executable",
            "description": "The engine executable a Product's Rust crate downloads (ADR 0051).",
            "type": "string"
          },
          {
            "const": "clean_up_rules",
            "description": "A full Clean-up rules set (ADR 0047).",
            "type": "string"
          },
          {
            "const": "mouse_movements",
            "description": "Recorded mouse movements (ADR 0035).",
            "type": "string"
          },
          {
            "const": "plugin",
            "description": "A Plugin's artifact (ADR 0033), which the Plugin store keeps rather\nthan the Browser cache.",
            "type": "string"
          }
        ]
      },
      "ExecutableKind": {
        "description": "What an installed executable is (ADR 0098).",
        "oneOf": [
          {
            "const": "product_executable",
            "description": "A Product's executable, which can run its major's Daemon.",
            "type": "string"
          },
          {
            "const": "linked_program",
            "description": "A program that links the engine through a Product's Rust crate: its\nbuilds are kept, but it never runs the Daemon.",
            "type": "string"
          }
        ]
      },
      "InstalledExecutable": {
        "description": "One executable that ran on this machine (ADR 0098).",
        "properties": {
          "copy": {
            "anyOf": [
              {
                "$ref": "#/$defs/ArtifactId"
              },
              {
                "type": "null"
              }
            ],
            "arrived_in": "0.1",
            "description": "Its versioned copy in the Browser cache, from which a Daemon runs\n(ADR 0024), once one was made."
          },
          "kind": {
            "$ref": "#/$defs/ExecutableKind",
            "arrived_in": "0.1",
            "description": "What it is."
          },
          "last_seen": {
            "arrived_in": "0.1",
            "description": "When it last ran, in RFC 3339.",
            "format": "date-time",
            "type": "string"
          },
          "modified_at": {
            "arrived_in": "0.1",
            "description": "When its file was last modified then, in RFC 3339.",
            "format": "date-time",
            "type": "string"
          },
          "path": {
            "arrived_in": "0.1",
            "description": "Its absolute path when it last ran.",
            "type": "string"
          },
          "pins": {
            "arrived_in": "0.1",
            "description": "The browser builds and other cache downloads its version pins, its\nversioned copy included once a Daemon runs from it.",
            "items": {
              "$ref": "#/$defs/ArtifactId"
            },
            "type": "array"
          },
          "product": {
            "$ref": "#/$defs/Product",
            "arrived_in": "0.1",
            "description": "The Product it is, or whose Rust crate it links."
          },
          "product_version": {
            "$ref": "#/$defs/ProductVersion",
            "arrived_in": "0.1",
            "description": "Its Product version."
          },
          "size": {
            "arrived_in": "0.1",
            "description": "The size of its file in bytes then, which with `modified_at` tells\nwhether the file at `path` is still this executable.",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "kind",
          "product",
          "product_version",
          "path",
          "size",
          "modified_at",
          "pins",
          "last_seen"
        ],
        "type": "object"
      },
      "InstalledExecutables": {
        "description": "The list of installed executables, `installed-executables.json` in\nGoodfetch home (ADR 0098). Newer versions of the format only add, so an\nengine keeps every entry and field it does not know when it rewrites the\nlist.",
        "properties": {
          "executables": {
            "arrived_in": "0.1",
            "description": "One entry per executable, at one path and one Product version.",
            "items": {
              "$ref": "#/$defs/InstalledExecutable"
            },
            "type": "array"
          },
          "format_version": {
            "$ref": "#/$defs/ProtocolVersion",
            "arrived_in": "0.1",
            "description": "The version of this format the list was written in."
          }
        },
        "required": [
          "format_version",
          "executables"
        ],
        "type": "object"
      },
      "Product": {
        "description": "One of Goodfetch's two Products (ADR 0084), by its mark as the catalog\nwrites it.",
        "oneOf": [
          {
            "const": "collie",
            "description": "Browser automation; Foxhound contains it.",
            "type": "string"
          },
          {
            "const": "foxhound",
            "description": "Crawling, which contains Collie.",
            "type": "string"
          }
        ]
      },
      "ProductVersion": {
        "description": "A Product version, `major.minor.patch` with an optional pre-release (ADR 0090).",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
        "type": "string"
      },
      "ProtocolVersion": {
        "description": "A version `major.minor` (ADR 0030).",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
        "type": "string"
      }
    },
    "$ref": "#/$defs/InstalledExecutables"
  },
  "storage": "json",
  "version": "0.1"
}
