{
  "manifest_version": "0.1",
  "name": "example-models",
  "version": "1.0.0",
  "kinds": [
    "model",
    "secret"
  ],
  "protocol": {
    "min": "0.1",
    "max": "0.1"
  },
  "runtime": {
    "kind": "python",
    "version": "3.13.1"
  },
  "entrypoint": "example_models/main.py",
  "network_level": "direct",
  "permissions": {
    "domains": [
      "api.example-models.com"
    ],
    "secrets": [
      "vault://models/api-key"
    ],
    "grants": [
      "secret_value"
    ]
  },
  "limits": {
    "memory": 268435456,
    "cpu_time": 3600,
    "processes": 1,
    "open_files": 128,
    "concurrency": 4
  },
  "spend": {
    "tokens": {
      "max_per_call": 200000,
      "price": "0.000003 USD"
    }
  },
  "provider_name": "example",
  "models": [
    {
      "id": "example-large",
      "context_window": 200000,
      "max_output_tokens": 8192,
      "image_input": true,
      "tool_calls": true,
      "strategies": [
        "native",
        "tool",
        "prompt"
      ],
      "input_price": "3 USD",
      "output_price": "15 USD"
    }
  ],
  "scheme": "vault"
}
