{
  "name": "run-state",
  "schema": {
    "$defs": {
      "Completeness": {
        "description": "Whether a Run's results cover everything in its scope (ADRs 0005 and\n0029).",
        "oneOf": [
          {
            "const": "complete",
            "description": "They do.",
            "type": "string"
          },
          {
            "const": "incomplete",
            "description": "The Run ended early.",
            "type": "string"
          },
          {
            "const": "unverified",
            "description": "It finished, but the engine cannot vouch that nothing was missed.",
            "type": "string"
          }
        ]
      },
      "Lifecycle": {
        "description": "Where a Run is (ADR 0029).",
        "oneOf": [
          {
            "const": "running",
            "description": "It runs.",
            "type": "string"
          },
          {
            "const": "stopped",
            "description": "It ended early: by a Limit, an abort, its timeout, the loss of its\nengine or exhausted resources.",
            "type": "string"
          },
          {
            "const": "finished",
            "description": "It reached its end.",
            "type": "string"
          },
          {
            "const": "failed",
            "description": "An error in the engine or the program's code ended it.",
            "type": "string"
          }
        ]
      },
      "PointInTime": {
        "description": "A point in time in UTC, as RFC 3339.",
        "format": "date-time",
        "type": "string"
      },
      "Product": {
        "description": "One of Goodfetch's two Products (ADR 0084), by its mark as the catalog\nwrites it.",
        "oneOf": [
          {
            "const": "collie",
            "description": "Browser automation; Foxhound contains it.",
            "type": "string"
          },
          {
            "const": "foxhound",
            "description": "Crawling, which contains Collie.",
            "type": "string"
          }
        ]
      },
      "RunId": {
        "description": "A Run ID (ADR 0036): lowercase letters, digits, `.`, `_` and `-`, starting and ending with a letter or a digit, never a name Windows reserves for a device.",
        "pattern": "^[a-z0-9]([a-z0-9._-]{0,126}[a-z0-9])?$",
        "type": "string"
      },
      "RunKind": {
        "description": "What kind of Run it is: a Collie Run its program drives, or a crawl\n(ADR 0102), which its start's inputs name.",
        "oneOf": [
          {
            "const": "collie",
            "description": "A Run its program drives page by page.",
            "type": "string"
          },
          {
            "const": "crawl",
            "description": "A crawl, whose work items the engine leases to its handlers.",
            "type": "string"
          }
        ]
      },
      "RunStateRow": {
        "description": "One row of a Run's run state about itself: its `run` table (ADR 0002).",
        "properties": {
          "binding": {
            "description": "What the Run is bound to (ADR 0056), as JSON, or none.",
            "type": [
              "string",
              "null"
            ]
          },
          "caller": {
            "description": "Who started it (ADR 0102).",
            "type": "string"
          },
          "clean_up_digest": {
            "description": "The digest of the Clean-up rules the Run holds to, which a resume\nkeeps (ADR 0047), or none.",
            "type": [
              "string",
              "null"
            ]
          },
          "completeness": {
            "anyOf": [
              {
                "$ref": "#/$defs/Completeness"
              },
              {
                "type": "null"
              }
            ],
            "description": "Its Completeness, once it ended."
          },
          "ended_at": {
            "anyOf": [
              {
                "$ref": "#/$defs/PointInTime"
              },
              {
                "type": "null"
              }
            ],
            "description": "When it ended."
          },
          "epoch": {
            "description": "The current run epoch (ADR 0003).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "inputs": {
            "description": "Its start's inputs, as canonical JSON, which a later start compares.",
            "type": "string"
          },
          "journal_position": {
            "description": "How many commits the run file holds: the position of its journal,\nwhich a Checkpoint reports (ADR 0002).",
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "kind": {
            "$ref": "#/$defs/RunKind",
            "description": "What kind of Run it is."
          },
          "lifecycle": {
            "$ref": "#/$defs/Lifecycle",
            "description": "Where it is."
          },
          "needs": {
            "$ref": "#/$defs/Product",
            "description": "The Product it needs (ADR 0098)."
          },
          "policy_version": {
            "description": "The version of the Operator policy it ran under (ADR 0028).",
            "type": [
              "string",
              "null"
            ]
          },
          "run_id": {
            "$ref": "#/$defs/RunId",
            "description": "The Run's ID."
          },
          "started_at": {
            "$ref": "#/$defs/PointInTime",
            "description": "When it started."
          },
          "stop_reason": {
            "anyOf": [
              {
                "$ref": "#/$defs/StopReason"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why it stopped."
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/$defs/Verdict"
              },
              {
                "type": "null"
              }
            ],
            "description": "Its Verdict, once it ended."
          },
          "weakened_by": {
            "description": "The settings it ran with that weaken a guarantee or switch off a\ncostly control, as a JSON list of each one's key, value and layer\n(ADR 0028).",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "kind",
          "needs",
          "caller",
          "epoch",
          "inputs",
          "lifecycle",
          "started_at",
          "weakened_by",
          "journal_position"
        ],
        "type": "object"
      },
      "StopReason": {
        "description": "Why a Run stopped (ADR 0102); the other causes join with the tickets that\nstop Runs for them.",
        "oneOf": [
          {
            "description": "Its program, a person or a Client aborted it, a Connection's close\nincluded (ADR 0078).",
            "properties": {
              "by": {
                "$ref": "#/$defs/StoppedBy",
                "arrived_in": "0.1",
                "description": "Who stopped it."
              },
              "kind": {
                "const": "abort",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "by"
            ],
            "type": "object"
          },
          {
            "description": "It was paused: checkpointed and stopped, to be resumed by its Run ID\n(RT-11).",
            "properties": {
              "kind": {
                "const": "pause",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "It was migrated: checkpointed and stopped, to be resumed from its\nCheckpoint on another machine (ADR 0002).",
            "properties": {
              "kind": {
                "const": "migrate",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Its `timeout.run` passed, and it stopped at its next safe point,\nresumable with a fresh clock (ADR 0080); no Error code of its own.",
            "properties": {
              "kind": {
                "const": "timeout",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "description": "Its foreground Daemon drained on `SIGTERM`: checkpointed and\nstopped, to be resumed by its Run ID on the Daemon's next start\n(ADR 0049).",
            "properties": {
              "kind": {
                "const": "drain",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "StoppedBy": {
        "description": "Who stopped a call (ADR 0113).",
        "oneOf": [
          {
            "const": "client",
            "description": "A Client, such as through `$/cancel`.",
            "type": "string"
          }
        ]
      },
      "Verdict": {
        "description": "Whether a Run's own checks prove what it committed (ADR 0029).",
        "oneOf": [
          {
            "const": "verified",
            "description": "Every check the Run relies on passed, none was switched off, and no\nEffect is left uncertain.",
            "type": "string"
          },
          {
            "const": "rejected",
            "description": "A declared Success check failed.",
            "type": "string"
          },
          {
            "const": "needs_review",
            "description": "Everything else: a person reviews it.",
            "type": "string"
          }
        ]
      }
    },
    "$ref": "#/$defs/RunStateRow"
  },
  "storage": "sqlite",
  "version": "0.1"
}
