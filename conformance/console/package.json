{
  "name": "@goodfetch/console-conformance",
  "version": "0.0.0",
  "private": true,
  "description": "The Console conformance suite (ADRs 0031 and 0068): the Console's browser suite and its Client pointed at a target given as configuration; never published.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@goodfetch/collie-client": "workspace:*",
    "@goodfetch/console": "workspace:*",
    "@goodfetch/test-support": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "8.18.2",
    "typescript": "catalog:",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "goodfetch": {
    "runs": [
      "goodfetch-collie",
      "goodfetch-conformance",
      "goodfetch-foxhound",
      "goodfetch-proving-ground",
      "goodfetch-stub-gateway",
      "goodfetch-test-support"
    ]
  }
}
