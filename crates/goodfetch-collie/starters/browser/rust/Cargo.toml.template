[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.97"
publish = false

[dependencies]
goodfetch-collie = "={{version}}"
tokio = { version = "1.53.3", features = ["macros", "rt-multi-thread"] }

[dev-dependencies]
goodfetch-collie = { version = "={{version}}", features = ["test-util"] }

# Every browser launch checks the build's SHA-256 digest, some 400 MB:
# unoptimized, as a debug build leaves it, that takes tens of seconds.
[profile.dev.package.sha2]
opt-level = 3
