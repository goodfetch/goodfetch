{
  "description": "A broken target as an Attached engine: it refuses a `hello` of a newer minor, then answers the call behind it instead of closing the Connection.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.2",
          "surface": "rust",
          "needs": "collie",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32006,
          "message": "This Client speaks protocol 0.2, and this engine speaks 0.1: it accepts 0.0 to 0.1.",
          "data": {
            "code": "protocol_version_unsupported",
            "retryable": false,
            "engine_protocol_version": "0.1",
            "client_protocol_version": "0.2",
            "fix": "Upgrade the engine to a version that speaks protocol 0.2, or use a Client of the engine's own version."
          }
        }
      }
    },
    {
      "expect": {
        "method": "engine.info",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "product": "collie",
          "product_version": "0.0.0",
          "protocol_version": "0.1",
          "product_major": 0
        }
      }
    }
  ]
}
