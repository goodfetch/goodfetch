{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "description": "A published file or package.",
      "properties": {
        "attestation": {
          "$ref": "#/$defs/Attestation",
          "description": "Its Sigstore attestation bundle."
        },
        "name": {
          "description": "Its name as published: a package or crate name, a file name, or an\nOCI reference without its tag.",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/Sha256",
          "description": "The SHA-256 digest of what `url` serves."
        },
        "url": {
          "$ref": "#/$defs/HttpsUrl",
          "description": "Where it is downloaded from."
        }
      },
      "required": [
        "name",
        "url",
        "sha256",
        "attestation"
      ],
      "type": "object"
    },
    "Attestation": {
      "additionalProperties": false,
      "description": "A Sigstore attestation bundle, checked offline with `gh attestation\nverify --bundle` (ADR 0066).",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Sha256",
          "description": "The SHA-256 digest of the bundle."
        },
        "url": {
          "$ref": "#/$defs/HttpsUrl",
          "description": "Where the bundle is downloaded from."
        }
      },
      "required": [
        "url",
        "sha256"
      ],
      "type": "object"
    },
    "CancelParams": {
      "additionalProperties": false,
      "description": "What `$/cancel` names: the call to stop.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "arrived_in": "0.1",
          "description": "The call's id."
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "One check of a Journey's outcome.",
      "properties": {
        "task": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ],
          "description": "A Proving ground task the oracle must answer `verified` for."
        },
        "text": {
          "description": "What must be true.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "ClientPackages": {
      "additionalProperties": false,
      "description": "The Collie client packages, one per language (ADR 0095).",
      "properties": {
        "crates_io": {
          "$ref": "#/$defs/Artifact",
          "description": "The `goodfetch-collie-client` crate."
        },
        "npm": {
          "$ref": "#/$defs/Artifact",
          "description": "`@goodfetch/collie-client`."
        },
        "pypi": {
          "$ref": "#/$defs/Artifact",
          "description": "`goodfetch-collie-client`'s wheel."
        }
      },
      "required": [
        "npm",
        "pypi",
        "crates_io"
      ],
      "type": "object"
    },
    "EngineInfo": {
      "description": "What `engine.info` answers.",
      "properties": {
        "product": {
          "$ref": "#/$defs/Product",
          "arrived_in": "0.1",
          "description": "The Product the engine runs as."
        },
        "product_major": {
          "arrived_in": "0.1",
          "description": "The major of its Product version, which names its per-major state.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "product_version": {
          "$ref": "#/$defs/ProductVersion",
          "arrived_in": "0.1",
          "description": "The engine's Product version."
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion",
          "arrived_in": "0.1",
          "description": "The protocol version the engine speaks."
        }
      },
      "required": [
        "product",
        "product_version",
        "protocol_version",
        "product_major"
      ],
      "type": "object"
    },
    "EngineInfoParams": {
      "additionalProperties": false,
      "description": "What `engine.info` takes: nothing.",
      "type": "object"
    },
    "ErrorData": {
      "additionalProperties": true,
      "description": "What a failure's `data` holds: its Error code, whether the same call may\nsucceed when made again, and the code's own details.",
      "properties": {
        "code": {
          "description": "The Error code, or the name of the protocol failure.",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the same call may succeed when made again.",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "retryable"
      ],
      "type": "object"
    },
    "ErrorObject": {
      "additionalProperties": false,
      "description": "A failure on the wire (ADR 0038).",
      "properties": {
        "code": {
          "description": "One of JSON-RPC's predefined codes for a protocol failure; otherwise\nthe numeric class of the Error code's group, from −32000 to −32099.",
          "format": "int32",
          "type": "integer"
        },
        "data": {
          "$ref": "#/$defs/ErrorData",
          "description": "The Error code and its details."
        },
        "message": {
          "description": "What went wrong, for people; never matched on.",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "data"
      ],
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "The reply to a call that failed.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorObject",
          "description": "The failure."
        },
        "id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestId"
            },
            {
              "type": "null"
            }
          ],
          "description": "The call's id, or `null` when the engine could not read one."
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        }
      },
      "required": [
        "jsonrpc",
        "error"
      ],
      "type": "object"
    },
    "FeatureId": {
      "description": "A Feature's ID, `<kind>:<id>`, such as `row:CO-18` or `story:3-18`.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[^:\\s]+$",
      "type": "string"
    },
    "FormatVersion": {
      "description": "A registered format's version, `major.minor` (ADRs 0030 and 0066).",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$",
      "type": "string"
    },
    "HelloParams": {
      "additionalProperties": false,
      "description": "What a `hello` says.",
      "properties": {
        "needs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Product"
            },
            {
              "type": "null"
            }
          ],
          "arrived_in": "0.1",
          "description": "The Product the Client needs, which every surface but a Browser\nhost's must name (ADR 0095)."
        },
        "product_version": {
          "$ref": "#/$defs/ProductVersion",
          "arrived_in": "0.1",
          "description": "The sender's own Product version."
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion",
          "arrived_in": "0.1",
          "description": "The protocol version the sender speaks."
        },
        "surface": {
          "$ref": "#/$defs/Surface",
          "arrived_in": "0.1",
          "description": "The surface it comes from."
        },
        "token": {
          "arrived_in": "0.1",
          "description": "The Daemon's token; an Attached engine needs none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "protocol_version",
        "surface",
        "product_version"
      ],
      "type": "object"
    },
    "HelloResult": {
      "description": "What an engine answers to a `hello` it accepts.",
      "properties": {
        "product": {
          "$ref": "#/$defs/Product",
          "arrived_in": "0.1",
          "description": "The engine's Product."
        },
        "product_version": {
          "$ref": "#/$defs/ProductVersion",
          "arrived_in": "0.1",
          "description": "The engine's Product version."
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion",
          "arrived_in": "0.1",
          "description": "The protocol version the engine speaks."
        }
      },
      "required": [
        "protocol_version",
        "product",
        "product_version"
      ],
      "type": "object"
    },
    "HttpsUrl": {
      "description": "An https:// URL with a host.",
      "pattern": "^https://[^/?#\\s]+[^\\s]*$",
      "type": "string"
    },
    "Journey": {
      "additionalProperties": false,
      "description": "One Journey: a goal a person reaches through its Product's public\nsurfaces, written as steps from a starting state to an outcome checked\nfrom outside the engine (ADR 0063).",
      "properties": {
        "area": {
          "description": "The number of the ADR 0037 area whose spec owns the Journey.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "covers": {
          "description": "The Feature IDs the Journey exercises, each `<kind>:<id>`, such as\n`row:CO-18` for a row of ADR 0037's matrix or `story:3-18` for a user\nstory.",
          "items": {
            "$ref": "#/$defs/FeatureId"
          },
          "type": "array"
        },
        "expect": {
          "description": "The checks of the outcome.",
          "items": {
            "$ref": "#/$defs/Check"
          },
          "type": "array"
        },
        "goal": {
          "description": "What the person achieves and what MUST be true at the end, in RFC\n2119 words, readable as a specification without the code. It never\nchanges under the Journey's ID.",
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/JourneyId",
          "description": "`J-` and three to nine digits, equal to the file's name."
        },
        "product": {
          "$ref": "#/$defs/Product",
          "description": "The Product whose executable and SDK packages the Journey drives:\nCollie when Collie carries every step, Foxhound otherwise (ADR 0094)."
        },
        "proving_ground": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProvingGround"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Proving ground data the Journey starts from; absent when its goal\ntouches no page."
        },
        "reason": {
          "description": "Why a retired Journey was retired.",
          "type": [
            "string",
            "null"
          ]
        },
        "replaced_by": {
          "description": "The Journeys that hold a retired Journey's goal now, possibly none.",
          "items": {
            "$ref": "#/$defs/JourneyId"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/Status",
          "description": "Whether the Journey is still run."
        },
        "steps": {
          "description": "The steps, in order, in declarative words.",
          "items": {
            "$ref": "#/$defs/Step"
          },
          "type": "array"
        },
        "surfaces": {
          "additionalProperties": {
            "$ref": "#/$defs/Milestone"
          },
          "description": "Each surface the goal is reachable on, by its name in ADR 0063, with\nthe milestone by which that surface must prove it.",
          "type": "object"
        },
        "title": {
          "description": "A short name in the glossary's terms.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "goal",
        "area",
        "product",
        "status",
        "covers",
        "surfaces",
        "steps",
        "expect"
      ],
      "type": "object"
    },
    "JourneyCatalog": {
      "additionalProperties": false,
      "description": "`journeys/catalog.toml`.",
      "properties": {
        "next": {
          "description": "The next free Journey number: a new Journey takes it and increments\nit in the same pull request, and every ID is below it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "next"
      ],
      "type": "object"
    },
    "JourneyId": {
      "description": "A Journey's ID: `J-` and three to nine digits (ADR 0063).",
      "pattern": "^J-[0-9]{3,9}$",
      "type": "string"
    },
    "JsonRpcVersion": {
      "const": "2.0",
      "description": "JSON-RPC's version, always \"2.0\"."
    },
    "Message": {
      "anyOf": [
        {
          "$ref": "#/$defs/Request",
          "description": "A call."
        },
        {
          "$ref": "#/$defs/Notification",
          "description": "A message that expects no reply."
        },
        {
          "$ref": "#/$defs/Response",
          "description": "A success."
        },
        {
          "$ref": "#/$defs/ErrorResponse",
          "description": "A failure."
        }
      ],
      "description": "Any message of the protocol, as one line of a transcript holds it."
    },
    "Milestone": {
      "description": "A milestone of ADR 0058, `M1` to `M4`.",
      "oneOf": [
        {
          "const": "M1",
          "description": "The first milestone.",
          "type": "string"
        },
        {
          "const": "M2",
          "description": "The second milestone.",
          "type": "string"
        },
        {
          "const": "M3",
          "description": "The third milestone.",
          "type": "string"
        },
        {
          "const": "M4",
          "description": "The fourth milestone.",
          "type": "string"
        }
      ]
    },
    "Notification": {
      "additionalProperties": false,
      "description": "A message that expects no reply, such as `$/cancel`.",
      "properties": {
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "method": {
          "description": "What it says.",
          "type": "string"
        },
        "params": {
          "description": "Its params, a JSON object."
        }
      },
      "required": [
        "jsonrpc",
        "method"
      ],
      "type": "object"
    },
    "PinnedTask": {
      "additionalProperties": false,
      "description": "A Proving ground task a Journey names.",
      "properties": {
        "digest": {
          "$ref": "#/$defs/Sha256",
          "description": "The digest the task list gives the task, which ignores the port."
        },
        "id": {
          "$ref": "#/$defs/TaskId",
          "description": "The task's ID in the task list of the Journey's seed."
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object"
    },
    "Product": {
      "description": "One of Goodfetch's two Products (ADR 0084), by its mark as the catalog\nwrites it.",
      "oneOf": [
        {
          "const": "collie",
          "description": "Browser automation; Foxhound contains it.",
          "type": "string"
        },
        {
          "const": "foxhound",
          "description": "Crawling, which contains Collie.",
          "type": "string"
        }
      ]
    },
    "ProductArtifacts": {
      "additionalProperties": false,
      "description": "One Product's files at one release (ADR 0094).",
      "properties": {
        "crates_io": {
          "default": [],
          "description": "Its crates on crates.io.",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "type": "array"
        },
        "executables": {
          "default": [],
          "description": "Its executable's archive for each target.",
          "items": {
            "$ref": "#/$defs/TargetArtifact"
          },
          "type": "array"
        },
        "helm_chart": {
          "$ref": "#/$defs/Artifact",
          "description": "Its Helm chart, an OCI artifact."
        },
        "image": {
          "$ref": "#/$defs/Artifact",
          "description": "Its OCI image."
        },
        "npm": {
          "default": [],
          "description": "Its npm package and its platform packages.",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "type": "array"
        },
        "pypi": {
          "default": [],
          "description": "Its Python wheels on the Python Package Index.",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "type": "array"
        }
      },
      "required": [
        "helm_chart",
        "image"
      ],
      "type": "object"
    },
    "ProductVersion": {
      "description": "A Product version, `major.minor.patch` with an optional pre-release (ADR 0090).",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    },
    "ProtocolVersion": {
      "description": "A version `major.minor` (ADR 0030).",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "ProvingGround": {
      "additionalProperties": false,
      "description": "The Proving ground data a Journey starts from.",
      "properties": {
        "seed": {
          "description": "The seed every variant starts its Proving ground with, never\noverridden by `GOODFETCH_TEST_SEED`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tasks": {
          "default": [],
          "description": "Each Proving ground task the Journey names, pinned by its digest.",
          "items": {
            "$ref": "#/$defs/PinnedTask"
          },
          "type": "array"
        }
      },
      "required": [
        "seed"
      ],
      "type": "object"
    },
    "Release": {
      "additionalProperties": false,
      "description": "What one Product version shipped.",
      "properties": {
        "collie": {
          "$ref": "#/$defs/ProductArtifacts",
          "description": "Collie's files."
        },
        "collie_client": {
          "$ref": "#/$defs/ClientPackages",
          "description": "The Collie client packages both Products' SDKs build on (ADR 0095)."
        },
        "formats": {
          "additionalProperties": false,
          "description": "The version of every registered format the release shipped, read from\nits tag's format registry.",
          "patternProperties": {
            "^[a-z0-9]+(-[a-z0-9]+)*$": {
              "$ref": "#/$defs/FormatVersion"
            }
          },
          "type": "object"
        },
        "foxhound": {
          "$ref": "#/$defs/ProductArtifacts",
          "description": "Foxhound's files."
        },
        "plugins": {
          "default": [],
          "description": "The first-party Plugins, one OCI artifact per target (ADR 0094).",
          "items": {
            "$ref": "#/$defs/TargetArtifact"
          },
          "type": "array"
        },
        "version": {
          "$ref": "#/$defs/ProductVersion",
          "description": "The Product version both Products carry (ADR 0090)."
        }
      },
      "required": [
        "version",
        "formats",
        "collie",
        "foxhound",
        "collie_client"
      ],
      "type": "object"
    },
    "ReleasesFile": {
      "additionalProperties": false,
      "description": "The whole file: every release, oldest first.",
      "properties": {
        "release": {
          "default": [],
          "description": "One entry per stable release or patch; release candidates and\nnightlies have none.",
          "items": {
            "$ref": "#/$defs/Release"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Request": {
      "additionalProperties": false,
      "description": "A call that expects a reply.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "What the reply carries back."
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "method": {
          "description": "The operation, or `hello`.",
          "type": "string"
        },
        "params": {
          "description": "Its params, a JSON object."
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "method"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "description": "A number the Client chose.",
          "format": "int64",
          "type": "integer"
        },
        {
          "description": "A string the Client chose.",
          "type": "string"
        }
      ],
      "description": "A request's id, which its reply carries back."
    },
    "Response": {
      "additionalProperties": false,
      "description": "The reply to a call that succeeded.",
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId",
          "description": "The call's id."
        },
        "jsonrpc": {
          "$ref": "#/$defs/JsonRpcVersion",
          "description": "Always `\"2.0\"`."
        },
        "result": {
          "description": "What the call answered."
        }
      },
      "required": [
        "jsonrpc",
        "id",
        "result"
      ],
      "type": "object"
    },
    "SampleCrawlParams": {
      "additionalProperties": false,
      "description": "What `sample.crawl` starts from.",
      "properties": {
        "echo": {
          "$ref": "#/$defs/SampleEchoParams",
          "description": "The text each page repeats, a type Collie's catalog defines."
        },
        "pages": {
          "description": "How many pages to visit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "echo",
        "pages"
      ],
      "type": "object"
    },
    "SampleCrawlResult": {
      "description": "What `sample.crawl` answers.",
      "properties": {
        "visited": {
          "description": "How many pages were visited.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "visited"
      ],
      "type": "object"
    },
    "SampleCrawled": {
      "description": "What `sample.crawled` reports.",
      "properties": {
        "visited": {
          "description": "How many pages were visited.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "visited"
      ],
      "type": "object"
    },
    "SampleEchoParams": {
      "additionalProperties": false,
      "description": "What `sample.echo` repeats.",
      "properties": {
        "text": {
          "description": "The text to repeat.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SampleEchoResult": {
      "description": "What `sample.echo` answers.",
      "properties": {
        "text": {
          "description": "The text, repeated.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SampleEchoed": {
      "description": "What `sample.echoed` reports.",
      "properties": {
        "text": {
          "description": "The text that was repeated.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SamplePageFilterAdmitParams": {
      "description": "What a sample page filter is asked about a page.",
      "properties": {
        "url": {
          "description": "The page's URL.",
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "type": "object"
    },
    "SamplePageFilterAdmitResult": {
      "additionalProperties": false,
      "description": "What a sample page filter answers about a page.",
      "properties": {
        "admitted": {
          "description": "Whether the sample crawl visits the page.",
          "type": "boolean"
        }
      },
      "required": [
        "admitted"
      ],
      "type": "object"
    },
    "SampleStorePutParams": {
      "description": "What a sample store keeps.",
      "properties": {
        "key": {
          "description": "The key to keep the value under.",
          "type": "string"
        },
        "value": {
          "description": "The value to keep.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
