        {
          "const": "sdk_typescript",
          "description": "The TypeScript SDK.",
          "type": "string"
        },
        {
          "const": "sdk_python",
          "description": "The Python SDK.",
          "type": "string"
        },
        {
          "const": "rust",
          "description": "A Rust program, through a Product's crate.",
          "type": "string"
        },
        {
          "const": "cli",
          "description": "The CLI, as a Client of a Daemon.",
          "type": "string"
        },
        {
          "const": "mcp",
          "description": "The MCP server, as a Client of a Daemon.",
          "type": "string"
        },
        {
          "const": "console",
          "description": "The Console.",
          "type": "string"
        },
        {
          "const": "cloud",
          "description": "Goodfetch Cloud's gateway, or the Stub gateway, which a Collie engine\ntakes as given to word `not_in_product`'s `fix` (ADRs 0095, 0096).",
          "type": "string"
        },
        {
          "const": "browser_host",
          "description": "A Browser host, which is never a Client and needs no Product\n(ADR 0095).",
