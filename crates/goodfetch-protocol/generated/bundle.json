          "type": [
            "string",
            "null"
          ]
        },
        "on": {
          "description": "The one surface the step runs on in every variant, when the goal\nneeds that surface.",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "What the person does, in declarative words that survive a change of\nimplementation.",
