          "type": "boolean"
        }
      },
      "required": [
        "replaced"
      ],
      "type": "object"
    },
    "Sha256": {
      "description": "A SHA-256 digest of 64 lowercase hexadecimal digits.",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "Status": {
      "description": "Whether a Journey is still run.",
      "oneOf": [
        {
          "const": "active",
          "description": "Run on every surface it lists.",
          "type": "string"
        },
        {
          "const": "retired",
