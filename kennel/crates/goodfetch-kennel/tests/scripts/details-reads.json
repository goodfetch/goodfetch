              "needs": "foxhound",
              "tags": ["goodfetch.recipe:shop"],
              "lifecycle": "running",
              "verdict": null,
              "completeness": null,
              "started_at": "2026-11-03T09:00:00Z",
              "ended_at": null,
              "owner": null,
              "presence": "present",
              "progress_message": "Crawling",
              "stop_reason": null,
              "replayed": false
            }
          ]
        }
      }
    },
    {
      "expect": {
        "method": "run.usage",
        "params": {
          "run_id": "shop-crawl"
        }
      }
    },
    {
      "reply": {
        "result": {
          "model": {
            "calls": 3,
            "tokens": 1200,
            "input_tokens": 0,
            "cache_read_tokens": 0,
            "cache_write_tokens": 0,
            "output_tokens": 0,
            "reasoning_tokens": 0,
            "price": null
          },
          "browser_time": 65000,
          "proxy_bytes": 2048,
          "requests": 12
        }
      }
    },
    {
      "expect": {
        "method": "run.report",
        "params": {
          "run_id": "shop-crawl"
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 5
        }
      }
    },
    {
      "expect": {
        "method": "run.report",
        "params": {
          "run_id": "old-crawl"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "old-crawl",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-11-03T08:00:00Z",
          "ended_at": "2026-11-03T08:30:00Z",
          "usage": {
            "model": {
              "calls": 3,
              "tokens": 1200,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
