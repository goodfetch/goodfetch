            "browser_time": 65000,
            "proxy_bytes": 2048,
            "requests": 12
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.report",
        "params": {
          "run_id": "gone-crawl"
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32006,
          "message": "The Run has no live writer and has not ended.",
          "data": {
            "code": "run_interrupted",
            "retryable": false,
