{
  "description": "The details window's reads: the Run index's rows of its filter; a Run's Usage; and the chosen Run's report, a live Run's read cancelled once it is no longer wanted, an ended Run's answered at once, one with no live writer refused with run_interrupted. Then the Daemon closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "kennel",
          "token": "kennel-test-token",
          "needs": "collie",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.4.1",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "events.subscribe",
        "params": {
          "after": {
            "engine_instance": "0123456789abcdef",
            "position": 18446744073709551615
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 64
        }
      }
    },
    {
      "expect": {
