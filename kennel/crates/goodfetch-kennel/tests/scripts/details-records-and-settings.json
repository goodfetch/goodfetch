{
  "description": "The details window's Records and settings reads: a query of a Run's Records, cancelled once another is wanted, the next one answered; then the settings in force, through config.explain. Then the Daemon closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "kennel",
          "token": "kennel-test-token",
          "needs": "collie",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.4.1",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "events.subscribe",
        "params": {
          "after": {
            "engine_instance": "0123456789abcdef",
            "position": 18446744073709551615
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 64
        }
      }
    },
    {
      "expect": {
        "method": "dataset.query",
        "params": {
          "sql": "SELECT dataset, number FROM records('shop-crawl')",
          "runs": ["shop-crawl"],
          "limit": 50
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 3
        }
      }
    },
    {
      "expect": {
        "method": "dataset.query",
        "params": {
          "sql": "SELECT dataset, number FROM records('shop-crawl') OFFSET 50",
          "runs": ["shop-crawl"],
          "limit": 50
        }
      }
    },
    {
      "reply": {
        "result": {
          "columns": [
            {
              "name": "dataset",
              "type": "VARCHAR"
            },
            {
              "name": "number",
              "type": "BIGINT"
            }
          ],
          "rows": [["products", 51]],
          "total": 1
        }
      }
    },
    {
      "expect": {
        "method": "config.explain",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "files": [
            {
              "layer": "user_configuration",
              "path": "/home/someone/.config/goodfetch/config.toml",
              "found": true
            }
          ],
          "settings": [
            {
              "key": "timeout.navigation",
              "products": ["collie", "foxhound"],
              "applied": true,
              "value": 30000,
              "layer": "user_configuration",
              "weakens": false
            }
          ]
        }
      }
    },
    {
      "expect": {
        "method": "dataset.query",
        "params": {
          "sql": "SELECT dataset, number FROM records('shop-crawl')",
          "runs": ["shop-crawl"],
          "limit": 50
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32602,
          "message": "The statement names a table that does not exist.",
          "data": {
            "code": "query_invalid",
            "retryable": false
          }
        }
      }
    },
    {
      "close": {}
    }
  ]
}
