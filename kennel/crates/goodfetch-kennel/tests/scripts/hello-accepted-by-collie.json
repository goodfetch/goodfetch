{
  "description": "A Collie Daemon of version 0.4.2 accepts the Kennel's hello and its subscription, which leaves the keep-alive flag out; the play ends once the Kennel closes the Connection.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "kennel",
          "token": "kennel-test-token",
          "needs": "collie",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.4.2",
          "engine_instance": "fedcba9876543210"
        }
      }
    },
    {
      "expect": {
        "method": "events.subscribe",
        "params": {
          "after": {
            "engine_instance": "fedcba9876543210",
            "position": 18446744073709551615
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 64
        }
      }
    }
  ]
}
