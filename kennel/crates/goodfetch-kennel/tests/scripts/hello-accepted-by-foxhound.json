{
  "description": "The Kennel says hello to the Daemon as the kennel surface, with the runtime file's token, needing Collie and leaving the keep-alive flag out; a Foxhound Daemon accepts it, and the Kennel subscribes to its events from a resync, with 64 credits. The play ends once the Kennel closes the Connection.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "kennel",
          "token": "kennel-test-token",
          "needs": "collie",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.4.1",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "events.subscribe",
        "params": {
          "after": {
            "engine_instance": "0123456789abcdef",
            "position": 18446744073709551615
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 64
        }
      }
    }
  ]
}
