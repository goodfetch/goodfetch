{
  "description": "A Foxhound Daemon accepts the Kennel's hello, then closes the Connection, as a Daemon that stops does.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "kennel",
          "token": "kennel-test-token",
          "needs": "collie",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.4.1",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "close": {}
    }
  ]
}
