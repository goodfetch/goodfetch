{
  "description": "With its keep-alive setting on, the Kennel's hello asks the Daemon to count it as a Client that keeps it alive; a Foxhound Daemon accepts it, and the play ends once the Kennel closes the Connection.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "kennel",
          "token": "kennel-test-token",
          "needs": "collie",
          "product_version": "0.0.0",
          "keep_daemon_alive": true
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.4.1",
          "engine_instance": "0123456789abcdef"
        }
      }
    }
  ]
}
