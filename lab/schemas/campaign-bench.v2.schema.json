{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automan.local/lab/schemas/campaign-bench.v2.schema.json",
  "title": "Automan lab bench campaign, schema version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "lane", "decisionIds", "hostClass", "seed", "blocks", "warmup", "iterations", "concurrency", "mode", "timeoutMs", "maxDurationMs", "maxRestarts", "backends", "scenarios", "fixtures"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]{1,80}$" },
    "lane": { "const": "bench" },
    "decisionIds": { "type": "array", "items": { "type": "string", "pattern": "^D-[a-z0-9-]+$" } },
    "hostClass": {
      "type": "object", "additionalProperties": false, "required": ["requested", "allowDowngrade"],
      "properties": { "requested": { "enum": ["local-dev", "local-controlled", "reference"] }, "allowDowngrade": { "type": "boolean" } }
    },
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "blocks": { "type": "integer", "minimum": 1, "maximum": 100 },
    "warmup": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "iterations": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "concurrency": { "type": "integer", "minimum": 1, "maximum": 128 },
    "mode": { "enum": ["closed", "open"] },
    "ratePerSecond": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
    "timeoutMs": { "type": "integer", "minimum": 50, "maximum": 120000 },
    "maxDurationMs": { "type": "integer", "minimum": 100, "maximum": 3600000 },
    "network": {"type": "object", "additionalProperties": false, "required": ["link", "rttMs"], "properties": {"link": {"enum": ["browser-origin", "driver-browser"]}, "rttMs": {"type": "number", "minimum": 0, "maximum": 2000}}},
    "maxRestarts": { "type": "integer", "minimum": 0, "maximum": 20 },
    "backends": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "fixtures": {
      "type": "object", "additionalProperties": false, "required": ["pages", "actions"],
      "properties": {
        "pages": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "actions": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "delayMs": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "variants": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "poolWake": { "enum": ["poll", "notify"] },
    "browserHost": { "enum": ["adapter", "harness"] },
    "actionPolicies": { "type": "object", "additionalProperties": { "enum": ["native", "guarded"] } }
  }
}
