{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automan.local/lab/schemas/claim.schema.json",
  "title": "Automan performance or quality claim, declared before measurement",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "statement", "decisionId", "metricId", "comparator", "direction", "publicationHostClass", "status", "evidence", "notes"],
  "properties": {
    "id": { "type": "string", "pattern": "^C-[a-z0-9-]+$" },
    "statement": { "type": "string", "minLength": 1 },
    "decisionId": { "type": "string", "pattern": "^D-[a-z0-9-]+$" },
    "metricId": { "type": "string" },
    "comparator": {
      "type": "object", "additionalProperties": false, "required": ["option", "against"],
      "properties": { "option": { "type": "string" }, "against": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    },
    "direction": { "enum": ["lower", "higher", "zero"] },
    "publicationHostClass": { "enum": ["local-controlled", "reference"] },
    "status": { "enum": ["candidate", "supported", "refuted", "withdrawn"] },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
