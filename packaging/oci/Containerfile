# One multi-stage OCI image recipe shared by both Products and all five tags
# (`<v>`, `<v>-slim`, `<v>-full`, `<v>-node`, `<v>-python`, ADRs 0049, 0088,
# 0090, 0094, 0096 and 0115; issues 141 and 202).
#
# Every tag:
# - builds on pinned Debian 13 slim (`debian:trixie-slim@sha256:...`) for
#   `linux/amd64` and `linux/arm64`;
# - runs as non-root UID 10001:10001;
# - sets `GOODFETCH_BROWSERS_PATH=/usr/local/share/goodfetch/browsers` holding
#   the read-only Clean-up rules set beside whatever browsers that tag ships,
#   so a container under the outbound-traffic deny downloads nothing at start
#   (and a tag without a browser fails with `browser_not_installed`);
# - places `COPY bin/${TARGETARCH}/${PRODUCT_EXECUTABLE}` as the final layer,
#   so Collie and Foxhound share every base layer.

FROM docker.io/library/debian:trixie-slim@sha256:8aa5a7bf5a1955bddbe7d74fcdd0b91ab30e74362a8b73af672b0481b35b44a0 AS base

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 10001 goodfetch \
 && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin goodfetch \
 && mkdir -p /usr/local/share/goodfetch/browsers/clean-up-rules \
 && printf '#!/bin/sh\nexec "/usr/local/bin/%s" "$@"\n' '${GOODFETCH_PRODUCT_EXECUTABLE}' >/usr/local/bin/goodfetch-entrypoint \
 && chmod 0755 /usr/local/bin/goodfetch-entrypoint

# Full Clean-up rules set shipped read-only inside every tag (ADR 0047).
COPY clean-up-rules/ /usr/local/share/goodfetch/browsers/clean-up-rules/

ENV GOODFETCH_HOME=/home/goodfetch/.goodfetch \
    GOODFETCH_BROWSERS_PATH=/usr/local/share/goodfetch/browsers
WORKDIR /home/goodfetch
ENTRYPOINT ["/usr/local/bin/goodfetch-entrypoint"]

# ── slim: engine + Clean-up rules only (no browser builds) ───────────────────
FROM base AS slim
USER 10001:10001
ARG PRODUCT_EXECUTABLE=goodfetch-collie
ARG TARGETARCH
ENV GOODFETCH_PRODUCT_EXECUTABLE=${PRODUCT_EXECUTABLE}
COPY --chmod=0755 bin/${TARGETARCH}/${PRODUCT_EXECUTABLE} /usr/local/bin/${PRODUCT_EXECUTABLE}

# ── default-base: shared browser runtime libs + default browser cache ────────
FROM base AS default-base
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      fonts-liberation libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 \
      libcups2t64 libdbus-1-3 libdrm2 libgbm1 libgtk-3-0t64 libnspr4 libnss3 \
      libxcomposite1 libxdamage1 libxfixes3 libxkbcommon0 libxrandr2 \
 && rm -rf /var/lib/apt/lists/*
COPY browsers/default/ /usr/local/share/goodfetch/browsers/

# ── default (`<v>`): engine + default browser + Clean-up rules ───────────────
# Collie's default and `-full` tags also run the Browser host (`browser-host`).
FROM default-base AS default
USER 10001:10001
ARG PRODUCT_EXECUTABLE=goodfetch-collie
ARG TARGETARCH
ENV GOODFETCH_PRODUCT_EXECUTABLE=${PRODUCT_EXECUTABLE}
COPY --chmod=0755 bin/${TARGETARCH}/${PRODUCT_EXECUTABLE} /usr/local/bin/${PRODUCT_EXECUTABLE}

# ── full (`<v>-full`): engine + every pinned browser + Clean-up rules ────────
FROM default-base AS full
COPY browsers/full/ /usr/local/share/goodfetch/browsers/
USER 10001:10001
ARG PRODUCT_EXECUTABLE=goodfetch-collie
ARG TARGETARCH
ENV GOODFETCH_PRODUCT_EXECUTABLE=${PRODUCT_EXECUTABLE}
COPY --chmod=0755 bin/${TARGETARCH}/${PRODUCT_EXECUTABLE} /usr/local/bin/${PRODUCT_EXECUTABLE}

# ── node (`<v>-node`): default + Node.js runtime + matching Product SDK ──────
FROM default-base AS node
RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs npm \
 && rm -rf /var/lib/apt/lists/*
ARG PRODUCT_KEY=collie
COPY sdk/npm/${PRODUCT_KEY}/ /usr/local/lib/goodfetch-sdk/node/
USER 10001:10001
ARG PRODUCT_EXECUTABLE=goodfetch-collie
ARG TARGETARCH
ENV GOODFETCH_PRODUCT_EXECUTABLE=${PRODUCT_EXECUTABLE} \
    NODE_PATH=/usr/local/lib/goodfetch-sdk/node
COPY --chmod=0755 bin/${TARGETARCH}/${PRODUCT_EXECUTABLE} /usr/local/bin/${PRODUCT_EXECUTABLE}

# ── python (`<v>-python`): default + Python 3 runtime + matching Product SDK ─
FROM default-base AS python
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*
ARG PRODUCT_KEY=collie
ARG TARGETARCH
COPY sdk/wheels/${PRODUCT_KEY}/ /tmp/goodfetch-wheels/
RUN arch_tag=$([ "${TARGETARCH}" = "arm64" ] && echo "aarch64" || echo "x86_64") \
 && wheels=$(find /tmp/goodfetch-wheels -maxdepth 1 -name "*-py3-none-any.whl" -o -name "*-linux_${arch_tag}.whl" -o -name "*_${arch_tag}.whl") \
 && if [ -n "${wheels}" ]; then \
      pip3 install --no-cache-dir --break-system-packages --no-deps --no-index \
        --find-links /tmp/goodfetch-wheels ${wheels}; \
    fi \
 && rm -rf /tmp/goodfetch-wheels
USER 10001:10001
ARG PRODUCT_EXECUTABLE=goodfetch-collie
ENV GOODFETCH_PRODUCT_EXECUTABLE=${PRODUCT_EXECUTABLE}
COPY --chmod=0755 bin/${TARGETARCH}/${PRODUCT_EXECUTABLE} /usr/local/bin/${PRODUCT_EXECUTABLE}
