{
  "id": "D-scheduling",
  "title": "Multi-domain admission and scheduling",
  "question": "Under continuous arrivals, does a bounded per-domain queue with round-robin protect small domains when one domain is overloaded, better than a global queue?",
  "kind": "technical",
  "status": "open",
  "options": [
    {
      "id": "fifo-global",
      "description": "A bounded global queue; the dispatcher takes the oldest work item whose domain has a free slot"
    },
    {
      "id": "fair-domain",
      "description": "One bounded queue per domain under a global cap; the dispatcher serves domains in round-robin"
    }
  ],
  "baseline": "fifo-global",
  "primaryMetric": {
    "metricId": "light-domain-goodput",
    "blockStatistic": "median"
  },
