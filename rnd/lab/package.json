{
  "name": "automan-lab",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts && node --test --test-concurrency=1 tests/timing/*.test.ts",
    "integration": "node --test tests/integration/*.test.ts",
    "check": "tsc --noEmit",
    "doctor": "node tools/doctor.ts",
    "bootstrap": "node tools/bootstrap.ts",
    "run": "node src/cli.ts",
    "bench": "node src/cli.ts",
    "storage": "node src/storage-cli.ts",
    "shared-build": "node tools/build-shared-sqlite.ts",
    "workflow": "node src/workflow-cli.ts",
    "workflow-build": "node tools/build-workflow.ts",
    "runtime": "node src/runtime-campaign.ts",
    "actionability": "node src/actionability-campaign.ts",
    "sqlite-readers": "node src/sqlite-readers-campaign.ts",
    "report": "node src/cli.ts report",
    "lab": "node tools/lab.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "ajv": "8.20.0",
    "http-message-sig": "0.3.0",
    "marked": "18.1.0",
    "typescript": "7.0.2",
    "web-bot-auth": "0.2.0"
  }
}
