{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automan.local/lab/schemas/decision.schema.json",
  "title": "Automan lab decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "question",
    "kind",
    "status",
    "options",
    "evidence",
    "dependsOn",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^D-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "technical",
        "product"
      ]
    },
    "status": {
      "enum": [
        "open",
        "evidence-pending",
        "decided",
        "superseded",
        "deferred"
      ]
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "description": {
            "type": "string"
          },
          "adapters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "baseline": {
      "type": "string"
    },
    "primaryMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricId",
        "blockStatistic"
      ],
      "properties": {
        "metricId": {
          "type": "string"
        },
        "blockStatistic": {
          "enum": [
            "median",
            "ratio-of-sums",
            "proportion"
          ]
        }
      }
    },
    "secondaryMetrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contractGates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "enum": [
            "ratio",
            "absolute"
          ]
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "alpha",
        "power",
        "noisyBlockPolicy"
      ],
      "properties": {
        "kind": {
          "enum": [
            "superiority",
            "non-inferiority",
            "equivalence"
          ]
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.2
        },
        "power": {
          "type": "number",
          "minimum": 0.5,
          "exclusiveMaximum": 1
        },
        "noisyBlockPolicy": {
          "enum": [
            "exclude",
            "inconclusive"
          ]
        }
      }
    },
    "hostClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "publication"
      ],
      "properties": {
        "decision": {
          "enum": [
            "local-dev",
            "local-controlled",
            "reference"
          ]
        },
        "publication": {
          "enum": [
            "local-controlled",
            "reference"
          ]
        }
      }
    },
    "networkProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "link",
          "rttMs"
        ],
        "properties": {
          "link": {
            "enum": [
              "driver-browser",
              "browser-origin",
              "http-origin"
            ]
          },
          "rttMs": {
            "type": "number",
            "minimum": 0
          },
          "lossPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "campaigns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "run",
              "research-doc"
            ]
          },
          "ref": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "verdictRef": {
      "type": [
        "string",
        "null"
      ]
    },
    "adr": {
      "type": [
        "string",
        "null"
      ]
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^D-[a-z0-9-]+$"
      }
    },
    "notes": {
      "type": "string"
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane",
        "options",
        "pairBy",
        "stratum"
      ],
      "description": "How cells of evidence runs map to options and are paired; required to compute a verdict",
      "properties": {
        "lane": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "description": "option id -> factor values; null means the factor is absent"
        },
        "strata": {
          "type": "array",
          "items": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
          "description": "strata compared separately, the first being the primary one; defaults to [stratum]"
        },
        "gateLanes": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "contract gate id -> lane whose cells the gate reads; defaults to the measurement lane"
        },
        "pairBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stratum": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "technical"
      }
    }
  },
  "then": {
    "required": [
      "baseline",
      "primaryMetric",
      "contractGates",
      "delta",
      "rule",
      "hostClass",
      "campaigns",
      "verdictRef"
    ]
  }
}
