"""Concurrency, events and user code (ADR 0081, decided in #468).

`AsyncGoodfetch` runs on AnyIO, so under asyncio and Trio. Its values belong to the event loop that opened their
connection: any number of tasks on that loop may share them, and a call from another loop or thread fails at once
with a `ProgramError` naming `Goodfetch`. `Goodfetch` (sync) runs the async core on a private background thread of
its own connection (ADR 0038) and never touches the caller's event loop, so it also works where one is already running
(a notebook cell, Streamlit, an agent framework's tool); its values are safe to call from any thread. In a sync call,
Ctrl+C, or any exception raised in the waiting thread, sends `$/cancel` without waiting and propagates unchanged.

The SDK keeps no queue: each call goes to the engine when it is made, and the engine starts a page's calls in arrival
order. Each event has one shape: side activity on a page is observed with `on(event, listener)`, which returns a
`Subscription`; a sequence the program reads to its end is an iterator. Both subscribe when the method is called.
User code runs, in the async API, as tasks on the connection's loop inside a task group of the value that registered
it, so closing that value cancels and awaits them; handlers and routes are `async def`, predicates plain functions,
listeners either. In the sync API it runs on a thread pool the connection owns, never on its private thread; it is
plain functions, and on free-threaded builds it runs in parallel. The engine sends no more requests at once than the
concurrency setting allows. Globs and compiled patterns run in the engine, in the Rust `regex` syntax (no look-around
or backreferences, linear time); a pattern using either fails at the call with a `ProgramError` naming the construct.
A predicate runs in the program, on the events the engine sends while it is armed, never in the page.
The page's events, routes, dialogs and the data they carry are ADR 0085's (`_page`); `records()` is #479's.
"""

from collections.abc import Awaitable, Callable, Iterator, Mapping
from contextlib import AbstractAsyncContextManager, AbstractContextManager
from types import TracebackType
from typing import Generic, Literal, Self, TypeAlias, TypeVar, final, overload

from goodfetch._lifecycle import AsyncPage, Page
from goodfetch._page import (
    AsyncDialogHandler,
    AsyncDownload,
    AsyncFileChooser,
    AsyncRequest,
    AsyncResponse,
    AsyncWebSocket,
    ConsoleMessage,
    DialogHandler,
    Download,
    FileChooser,
    Request,
    Response,
    WebError,
    WebSocket,
)
from goodfetch._time import AsyncEventInfo, EventInfo, Timeout

T = TypeVar("T")

@final
class Subscription:
    """A registered listener or route. It closes like any value (ADR 0078), here without waiting.

    There is no `off` and no `once`: close the subscription, and wait for one event with `expect_event` (S2).
    """

    def close(self) -> None:
        """Idempotent. Unsubscribes without waiting for the engine."""

    def __enter__(self) -> Self: ...
    def __exit__(
        self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: TracebackType | None
    ) -> None: ...

# Async API.

AsyncListener: TypeAlias = Callable[[T], Awaitable[None] | None]
"""Gets its events one at a time, in order; an awaitable it returns is awaited before the next event, so
lossless events slow their producer and telemetry coalesces (ADR 0024)."""

@final
class AsyncEventIterator(Generic[T]):
    """A sequence read to its end with `async for`, subscribed when the method was called.

    It unsubscribes, without waiting, when it ends, when `aclose()` or `async with` closes it, or when it is released,
    which in CPython happens as soon as `async for x in run.records():` is left by `break`. One reader each. While
    open, an unread lossless sequence slows its Run (ADR 0024); a telemetry sequence keeps only the latest value.
    """

    def __aiter__(self) -> Self: ...
    async def __anext__(self) -> T: ...
    async def aclose(self) -> None: ...
    async def __aenter__(self) -> Self: ...
    async def __aexit__(
        self, exc_type: type[BaseException] | None, exc: BaseException | None, tb: TracebackType | None
    ) -> None: ...

class AsyncPageEvents:
    """The page's events and what each carries, under Playwright's names (S3, ADR 0085)."""
    @overload
    def on(self, event: Literal["console"], listener: AsyncListener[ConsoleMessage]) -> Subscription: ...
    @overload
    def on(self, event: Literal["pageerror"], listener: AsyncListener[WebError]) -> Subscription: ...
    @overload
    def on(self, event: Literal["request", "requestfinished", "requestfailed"], listener: AsyncListener[AsyncRequest]) -> Subscription: ...
    @overload
    def on(self, event: Literal["response"], listener: AsyncListener[AsyncResponse]) -> Subscription: ...
    @overload
    def on(self, event: Literal["popup"], listener: AsyncListener[AsyncPage]) -> Subscription: ...
    @overload
    def on(self, event: Literal["download"], listener: AsyncListener[AsyncDownload]) -> Subscription: ...
    @overload
    def on(self, event: Literal["filechooser"], listener: AsyncListener[AsyncFileChooser]) -> Subscription: ...
    @overload
    def on(self, event: Literal["websocket"], listener: AsyncListener[AsyncWebSocket]) -> Subscription: ...
    @overload
    def on(self, event: Literal["load", "domcontentloaded", "close", "crash"], listener: AsyncListener[None]) -> Subscription: ...
    @overload
    def on(self, event: Literal["dialog"], handler: AsyncDialogHandler) -> Subscription:
        """Answers dialogs, registered when called: with none, or none that answers, a dialog gets Playwright's default,
        dismissed, or accepted for `beforeunload`."""
    @overload
    def expect_event(
        self, event: Literal["console"], *, predicate: Callable[[ConsoleMessage], bool] | None = None, timeout: Timeout = ...
    ) -> AbstractAsyncContextManager[AsyncEventInfo[ConsoleMessage]]: ...
    @overload
    def expect_event(
        self, event: Literal["pageerror"], *, predicate: Callable[[WebError], bool] | None = None, timeout: Timeout = ...
    ) -> AbstractAsyncContextManager[AsyncEventInfo[WebError]]: ...
    @overload
    def expect_event(
        self, event: Literal["request", "requestfinished", "requestfailed"], *, predicate: Callable[[AsyncRequest], bool] | None = None, timeout: Timeout = ...
    ) -> AbstractAsyncContextManager[AsyncEventInfo[AsyncRequest]]: ...
    @overload
    def expect_event(
        self, event: Literal["response"], *, predicate: Callable[[AsyncResponse], bool] | None = None, timeout: Timeout = ...
    ) -> AbstractAsyncContextManager[AsyncEventInfo[AsyncResponse]]: ...
    @overload
    def expect_event(
        self, event: Literal["popup"], *, predicate: Callable[[AsyncPage], bool] | None = None, timeout: Timeout = ...
    ) -> AbstractAsyncContextManager[AsyncEventInfo[AsyncPage]]: ...
    @overload
    def expect_event(
        self, event: Literal["download"], *, predicate: Callable[[AsyncDownload], bool] | None = None, timeout: Timeout = ...
    ) -> AbstractAsyncContextManager[AsyncEventInfo[AsyncDownload]]: ...
    @overload
    def expect_event(
        self, event: Literal["filechooser"], *, predicate: Callable[[AsyncFileChooser], bool] | None = None, timeout: Timeout = ...
    ) -> AbstractAsyncContextManager[AsyncEventInfo[AsyncFileChooser]]: ...
    @overload
    def expect_event(
        self, event: Literal["websocket"], *, predicate: Callable[[AsyncWebSocket], bool] | None = None, timeout: Timeout = ...
    ) -> AbstractAsyncContextManager[AsyncEventInfo[AsyncWebSocket]]: ...
    @overload
    async def wait_for_event(
        self, event: Literal["console"], *, predicate: Callable[[ConsoleMessage], bool] | None = None, timeout: Timeout = ...
    ) -> ConsoleMessage: ...
    @overload
    async def wait_for_event(
        self, event: Literal["pageerror"], *, predicate: Callable[[WebError], bool] | None = None, timeout: Timeout = ...
    ) -> WebError: ...
    @overload
    async def wait_for_event(
        self, event: Literal["request", "requestfinished", "requestfailed"], *, predicate: Callable[[AsyncRequest], bool] | None = None, timeout: Timeout = ...
    ) -> AsyncRequest: ...
    @overload
    async def wait_for_event(
        self, event: Literal["response"], *, predicate: Callable[[AsyncResponse], bool] | None = None, timeout: Timeout = ...
    ) -> AsyncResponse: ...
    @overload
    async def wait_for_event(
        self, event: Literal["popup"], *, predicate: Callable[[AsyncPage], bool] | None = None, timeout: Timeout = ...
    ) -> AsyncPage: ...
    @overload
    async def wait_for_event(
        self, event: Literal["download"], *, predicate: Callable[[AsyncDownload], bool] | None = None, timeout: Timeout = ...
    ) -> AsyncDownload: ...
    @overload
    async def wait_for_event(
        self, event: Literal["filechooser"], *, predicate: Callable[[AsyncFileChooser], bool] | None = None, timeout: Timeout = ...
    ) -> AsyncFileChooser: ...
    @overload
    async def wait_for_event(
        self, event: Literal["websocket"], *, predicate: Callable[[AsyncWebSocket], bool] | None = None, timeout: Timeout = ...
    ) -> AsyncWebSocket: ...

