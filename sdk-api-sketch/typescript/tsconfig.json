{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2024", "esnext.disposable", "dom"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": false,
    "types": [],
    "paths": {
      "@goodfetch/collie-client": ["./collie-client/index.d.ts"],
      "@goodfetch/collie-client/testing": ["./collie-client/testing.d.ts"],
      "@goodfetch/collie": ["./collie/index.d.ts"],
      "@goodfetch/collie/testing": ["./collie/testing.d.ts"],
      "@goodfetch/foxhound": ["./foxhound/index.d.ts"],
      "@goodfetch/foxhound/testing": ["./foxhound/testing.d.ts"]
    }
  },
  "include": ["collie-client/**/*.d.ts", "collie/**/*.d.ts", "foxhound/**/*.d.ts", "scenarios/**/*.ts"]
}
