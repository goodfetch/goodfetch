{
  "description": "After an accepted hello, the engine answers a Run's start with a line that is not JSON-RPC on stdout, then waits for a call the Client never sends: a Client that stops the engine after the garbage ends it silently, while one that leaves it running sees the play fail on its stderr when the Client closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "raw": {
        "text": "INFO engine started\n"
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "never-sent"
        }
      }
    }
  ]
}
