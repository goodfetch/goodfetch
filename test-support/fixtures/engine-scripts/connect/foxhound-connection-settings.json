{
  "description": "A Foxhound Client's hello carrying its Connection's own settings (ADR 0083), Foxhound's keys among them in the wire's spelling, accepted by a Foxhound engine; the Client then closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "needs": "foxhound",
          "product_version": "0.0.0",
          "log_level": "off",
          "settings": {
            "timeout": {
              "run": 60000
            },
            "crawl": {
              "max_depth": 3,
              "handler": {
                "concurrency": 2
              }
            }
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    }
  ]
}
