          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off",
          "token": "endpoint-token-canary-5f0e9b27c4d1"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    }
  ]
}
