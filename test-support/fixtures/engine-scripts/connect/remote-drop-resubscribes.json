{
  "description": "A Collie Client reaches the remote Daemon `GOODFETCH_URL` names with `GOODFETCH_TOKEN`'s token, starts a Run, opens a Session and listens to its `page`: the Connection's one Subscription, `events.subscribe` with its credits, is sent first, then `session.on`. The engine publishes the Session's first page, then drops the link with no close. The Client reaches the Daemon again and greets it with the same hello; the same engine instance answers, so the Client resubscribes after the last position it read, with the credits it still had, and sends `session.on` again by its id. The engine publishes the Session's second page on the new link. The program closes the listener, which cancels `session.on`, then the Subscription; the Run finishes and the Client closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off",
          "token": "remote-daemon-token"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_session",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "session_id": "session-2"
        }
      }
    },
    {
      "expect": {
        "method": "events.subscribe",
        "params": {}
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 3,
          "credits": 16
        }
      }
    },
    {
      "expect": {
        "method": "session.on",
        "params": {
          "session_id": "session-2",
          "event": "page"
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/events",
          "params": {
            "id": 3,
            "events": [
              {
                "position": 1,
                "event": "session.page",
                "data": {
                  "page_id": "page-1",
                  "session_id": "session-2"
                }
              }
            ]
          }
        }
      }
    },
    {
      "drop": {}
    },
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off",
          "token": "remote-daemon-token"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "events.subscribe",
        "params": {
          "after": {
            "engine_instance": "0123456789abcdef",
            "position": 1
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 3,
          "credits": 15
        }
      }
    },
    {
      "expect": {
        "method": "session.on",
        "params": {
          "session_id": "session-2",
          "event": "page"
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/events",
          "params": {
            "id": 3,
            "events": [
              {
                "position": 2,
                "event": "session.page",
                "data": {
                  "page_id": "page-2",
                  "session_id": "session-2"
                }
              }
            ]
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 4
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 3
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
