{
  "description": "A Foxhound Client reaches the remote Daemon `GOODFETCH_URL` names with `GOODFETCH_TOKEN`'s token and starts the two-page-type crawl as `nightly`, which the engine answers as a Run that already finished, `ended`, then reads its Dataset `products`. The engine streams the first Record, then drops the link with no close. The Client reaches the Daemon again, greets it with the same hello, and sends `run.records` again by its id, after the last Record it read, with the credits it still had; the engine streams the second Record on the new link and answers the stream. The Run finishes and the Client closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "foxhound",
          "product_version": "0.0.0",
          "log_level": "off",
          "token": "remote-daemon-token"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "crawl.start",
        "params": {
          "labels": {
            "listing": {},
            "product": {}
          },
          "datasets": [
            {
              "name": "products",
              "key": ["id"]
            }
          ],
          "seeds": [
            {
              "url": "https://shop.test/a",
              "label": "listing"
            }
          ],
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "finished",
          "needs": "foxhound",
          "started_as": "ended"
        }
      }
    },
    {
      "expect": {
        "method": "run.records",
        "params": {
          "run_id": "nightly",
          "dataset": "products"
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 64
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/record",
          "params": {
            "id": 2,
            "record": {
              "number": 1,
              "value": {
                "id": "P-0001",
                "name": "Blue kettle",
                "price": "12.34"
              },
              "request_id": "2",
              "url": "https://shop.test/products/P-0001",
              "committed_at": "2026-01-01T00:00:00Z",
              "provenance": {
                "request_id": "2"
              }
            }
          }
        }
      }
    },
    {
      "drop": {}
    },
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "foxhound",
          "product_version": "0.0.0",
          "log_level": "off",
          "token": "remote-daemon-token"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.records",
        "params": {
          "run_id": "nightly",
          "dataset": "products",
          "after": 1
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 63
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/record",
          "params": {
            "id": 2,
            "record": {
              "number": 2,
              "value": {
                "id": "P-0002",
                "name": "Red kettle",
                "price": "23.45"
              },
              "request_id": "2",
              "url": "https://shop.test/products/P-0002",
              "committed_at": "2026-01-01T00:00:00Z",
              "provenance": {
                "request_id": "2"
              }
            }
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "count": 1,
          "last": 2
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 2
          }
        }
      }
    }
  ]
}
