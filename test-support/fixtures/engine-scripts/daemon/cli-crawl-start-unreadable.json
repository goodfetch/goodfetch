{
  "description": "Foxhound's CLI built from this commit runs crawl start on the Daemon: the Daemon cannot read its crawl.start, as it cannot a line past its message limit, so it answers an error whose id is null and keeps the Connection open, answering nothing more; the CLI ends with that error rather than wait for an answer that never comes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "cli",
          "token": "scripted-daemon-token",
          "needs": "foxhound",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "crawl.start",
        "params": {
          "run_id": "first",
          "seeds": [{ "url": "https://example.com/", "label": "page" }],
          "extraction": { "formats": { "markdown": true } }
        }
      }
    },
    {
      "raw": {
        "text": "{\"jsonrpc\":\"2.0\",\"id\":null,\"error\":{\"code\":-32600,\"message\":\"a message is longer than 16777216 bytes\",\"data\":{\"code\":\"message_too_large\",\"retryable\":false}}}\n"
      }
    },
    {
      "stall": {}
    }
  ]
}
