{
  "description": "A Collie Client's hello accepted, then a Run started and a page opened in it. The program's listener of the page's `console` throws on the first message: its call is cancelled, the program's next call on the page raises `listener_failed` and is not sent, and the page stays open, so its close is sent; the Run finishes and the Client closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_page",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "page_id": "page-1",
          "session_id": "session-1"
        }
      }
    },
    {
      "expect": {
        "method": "page.on",
        "params": {
          "page_id": "page-1",
          "event": "console"
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 3,
          "credits": 16
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/events",
          "params": {
            "id": 3,
            "events": [
              {
                "position": 1,
                "event": "page.console",
                "data": {
                  "type": "log",
                  "text": "first",
                  "page_id": "page-1",
                  "location": {
                    "url": "https://20.actionability.test/",
                    "line": 1,
                    "column": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 3
        }
      }
    },
    {
      "expect": {
        "method": "page.close",
        "params": {
          "page_id": "page-1"
        }
      }
    },
    {
      "reply": {
        "result": {}
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
