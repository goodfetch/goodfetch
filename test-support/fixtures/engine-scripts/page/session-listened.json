{
  "description": "A Collie Client's hello accepted, then a Run started and a Session opened in it. The program listens to the Session's `page`: the Connection's one Subscription, `events.subscribe` with its credits, is sent first, then `session.on`; the engine publishes a page of another Session, an event of another kind and a page of this Session, and the listener gets only the last, as a Page whose `evaluate` reaches it. The program closes the listener, which cancels `session.on`, then the Subscription no other listener holds; the Run finishes and the Client closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_session",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "session_id": "session-2"
        }
      }
    },
    {
      "expect": {
        "method": "events.subscribe",
        "params": {}
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 3,
          "credits": 16
        }
      }
    },
    {
      "expect": {
        "method": "session.on",
        "params": {
          "session_id": "session-2",
          "event": "page"
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/events",
          "params": {
            "id": 3,
            "events": [
              {
                "position": 1,
                "event": "session.page",
                "data": {
                  "page_id": "page-9",
                  "session_id": "session-9"
                }
              },
              {
                "position": 2,
                "event": "sample.echoed",
                "data": {
                  "text": "elsewhere"
                }
              },
              {
                "position": 3,
                "event": "session.page",
                "data": {
                  "page_id": "page-2",
                  "session_id": "session-2"
                }
              }
            ]
          }
        }
      }
    },
    {
      "expect": {
        "method": "page.evaluate",
        "params": {
          "page_id": "page-2",
          "function": "() => 1"
        }
      }
    },
    {
      "reply": {
        "result": {
          "value": 1
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 4
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 3
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
