{
  "description": "A Collie Client starts a Run and opens two pages with `run.new_page`, both in the Run's default Session `session-1`, then a Session of its own, `session-2`, and a page in it; each page reaches its Session without a call (ADR 0092). Closing the default Session through the first page's Session closes the second page, whose `goto` raises `closed` without a message, and a later `run.new_page` raises the engine's `closed`; the third page's Session opens a page still. The Run then finishes. The `a-page-reaches-its-session` client conformance case.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_page",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "page_id": "page-1",
          "session_id": "session-1"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_page",
        "params": {
