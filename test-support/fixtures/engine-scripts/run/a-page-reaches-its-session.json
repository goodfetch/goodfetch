        }
      }
    },
    {
      "expect": {
        "method": "session.close",
        "params": {
          "session_id": "session-1"
        }
      }
    },
    {
      "reply": {
        "result": {}
      }
    },
    {
      "expect": {
        "method": "run.new_page",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32001,
          "message": "the Run's default Session session-1 is closed, and a value never reopens",
