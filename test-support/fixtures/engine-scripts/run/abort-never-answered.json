{
  "description": "A Collie Client starts a Run by its Run ID and closes it unfinished, and the engine never answers the Run's abort: once `timeout.close` passes, the Client cancels the abort and ends the Connection.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.abort",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 2
        }
      }
    }
  ]
}
