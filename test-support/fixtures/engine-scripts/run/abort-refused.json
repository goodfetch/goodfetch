{
  "description": "A Collie Client starts a Run by its Run ID and closes it unfinished, and the engine refuses the Run's abort with run_state_unavailable: the Client's close fails with that error, and the Client then closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.abort",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32006,
          "message": "The Run's state cannot be written at its location: the disk is full.",
          "data": {
            "code": "run_state_unavailable",
            "retryable": false,
            "path": "/home/goodfetch/0.0/runs/nightly/run.sqlite"
          }
        }
      }
    }
  ]
}
