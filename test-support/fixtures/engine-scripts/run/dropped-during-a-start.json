{
  "description": "A Collie Client's Daemon accepts its hello, then drops the Connection while a Run starts, before answering.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off",
          "token": "scripted-daemon-token"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "close": {}
    }
  ]
}
