        "method": "crawl.start",
        "params": {
          "labels": {
            "page": {}
          },
          "seeds": [
            {
              "url": "https://shop.test/a",
              "label": "page"
            }
          ],
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "running",
          "needs": "foxhound",
          "started_as": "new"
        }
      }
