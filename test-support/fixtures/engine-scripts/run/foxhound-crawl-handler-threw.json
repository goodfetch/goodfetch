{
  "description": "A Foxhound Client starts a crawl whose handler throws its own TypeError: the handler call is answered `handler_failed`, whose message names the exception's type and message and whose details carry its type, message and stack. Closing the Connection then aborts the Run.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "foxhound",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "crawl.start",
        "params": {
          "labels": {
            "page": {}
          },
          "seeds": [
            {
              "url": "https://shop.test/a",
              "label": "page"
            }
          ],
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "running",
          "needs": "foxhound",
          "started_as": "new"
        }
      }
    },
    {
      "send": {
        "request": {
          "method": "crawl_request.handle",
          "params": {
            "run_id": "nightly",
            "crawl_request": {
              "id": "1",
              "label": "page",
              "method": "GET",
              "url": "https://shop.test/a"
            },
            "attempt": 1,
            "lease_epoch": 1,
            "page_id": "page-1",
            "session": {
              "id": "session-1",
              "proxy_tier": "none",
              "revalidate": false
            },
            "tier": "http"
          }
        }
      }
    },
    {
      "await_reply": {
        "error": {
          "code": -32001,
          "message": "the handler of the Label page failed with TypeError: the price is missing",
          "data": {
            "code": "handler_failed",
            "retryable": true,
            "exception_type": "TypeError",
            "exception_message": "the price is missing",
            "exception_stack": "    at handler (shop.ts:3:11)"
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.abort",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "stopped",
          "verdict": "verified",
          "completeness": "incomplete",
          "stop_reason": {
            "kind": "abort",
            "by": "client"
          },
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 1
          }
        }
      }
    }
  ]
}
