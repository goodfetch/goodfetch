        "params": {
          "run_id": "nightly",
          "crawl_request_id": "1",
          "lease_epoch": 1,
          "dataset": "products",
          "records": [
            {
              "id": "P-0002",
              "name": "Red kettle"
            },
            {
              "name": "Kettle lid"
            },
            {
              "id": "P-0003",
              "name": "Green kettle"
            }
          ]
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32001,
          "message": "Of the 3 Records pushed together, 1 of the Dataset `products` does not hold, so it was not staged: the one at position 1: /id: the key's field `id` is missing",
          "data": {
            "code": "record_invalid",
