        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "crawl.start",
        "params": {
          "labels": {
            "page": {}
          },
          "datasets": [
            {
              "name": "products",
              "key": ["id"]
            }
          ],
          "seeds": [
            {
              "url": "https://shop.test/a",
              "label": "page"
            }
          ],
          "run_id": "nightly"
        }
      }
