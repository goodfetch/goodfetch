{
  "description": "A Foxhound Client starts the two-page-type crawl as `nightly`, which the engine answers as an existing Run that already finished, and reads its Dataset `products`: the engine streams both its Records, then answers `run.finish` with the Run's report, so the Client has received both; the program, which stops reading after the first, cancels the stream.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "needs": "foxhound",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "crawl.start",
        "params": {
          "labels": {
            "listing": {},
            "product": {}
          },
          "datasets": [
            {
              "name": "products",
              "key": ["id"]
            }
          ],
          "seeds": [
            {
              "url": "https://shop.test/a",
              "label": "listing"
            }
          ],
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "finished",
          "needs": "foxhound",
          "started_as": "existing"
        }
      }
    },
    {
      "expect": {
        "method": "run.records",
        "params": {
          "run_id": "nightly",
          "dataset": "products"
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 64
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/record",
          "params": {
            "id": 2,
            "record": {
              "number": 1,
              "value": {
                "id": "P-0001",
                "name": "Blue kettle",
                "price": "12.34"
              },
              "request_id": "2",
              "url": "https://shop.test/products/P-0001",
              "committed_at": "2026-01-01T00:00:00Z",
              "provenance": {
                "request_id": "2"
              }
            }
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/record",
          "params": {
            "id": 2,
            "record": {
              "number": 2,
              "value": {
                "id": "P-0002",
                "name": "Red kettle",
                "price": "23.45"
              },
              "request_id": "2",
              "url": "https://shop.test/products/P-0002",
              "committed_at": "2026-01-01T00:00:00Z",
              "provenance": {
                "request_id": "2"
              }
            }
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 2
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 2
        }
      }
    }
  ]
}
