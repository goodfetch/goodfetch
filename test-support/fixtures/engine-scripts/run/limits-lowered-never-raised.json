            "requests": 0
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "nightly",
          "limits": [
            {
              "usage_kind": "requests",
              "amount": 8
            }
          ]
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32002,
          "message": "The Run's Limit on requests stands at 5, and a start may only lower it: 8 would raise it.",
          "data": {
            "code": "limit_raise_refused",
            "retryable": false,
            "usage_kind": "requests",
            "given": 8,
            "standing": 5,
            "fix": "Give the Run's Limit at 5 or lower, or ask a person to raise it with `usage.raise`."
          }
        }
      }
