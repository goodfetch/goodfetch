{
  "description": "A Collie Client connects with Limits in code (ADR 0080): each is sent after hello as a `usage.set` on its Client connection, a count as is and a price in millionths of its currency; it then starts a Run with Limits of its own, sent in `run.start`'s `limits`, and finishes it.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "usage.set",
        "params": {
          "scope": "connection",
          "usage_kind": "model_calls",
          "amount": 100
        }
      }
    },
    {
      "reply": {
        "result": {
          "limit": {
            "scope": {
              "kind": "connection",
              "id": "0123456789abcdef-1"
            },
            "usage_kind": "model_calls",
            "amount": 100,
            "must_understand": false,
            "set_by": "client"
          },
          "standing": "held",
          "charged": 0,
          "held": 0,
          "left": 100
        }
      }
    },
    {
      "expect": {
        "method": "usage.set",
        "params": {
          "scope": "connection",
          "usage_kind": "paid_solves",
          "amount": 2500000,
          "currency": "USD"
        }
      }
    },
    {
      "reply": {
        "result": {
          "limit": {
            "scope": {
              "kind": "connection",
              "id": "0123456789abcdef-1"
            },
            "usage_kind": "paid_solves",
            "amount": 2500000,
            "must_understand": true,
            "set_by": "client",
            "currency": "USD"
          },
          "standing": "held",
          "charged": 0,
          "held": 0,
          "left": 2500000
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "capped",
          "limits": [
            {
              "usage_kind": "browser_time",
              "amount": 60000
            },
            {
              "usage_kind": "proxy_bytes",
              "currency": "EUR",
              "amount": 1
            }
          ]
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "capped",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "capped"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "capped",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
