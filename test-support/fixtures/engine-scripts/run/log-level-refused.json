{
  "description": "A Collie Client whose logger changed from `debug` to `warn` before a start tells the engine with `connection.set_log_level`; the engine refuses it, and the start goes on (the engine's logs are telemetry, ADR 0078). The next start tells the engine again, which takes it.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "debug"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "connection.set_log_level",
        "params": {
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32602,
          "message": "The log level `warn` is refused.",
          "data": {
            "code": "invalid_params",
            "retryable": false
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "first"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "first",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "first"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "first",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    },
    {
      "expect": {
        "method": "connection.set_log_level",
        "params": {
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {}
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "second"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "second",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "second"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "second",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
