{
  "description": "A Collie Client starts a Run, then sets values that are not JSON (`NaN`, a `Map`, a `bigint`): each fails in the SDK before anything is sent (ADR 0082), so the engine reads no `key_value_store.set`; a value whose keys include `__proto__` is sent with its keys as given. The Run then finishes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "needs": "collie",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "strict"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "strict",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "key_value_store.set",
        "params": {
          "run_id": "strict",
          "key": "user-data",
          "value": {
            "__proto__": {
              "polluted": true
            },
            "constructor": "kept"
          }
        }
      }
    },
    {
      "reply": {
        "result": {}
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "strict"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "strict",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
