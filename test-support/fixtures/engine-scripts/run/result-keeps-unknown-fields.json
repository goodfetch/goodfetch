{
  "description": "A Collie Client starts a Run and finishes it, and the engine answers each with a field the SDK does not know, as a newer engine would (ADR 0082, G3): the SDK hands both results to the program with the field kept.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "needs": "collie",
          "product_version": "0.0.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "newer"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "newer",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new",
          "queued_behind": 2
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "newer"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "newer",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          },
          "carbon": {
            "grams": 1.5
          }
        }
      }
    }
  ]
}
