{
  "description": "A Collie Client starts the interrupted Run `nightly` with every start option, its own settings, a timeout of an hour, a Plan file, a Response recording and a Plugin change it accepts, which resumes it, and closes it unfinished; starts the finished Run `done` with no timeout, sent as `null`, which returns it ended, so closing it sends nothing; refuses a zero timeout before sending anything; and gives up a start of `slow` once it is sent, which reaches the engine as one `$/cancel` naming it, answered with `call_cancelled` (ADRs 0033, 0080, 0091, 0102 and 0105). The `start-takes-every-option` client conformance case.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "nightly",
          "settings": {
            "timeout": {
              "wait": 5000
            }
          },
          "timeout": 3600000,
          "plan": "plans/nightly.json",
          "recording": {
            "mode": "replay",
            "path": "recordings/nightly.warc"
          },
          "accept_plugin_change": ["shop-prices"]
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "resumed"
        }
      }
    },
    {
      "expect": {
        "method": "run.abort",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "stopped",
          "verdict": "verified",
          "completeness": "incomplete",
          "stop_reason": {
            "kind": "abort",
            "by": "client"
          },
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "done",
          "timeout": null
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "done",
          "lifecycle": "finished",
          "needs": "collie",
          "started_as": "ended"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "slow"
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 4
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32006,
          "message": "The call was cancelled by its Client.",
          "data": {
            "code": "call_cancelled",
            "retryable": false,
            "by": "client"
          }
        }
      }
    }
  ]
}
