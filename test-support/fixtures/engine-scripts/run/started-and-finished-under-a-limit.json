{
  "description": "A Collie Client connects under a Connection Limit of 5 model calls, which it sets before anything else, then a Run started with a generated Run ID and finished, answering its Run report; the Client then closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "usage.set",
        "params": {
          "scope": "connection",
          "usage_kind": "model_calls",
          "amount": 5
        }
      }
    },
    {
      "reply": {
        "result": {
          "limit": {
            "scope": {
              "kind": "connection",
              "id": "0123456789abcdef-1"
            },
            "usage_kind": "model_calls",
            "amount": 5,
            "must_understand": false,
            "set_by": "client"
          },
          "standing": "held",
          "charged": 0,
          "held": 0,
          "left": 5
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
