{
  "description": "A Collie Client starts a Run, then sets a value under a schema whose own validation raises something other than a rejection: the call fails in the SDK with `schema_validator_failed` before anything is sent (ADR 0082), so the engine reads no `key_value_store.set`; a typed read of a stored value under that schema reads it once, then fails the same way. The Run then finishes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "buggy"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "buggy",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "key_value_store.get",
        "params": {
          "run_id": "buggy",
          "key": "book"
        }
      }
    },
    {
      "reply": {
        "result": {
          "value": {
            "title": "Dune",
            "year": "1965"
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "buggy"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "buggy",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
