{
  "description": "A Collie Client's hello answered by an engine that speaks another protocol major, which the Client refuses itself.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "1.0",
          "product": "collie",
          "product_version": "1.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    }
  ]
}
