{
  "description": "After an accepted hello, the engine answers a Run's start with a line that is not JSON-RPC on stdout, then waits for the Client to close.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "raw": {
        "text": "INFO engine started\n"
      }
    },
    {
      "stall": {}
    }
  ]
}
