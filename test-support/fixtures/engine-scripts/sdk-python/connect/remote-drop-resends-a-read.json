{
  "description": "A Collie Client reaches the remote Daemon `GOODFETCH_URL` names with `GOODFETCH_TOKEN`'s token and starts a Run; the program then opens a page, an Effect, and lists the Runs with the raw call, a read, and the engine drops the link with no close while both are in flight. The Client reaches the Daemon again, greets it with the same hello, and sends the read again by its id, which the engine answers; the Effect is never sent again, since whether it took effect is unknown. The Run finishes and the Client closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "form": "python",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "warn",
          "token": "remote-daemon-token"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_page",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "expect": {
        "method": "run.list",
        "params": {
          "_meta": {
            "raw": true
          }
        }
      }
    },
    {
      "drop": {}
    },
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "form": "python",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "warn",
          "token": "remote-daemon-token"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.list",
        "params": {
          "_meta": {
            "raw": true
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "runs": []
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
