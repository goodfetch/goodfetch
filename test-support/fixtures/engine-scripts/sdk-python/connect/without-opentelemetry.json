  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python",
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "config.explain",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "files": [],
          "settings": []
        }
      }
    }
  ]
}
