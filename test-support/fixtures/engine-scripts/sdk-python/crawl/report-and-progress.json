            "pending": 0,
            "by_skip_reason": [{ "name": "max_requests", "count": 1 }]
          },
          "records": [{ "dataset": "products", "committed": 1, "dropped": 0, "rejected": 0 }],
          "learned_rules": []
        }
      }
    },
    {
      "expect": {
