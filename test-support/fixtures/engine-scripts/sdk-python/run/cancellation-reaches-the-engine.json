        }
      }
    },
    {
      "reply": {
        "result": {
          "page_id": "page-1",
          "session_id": "session-1"
        }
      }
    },
    {
      "expect": {
        "method": "locator.click",
        "params": {
          "locator": {
            "page_id": "page-1",
            "selector": "#buy"
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 3
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32006,
          "message": "The call was cancelled by its Client.",
          "data": {
            "code": "call_cancelled",
            "retryable": false,
            "by": "client"
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "timeout": 60000
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 4
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32006,
          "message": "The call was cancelled by its Client.",
          "data": {
            "code": "call_cancelled",
            "retryable": false,
            "by": "client"
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "timeout": 2
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32005,
          "message": "The call's deadline passed before the Run finished.",
          "data": {
            "code": "deadline_exceeded",
            "retryable": true
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
