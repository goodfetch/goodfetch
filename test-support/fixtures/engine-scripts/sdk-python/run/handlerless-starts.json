            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    },
    {
      "expect": {
        "method": "catalog_run.start",
        "params": {
          "target": {
            "kind": "extract",
            "url": "https://shop.example/products",
            "schema": {
              "type": "object",
              "properties": {
                "productName": { "type": "string" }
              }
            }
          },
          "run_id": "extract-products"
        }
      }
    },
    {
      "reply": {
        "result": {
