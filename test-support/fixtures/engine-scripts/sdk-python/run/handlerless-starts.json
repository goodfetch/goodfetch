{
  "description": "A Python Client of the Attached engine starts the Recipe `shop-prices` with every start option but `detached`, under a fresh Run ID, which begins it, and closes it unfinished, which aborts it since it is not detached; starts it again, which resumes it, and finishes it; then starts an Extraction under the Run ID `extract-products`, which finds it ended (ADRs 0036 and 0102). Opening a view of a Run by its Run ID sends nothing, so the script expects no message for it. TypeScript's `run/handlerless-starts.json` is its twin.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python",
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "recipe.start",
        "params": {
          "recipe": "shop-prices",
          "run_id": "nightly-prices",
          "tags": ["nightly", "prices"],
          "limits": [
            {
              "usage_kind": "requests",
              "amount": 500
            }
          ],
          "settings": {
            "timeout": {
              "wait": 5000
            }
          },
          "recording": {
            "mode": "replay",
            "path": "recordings/shop.warc"
          },
          "timeout": 3600000
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly-prices",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.abort",
        "params": {
          "run_id": "nightly-prices"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly-prices",
          "lifecycle": "stopped",
          "verdict": "verified",
          "completeness": "incomplete",
          "stop_reason": {
            "kind": "abort",
            "by": "client"
          },
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    },
    {
      "expect": {
        "method": "recipe.start",
        "params": {
          "recipe": "shop-prices",
          "run_id": "nightly-prices"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly-prices",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "resumed"
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "nightly-prices"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly-prices",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
