{
  "description": "A Collie Client's hello accepted, then a Run started. The program reads the Run's Key-value store's keys under `item-` to their end: the call is sent when `keys` is called and granted 16 credits; the engine sends eight keys, and once the program has read them it grants 8 more; the engine then answers how many it sent. The Run finishes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python",
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "key_value_store.keys",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "prefix": "item-"
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 16
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-1"
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-2"
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-3"
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-4"
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-5"
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-6"
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-7"
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-8"
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 8
        }
      }
    },
    {
      "reply": {
        "result": {
          "count": 8
        }
      }
    },
    {
      "expect": {
