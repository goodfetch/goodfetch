{
  "description": "A Collie Client's hello accepted, then a Run started. The program reads the first of the Run's Key-value store's keys under `item-`, then stops reading, by `break`, `aclose()`, `close()` or releasing the iterator: the call is cancelled before the Run's next call, and the engine sends nothing more for it. The Run finishes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python",
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "key_value_store.keys",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "prefix": "item-"
        }
      }
    },
    {
      "expect": {
        "method": "$/credit",
        "params": {
          "id": 2,
          "credits": 16
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-1"
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/key",
          "params": {
            "id": 2,
            "key": "item-2"
          }
        }
      }
    },
    {
      "expect": {
        "method": "$/cancel",
        "params": {
          "id": 2
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
