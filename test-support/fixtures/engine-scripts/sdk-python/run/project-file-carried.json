{
  "description": "A Python Collie Client explains `timeout.navigation`, then starts and finishes a Run, carrying on `config.explain` and `run.start` the project file it read, which sets `timeout.navigation` to 45000; the explanation answers it from `project_configuration` (ADR 0083; story 11-75). A test replaces `/work/goodfetch.toml` with the path of the file its Client read.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python",
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "config.explain",
        "params": {
          "keys": ["timeout.navigation"],
          "project": {
            "path": "/work/goodfetch.toml",
            "settings": { "timeout": { "navigation": 45000 } }
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "files": [],
          "settings": [
            {
              "key": "timeout.navigation",
              "value": 45000,
              "layer": "project_configuration",
              "applied": true,
              "products": ["collie", "foxhound"],
              "weakens": false
            }
          ]
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "project": {
            "path": "/work/goodfetch.toml",
            "settings": { "timeout": { "navigation": 45000 } }
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
