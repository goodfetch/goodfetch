{
  "description": "A Collie Client's hello accepted by a Foxhound engine, then raw calls (ADR 0099), each marked raw in its `_meta`: `run.list` on the Connection, its params and result unchanged; a Run started, and on it Foxhound's `run.failed_requests`, its Run ID filled in, and again on the Connection, the Run named in its params sending its ID; `run.finish` with a `timeout` of 2 ms failing `deadline_exceeded`, never sent again; a page opened, `page.reload` on it and `locator.click` on one of its locators, each filled with its value's ID; then the Run closed. A call in another namespace, on a closed value or with a `_meta` of its own, is never sent. The `raw-call` client conformance case.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python",
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.list",
        "params": {
          "_meta": { "raw": true },
          "lifecycle": "running",
          "tags": ["nightly"]
        }
      }
    },
    {
      "reply": {
        "result": {
          "runs": [
            {
              "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
              "location": "/runs/01ke6p4ym0j8x3v5wq2rtbn7hc",
              "kind": "crawl",
              "needs": "foxhound",
              "tags": ["nightly"],
              "lifecycle": "running",
              "started_at": "2026-11-19T12:30:00Z",
              "presence": "present",
              "replayed": false
            }
          ]
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.failed_requests",
        "params": {
          "_meta": { "raw": true },
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "blocked": true
        }
      }
    },
    {
      "reply": {
        "result": {
          "requests": []
        }
      }
    },
    {
      "expect": {
        "method": "run.failed_requests",
        "params": {
          "_meta": { "raw": true },
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "blocked": false
        }
      }
    },
    {
      "reply": {
        "result": {
          "requests": []
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "_meta": { "raw": true },
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "timeout": 2
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32005,
          "message": "The call's deadline passed before the Run finished.",
          "data": {
            "code": "deadline_exceeded",
            "retryable": true
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.new_page",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "page_id": "page-1",
          "session_id": "session-1"
        }
      }
    },
    {
      "expect": {
        "method": "page.reload",
        "params": {
          "_meta": { "raw": true },
          "page_id": "page-1"
        }
      }
    },
    {
      "reply": {
        "result": {
          "response": null
        }
      }
    },
    {
      "expect": {
        "method": "locator.click",
        "params": {
          "_meta": { "raw": true },
          "locator": {
            "page_id": "page-1",
            "selector": "#consent"
          }
        }
      }
    },
    {
      "reply": {
        "result": {}
      }
    },
    {
      "expect": {
        "method": "run.abort",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "stopped",
          "verdict": "verified",
          "completeness": "incomplete",
          "stop_reason": {
