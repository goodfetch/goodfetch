{
  "description": "A Collie Client starts a Run and opens a Session from the Saved identity `shop` under its own Access mode, then a fresh one with `source: null`, and a page in each; it closes the first Session, whose page and Session then refuse their calls without a message, while the second Session and the Run's default Session open pages still; a Session whose `cdp_url` source names `www.example.com` in `domains` is refused with `setting_invalid` whose `fix` names `example.com` (ADRs 0092 and 0056); the Run then finishes. The `sessions-open-from-their-source` client conformance case.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python",
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_session",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "source": {
            "kind": "saved_identity",
            "name": "shop"
          },
          "settings": {
            "browser": {
              "access_mode": "standard"
            }
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "session_id": "session-2"
        }
      }
    },
    {
      "expect": {
        "method": "session.new_page",
        "params": {
          "session_id": "session-2"
        }
      }
    },
    {
      "reply": {
        "result": {
          "page_id": "page-2",
          "session_id": "session-2"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_session",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "source": null
        }
      }
    },
    {
      "reply": {
        "result": {
          "session_id": "session-3"
        }
      }
    },
    {
      "expect": {
        "method": "session.new_page",
        "params": {
          "session_id": "session-3"
        }
      }
    },
    {
      "reply": {
        "result": {
          "page_id": "page-3",
          "session_id": "session-3"
        }
      }
    },
    {
      "expect": {
        "method": "session.close",
        "params": {
          "session_id": "session-2"
        }
      }
    },
    {
      "reply": {
        "result": {}
      }
    },
    {
      "expect": {
        "method": "session.new_page",
        "params": {
          "session_id": "session-3"
        }
      }
    },
    {
      "reply": {
        "result": {
          "page_id": "page-4",
          "session_id": "session-3"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_page",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "page_id": "page-5",
          "session_id": "session-1"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_session",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "source": {
            "kind": "cdp_url",
            "url": "http://127.0.0.1:9222",
            "domains": ["www.example.com"]
          }
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32001,
          "message": "`session.source` is not valid in run: `www.example.com` in `domains` is no registrable domain, whose is `example.com`",
          "data": {
            "code": "setting_invalid",
            "retryable": false,
            "key": "session.source",
            "layer": "run",
            "reason": "`www.example.com` in `domains` is no registrable domain, whose is `example.com`",
            "fix": "Give `example.com` in `domains`"
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
