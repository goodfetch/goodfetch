{
  "description": "A Collie Client starts a Run, opens a Session in it and a page in the Session, each with its own settings, nested by segment, a duration in whole milliseconds and a cleared setting as null; the Connection's close aborts the Run, and the Client then closes.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python",
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "settings": {
            "timeout": {
              "navigation": 30000
            },
            "checkpoint": {
              "interval": null
            }
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_session",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "settings": {
            "browser": {
              "access_mode": "stealth"
            }
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "session_id": "session-2"
        }
      }
    },
    {
      "expect": {
        "method": "session.new_page",
        "params": {
          "session_id": "session-2",
          "settings": {
            "content": {
              "extractor": "trafilatura"
            }
          }
        }
      }
    },
    {
      "reply": {
        "result": {
          "page_id": "page-2",
          "session_id": "session-2"
        }
      }
    },
    {
      "expect": {
        "method": "run.abort",
        "params": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "stopped",
          "verdict": "verified",
          "completeness": "incomplete",
          "stop_reason": {
            "kind": "abort",
            "by": "client"
          },
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
