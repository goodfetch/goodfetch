{
  "description": "A Client starts the Run `nightly` with two tags under a fresh Run ID, which begins it, and closes it unfinished; starts it again, which resumes it, and finishes it; starts it a third time, which finds it ended, and asks it for a page, refused with `run_ended`; then each start the engine refuses: `run_in_use`, `run_conflict` listing each difference, `run_id_invalid` and `limit_reached` naming when the Limit resets (ADR 0102). `run.id()` sends nothing, so the script expects no message for it.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_python",
          "needs": "collie",
          "product_version": "0.0.0",
          "form": "python",
          "log_level": "warn"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "nightly",
          "tags": ["shop", "eu"]
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.abort",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "stopped",
          "verdict": "verified",
          "completeness": "incomplete",
          "stop_reason": {
            "kind": "abort",
            "by": "client"
          },
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "resumed"
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "nightly",
          "lifecycle": "finished",
          "needs": "collie",
          "started_as": "ended"
        }
      }
    },
    {
      "expect": {
        "method": "run.new_page",
        "params": {
          "run_id": "nightly"
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32001,
          "message": "The Run `nightly` ended `finished` and takes no new work: start a Run under a new Run ID.",
          "data": {
            "code": "run_ended",
            "retryable": false,
            "run_id": "nightly"
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "busy"
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32002,
          "message": "Another engine holds the writer lock of the Run `busy`.",
          "data": {
            "code": "run_in_use",
            "retryable": true,
            "run_id": "busy"
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "crawled"
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32001,
          "message": "The Run `crawled` was started with other inputs: product, kind, caller, seeds.",
          "data": {
            "code": "run_conflict",
            "retryable": false,
            "run_id": "crawled",
            "differences": ["product", "kind", "caller", "seeds"],
            "fix": "Start under another Run ID."
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "capped"
        }
      }
    },
    {
      "reply": {
        "error": {
          "code": -32002,
          "message": "The run Limit on requests has nothing left until 2026-02-01T00:00:00Z.",
          "data": {
            "code": "limit_reached",
            "retryable": false,
            "scope": {
              "kind": "run",
              "id": "capped"
            },
            "usage_kind": "requests",
            "resets_at": "2026-02-01T00:00:00Z",
            "fix": "Wait for the next period, or ask a person to raise the Limit in the Console."
          }
        }
      }
    }
  ]
}
