{
  "description": "A Rust program with no `tracing` subscriber sends `off` in `hello` (ADR 0078); the engine still sends an error and a warning as `$/log` events, as ones in flight when the level changed would arrive, before the reply to the program's `run.start`, so the program has read both when its Run starts, and the SDK writes them nowhere.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "needs": "collie",
          "product_version": "0.0.0",
          "log_level": "off"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/log",
          "params": {
            "level": "error",
            "target": "goodfetch::rpc::dispatch",
            "message": "A call failed."
          }
        }
      }
    },
    {
      "send": {
        "notification": {
          "method": "$/log",
          "params": {
            "level": "warn",
            "target": "goodfetch::page",
            "message": "A page was slow.",
            "dropped": 2
          }
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {
          "run_id": "first"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "first",
          "lifecycle": "running",
          "needs": "collie",
          "started_as": "new"
        }
      }
    },
    {
      "expect": {
        "method": "run.finish",
        "params": {
          "run_id": "first"
        }
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "first",
          "lifecycle": "finished",
          "verdict": "verified",
          "completeness": "complete",
          "started_at": "2026-01-01T00:00:00Z",
          "ended_at": "2026-01-01T00:00:00Z",
          "usage": {
            "model": {
              "calls": 0,
              "tokens": 0,
              "input_tokens": 0,
              "cache_read_tokens": 0,
              "cache_write_tokens": 0,
              "output_tokens": 0,
              "reasoning_tokens": 0,
              "price": null
            },
            "browser_time": 0,
            "proxy_bytes": 0,
            "requests": 0
          }
        }
      }
    }
  ]
}
