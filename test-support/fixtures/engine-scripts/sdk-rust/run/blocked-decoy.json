{
  "description": "A Foxhound Client's hello, which the test puts in place of this one, accepted by the Daemon of its home, a Foxhound; a Run started and a page opened in it; the navigation fails with `blocked`, its cause Foxhound's `decoy` (ADR 0095): a trap page a person would never reach, which only Foxhound's Frontier produces. The Client then closes, which aborts the Run it left open.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "foxhound",
          "product_version": "0.0.0",
          "log_level": "off",
          "token": "scripted-daemon-token"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "foxhound",
          "product_version": "0.0.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "run.start",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "run_id": "01ke6p4ym0j8x3v5wq2rtbn7hc",
          "lifecycle": "running",
          "needs": "foxhound",
          "started_as": "new"
        }
