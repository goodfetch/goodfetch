{
  "description": "A Collie Client's hello accepted, then one call answered.",
  "steps": [
    {
      "expect": {
        "method": "hello",
        "params": {
          "protocol_version": "0.1",
          "surface": "sdk_typescript",
          "form": "typescript",
          "needs": "collie",
          "product_version": "0.1.0"
        }
      }
    },
    {
      "reply": {
        "result": {
          "protocol_version": "0.1",
          "product": "collie",
          "product_version": "0.1.0",
          "engine_instance": "0123456789abcdef"
        }
      }
    },
    {
      "expect": {
        "method": "engine.info",
        "params": {}
      }
    },
    {
      "reply": {
        "result": {
          "product": "collie",
          "product_version": "0.1.0",
          "protocol_version": "0.1",
          "product_major": 0
        }
      }
    }
  ]
}
