{
  "$defs": {
    "BodyFraming": {
      "description": "How an endless body is framed.",
      "oneOf": [
        {
          "const": "chunked",
          "description": "Chunks that never end with the last chunk.",
          "type": "string"
        },
        {
          "const": "close_delimited",
          "description": "No length: the body ends only when the connection closes.",
          "type": "string"
        }
      ]
    },
    "ExpectedError": {
      "description": "The typed error a case expects, by its Error code.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`header_value_invalid`: a header value Goodfetch would send holds a\nCR, an LF or a NUL.",
          "properties": {
            "code": {
              "const": "header_value_invalid",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`secret_domain_not_allowed`: a request carrying a Secret placeholder's\nvalue was redirected outside the binding's domains (ADR 0092).",
          "properties": {
            "code": {
              "const": "secret_domain_not_allowed",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`path_unsafe`: a name or path from outside input would leave the\nfolder Goodfetch writes it in, or is no safe file name on some OS.",
          "properties": {
            "code": {
              "const": "path_unsafe",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`schema_ref_not_allowed`: a JSON Schema references a file, a URL or a\nprivate address.",
          "properties": {
            "code": {
              "const": "schema_ref_not_allowed",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`response_limit_exceeded`, naming the setting whose limit was passed.",
          "properties": {
            "code": {
              "const": "response_limit_exceeded",
              "type": "string"
            },
            "setting": {
              "$ref": "#/$defs/LimitSetting",
              "description": "The setting."
            }
          },
          "required": [
            "code",
            "setting"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`message_too_large`: a JSON-RPC message longer than the engine reads.",
          "properties": {
            "code": {
              "const": "message_too_large",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`message_too_deep`: a JSON-RPC message nested deeper than the engine\nreads.",
          "properties": {
            "code": {
              "const": "message_too_deep",
              "type": "string"
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`navigation_failed`, with the browser's network error where the\nbrowser path gives one (ADR 0085).",
          "properties": {
            "code": {
              "const": "navigation_failed",
              "type": "string"
            },
            "network_error": {
              "description": "The browser's network error, such as\n`net::ERR_INVALID_HTTP_RESPONSE`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "code"
          ],
          "type": "object"
        }
      ]
    },
    "HostileCase": {
      "additionalProperties": false,
      "description": "One hostile-input case: the input a layer meets, the typed error it must\ngive, and what serves the input end to end.",
      "properties": {
        "expected": {
          "$ref": "#/$defs/ExpectedError",
          "description": "The typed error every layer gives. A case without one fails the\ntable's parse."
        },
        "input": {
          "$ref": "#/$defs/ResourceLimit",
          "description": "The hostile input, of the family's own shape."
        },
        "name": {
          "description": "The case's name, unique in its table, in snake case.",
          "type": "string"
        },
        "served_by": {
          "$ref": "#/$defs/ServedBy",
          "description": "What serves the input end to end."
        }
      },
      "required": [
        "name",
        "input",
        "expected",
        "served_by"
      ],
      "type": "object"
    },
    "JsonChannel": {
      "description": "Where JSON the engine parses arrives.",
      "oneOf": [
        {
          "const": "response_json",
          "description": "A response body the engine parses as JSON, a discovered API's\nincluded.",
          "type": "string"
        },
        {
          "const": "json_rpc_message",
          "description": "A JSON-RPC message from a Client or a handler.",
          "type": "string"
        }
      ]
    },
    "LimitSetting": {
      "description": "A setting whose limit a `response_limit_exceeded` names.",
      "oneOf": [
        {
          "const": "network.max_body_size",
          "description": "The decoded bytes of a body the engine reads.",
          "type": "string"
        },
        {
          "const": "network.max_decompression_ratio",
          "description": "The ratio of decoded to received bytes, once a decoded body passes\n1 MiB.",
          "type": "string"
        },
        {
          "const": "network.max_json_depth",
          "description": "The nesting of JSON the engine parses from outside.",
          "type": "string"
        }
      ]
    },
    "MessageChannel": {
      "description": "Where an oversized message arrives.",
      "oneOf": [
        {
          "const": "json_rpc_message",
          "description": "A JSON-RPC message from a Client or a handler.",
          "type": "string"
        },
        {
          "const": "response_head",
          "description": "A page's response head.",
          "type": "string"
        }
      ]
    },
    "ResourceLimit": {
      "description": "The input of a `limits` case: input past one of the engine's limits.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A response body that decodes to far more than it sends.",
          "properties": {
            "content_encodings": {
              "description": "Its `Content-Encoding` codings, in the order they were applied.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "decompression_bomb",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "content_encodings"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A response body that decodes to more than the engine reads, within\nthe decompression ratio when it is coded.",
          "properties": {
            "bytes": {
              "description": "Its length once decoded.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "content_encodings": {
              "description": "Its `Content-Encoding` codings, in the order they were applied;\nnone when it is sent uncoded.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "oversized_body",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A response body that never ends.",
          "properties": {
            "framing": {
              "$ref": "#/$defs/BodyFraming",
              "description": "How the body is framed."
            },
            "kind": {
              "const": "endless_body",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "framing"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "JSON nested deeper than the engine reads.",
          "properties": {
            "channel": {
              "$ref": "#/$defs/JsonChannel",
              "description": "Where the JSON arrives."
            },
            "depth": {
              "description": "Its nesting of arrays and objects.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "deep_nesting",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "channel",
            "depth"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A message longer than the engine reads.",
          "properties": {
            "bytes": {
              "description": "Its length.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "channel": {
              "$ref": "#/$defs/MessageChannel",
              "description": "Where the message arrives."
            },
            "kind": {
              "const": "oversized_message",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "channel",
            "bytes"
          ],
          "type": "object"
        }
      ]
    },
    "ServedBy": {
      "description": "What serves a case's input end to end.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The Proving ground's task whose page serves it, by its ID, such as\n`headers/5`.",
          "properties": {
            "page": {
              "type": "string"
            }
          },
          "required": [
            "page"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A page the owner builds, described, such as a decompression bomb's:\nuntil it exists the case runs in-process only.",
          "properties": {
            "waiting_on_owner": {
              "type": "string"
            }
          },
          "required": [
            "waiting_on_owner"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A page the Proving ground does not have yet, described, which a later\nticket adds: until then the case runs in-process only.",
          "properties": {
            "missing_page": {
              "type": "string"
            }
          },
          "required": [
            "missing_page"
          ],
          "type": "object"
        },
        {
          "const": "program_input",
          "description": "No page: the program, a Recipe, a setting or a peer hands the value to\nGoodfetch, so a layer's end-to-end runner passes it in itself.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One family's table: every case, in the committed file's order.",
  "properties": {
    "cases": {
      "description": "The cases.",
      "items": {
        "$ref": "#/$defs/HostileCase"
      },
      "type": "array"
    }
  },
  "required": [
    "cases"
  ],
  "title": "HostileTable",
  "type": "object"
}
