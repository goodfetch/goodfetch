{
  "values": [
    {
      "value": "folder",
      "replacement": "[FOLDER]"
    },
    {
      "value": "product_version",
      "replacement": "[PRODUCT_VERSION]"
    },
    {
      "value": "commit",
      "replacement": "[COMMIT]"
    }
  ],
  "patterns": [
    {
      "name": "systemd_or_logon_task_service_name",
      "pattern": "\\bgoodfetch-daemon-[0-9]+(?:\\.[0-9]+)?-[0-9a-f]{8}\\b",
      "replacement": "[SERVICE_NAME]"
    },
    {
      "name": "launch_agent_label",
      "pattern": "\\bdev\\.goodfetch\\.daemon\\.[0-9]+(?:\\.[0-9]+)?\\.[0-9a-f]{8}\\b",
      "replacement": "[SERVICE_NAME]"
    },
    {
      "name": "service_socket_folder",
      "pattern": "/tmp/goodfetch-daemon-[0-9a-f]{16}\\b",
      "replacement": "[SOCKET_FOLDER]"
    },
    {
      "name": "systemd_user_units",
      "pattern": "(?:/[A-Za-z0-9._-]+)+/systemd/user/",
      "replacement": "[USER_UNITS]/"
    },
    {
      "name": "launch_agents",
      "pattern": "(?:/[A-Za-z0-9._-]+)*/Library/LaunchAgents/",
      "replacement": "[LAUNCH_AGENTS]/"
    },
    {
      "name": "ulid",
      "pattern": "\\b[0-7][0-9A-HJKMNP-TV-Za-hjkmnp-tv-z]{25}\\b",
      "replacement": "[ULID]"
    },
    {
      "name": "instant",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt ][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})",
      "replacement": "[INSTANT]"
    },
    {
      "name": "iso_duration",
      "pattern": "\\bP(?:(?:[0-9]+[YMWD])+(?:T(?:[0-9]+(?:\\.[0-9]+)?[HMS])+)?|T(?:[0-9]+(?:\\.[0-9]+)?[HMS])+)\\b",
      "replacement": "[DURATION]"
    },
    {
      "name": "loopback_ipv4_port",
      "pattern": "\\b127\\.0\\.0\\.1:[0-9]+\\b",
      "replacement": "127.0.0.1:[PORT]"
    },
    {
      "name": "loopback_alias_port",
      "pattern": "\\b127\\.0\\.0\\.[0-9]{1,3}:[0-9]+\\b",
      "replacement": "127.0.0.[N]:[PORT]"
    },
    {
      "name": "loopback_ipv6_port",
      "pattern": "\\[::1\\]:[0-9]+\\b",
      "replacement": "[::1]:[PORT]"
    },
    {
      "name": "localhost_port",
      "pattern": "\\blocalhost:[0-9]+\\b",
      "replacement": "localhost:[PORT]"
    },
    {
      "name": "duration",
      "pattern": "\\b[0-9]+(?:\\.[0-9]+)?(?:ns|µs|us|ms|s|m|h)\\b",
      "replacement": "[DURATION]"
    }
  ]
}
