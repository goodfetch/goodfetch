 use crate::proxy::{Intercepted, Matcher as ProxyMatcher};
 use sealed::{Conn, Unnameable};
 
-pub(crate) type HttpConnector = hyper_util::client::legacy::connect::HttpConnector<DynResolver>;
+/// The service a client opens its TCP connections through when
+/// `ClientBuilder::tcp_connector` gave one.
+pub(crate) type TcpConnector = BoxCloneSyncService<Uri, tokio::net::TcpStream, BoxError>;
+
+/// hyper-util's HTTP connector, which opens the client's TCP connections,
+/// or, when a [`TcpConnector`] is set, that connector, with the client's
+/// `tcp_nodelay` applied to the stream it opens. Its settings reach
+/// hyper-util's connector, which a [`TcpConnector`] does not read.
+#[derive(Clone)]
+pub(crate) struct HttpConnector {
+    inner: hyper_util::client::legacy::connect::HttpConnector<DynResolver>,
+    tcp: Option<TcpConnector>,
+    nodelay: bool,
+}
+
+impl HttpConnector {
+    pub(crate) fn new_with_resolver(resolver: DynResolver) -> Self {
+        Self {
+            inner: hyper_util::client::legacy::connect::HttpConnector::new_with_resolver(resolver),
+            tcp: None,
+            nodelay: false,
+        }
+    }
+
+    pub(crate) fn set_tcp_connector(&mut self, tcp: TcpConnector) {
+        self.tcp = Some(tcp);
+    }
+
+    pub(crate) fn set_nodelay(&mut self, nodelay: bool) {
+        self.nodelay = nodelay;
+        self.inner.set_nodelay(nodelay);
+    }
+}
+
+impl std::ops::Deref for HttpConnector {
+    type Target = hyper_util::client::legacy::connect::HttpConnector<DynResolver>;
+
+    fn deref(&self) -> &Self::Target {
+        &self.inner
+    }
+}
+
+impl std::ops::DerefMut for HttpConnector {
+    fn deref_mut(&mut self) -> &mut Self::Target {
+        &mut self.inner
+    }
+}
+
+impl Service<Uri> for HttpConnector {
+    type Response = hyper_util::rt::TokioIo<tokio::net::TcpStream>;
+    type Error = BoxError;
+    type Future = Pin<Box<dyn Future<Output = Result<Self::Response, BoxError>> + Send>>;
+
+    fn poll_ready(&mut self, cx: &mut Context<'_>) -> Poll<Result<(), Self::Error>> {
+        match &mut self.tcp {
+            Some(tcp) => tcp.poll_ready(cx),
+            None => self.inner.poll_ready(cx).map_err(Into::into),
+        }
+    }
+
+    fn call(&mut self, dst: Uri) -> Self::Future {
+        match &mut self.tcp {
+            Some(tcp) => {
+                let connecting = tcp.call(dst);
+                let nodelay = self.nodelay;
+                Box::pin(async move {
+                    let stream = connecting.await?;
+                    stream.set_nodelay(nodelay)?;
+                    Ok(hyper_util::rt::TokioIo::new(stream))
+                })
+            }
+            None => {
+                let connecting = self.inner.call(dst);
+                Box::pin(async move { connecting.await.map_err(Into::into) })
+            }
+        }
+    }
+}
 
