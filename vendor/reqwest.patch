+    /// Opens the client's TCP connections, to a site or to a proxy,
+    /// through `connector`, which is given the URI to connect to and
+    /// returns the connected stream, in place of the client's own
+    /// connector.
+    ///
+    /// The client's `tcp_nodelay` is applied to the stream `connector`
+    /// returns, and `connect_timeout` bounds the whole connection as for
+    /// any `connector_layer`. `connector` does the lookup and applies
+    /// every other socket option itself: `local_address`, `interface`,
+    /// the TCP keepalive settings, `tcp_user_timeout`, the resolver and
+    /// Happy Eyeballs are not applied to its connections.
+    pub fn tcp_connector<S>(mut self, connector: S) -> ClientBuilder
+    where
+        S: Service<Uri, Response = tokio::net::TcpStream> + Clone + Send + Sync + 'static,
+        S::Error: Into<BoxError>,
+        S::Future: Send + 'static,
+    {
+        use tower::ServiceExt;
+
+        self.config.tcp_connector = Some(BoxCloneSyncService::new(
+            connector.map_err(Into::into),
+        ));
+        self
+    }
 }
 
