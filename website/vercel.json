{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash vercel-install.sh",
  "buildCommand": "export PATH=\"$HOME/.cargo/bin:$PATH\" && pnpm run build && rm -rf site && mkdir site && cp -R ../target/docs-site/build site/docs",
  "outputDirectory": "site",
  "cleanUrls": true,
  "git": { "deploymentEnabled": { "main": false } },
  "headers": [
    {
      "source": "/docs/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/docs/(.*)llms(-full)?\\.txt",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    }
  ]
}
