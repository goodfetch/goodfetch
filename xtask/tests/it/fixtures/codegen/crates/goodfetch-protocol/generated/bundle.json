{
  "$defs": {
    "CaseLogEntry": {
      "additionalProperties": false,
      "description": "A sample case log entry.",
      "properties": {
        "case": {
          "description": "The case's ID.",
          "type": "string"
        }
      },
      "required": [
        "case"
      ],
      "type": "object"
    },
    "HelloParams": {
      "additionalProperties": false,
      "description": "What a `hello` says, the Connection's own message.",
      "properties": {
        "protocol_version": {
          "description": "The protocol version the sender speaks.",
          "type": "string"
        }
      },
      "required": [
        "protocol_version"
      ],
      "type": "object"
    },
    "Journey": {
      "additionalProperties": false,
      "description": "A sample Journey.",
      "properties": {
        "goal": {
          "description": "What the person achieves.",
          "type": "string"
        },
        "id": {
          "description": "Its ID.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "goal"
      ],
      "type": "object"
    },
    "ResultDocument": {
      "description": "A sample result document.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A sample Journey variant's result.",
          "properties": {
            "journey_id": {
              "description": "The Journey.",
              "type": "string"
            },
            "kind": {
              "const": "journey",
              "type": "string"
            },
            "outcome": {
              "description": "Its outcome.",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "journey_id",
            "outcome"
          ],
          "type": "object"
        }
      ]
    },
    "SampleCrawlParams": {
      "additionalProperties": false,
      "description": "What `sample.crawl` starts from.",
      "properties": {
        "echo": {
          "$ref": "#/$defs/SampleEchoParams",
          "description": "The text each page repeats, a type Collie's catalog defines."
        },
        "pages": {
          "description": "How many pages to visit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "echo",
        "pages"
      ],
      "type": "object"
    },
    "SampleCrawlResult": {
      "description": "What `sample.crawl` answers.",
      "properties": {
        "visited": {
          "description": "How many pages were visited.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "visited"
      ],
      "type": "object"
    },
    "SampleCrawled": {
      "description": "What `sample.crawled` reports.",
      "properties": {
        "visited": {
          "description": "How many pages were visited.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "visited"
      ],
      "type": "object"
    },
    "SampleEchoParams": {
      "additionalProperties": false,
      "description": "What `sample.echo` repeats.",
      "properties": {
        "text": {
          "description": "The text to repeat.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SampleEchoResult": {
      "description": "What `sample.echo` answers.",
      "properties": {
        "text": {
          "description": "The text, repeated.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SampleEchoed": {
      "description": "What `sample.echoed` reports.",
      "properties": {
        "text": {
          "description": "The text that was repeated.",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "SampleStorePutParams": {
      "description": "What a sample store keeps.",
      "properties": {
        "key": {
          "description": "The key to keep the value under.",
          "type": "string"
        },
        "value": {
          "description": "The value to keep.",
          "type": "string"
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "SampleStorePutResult": {
      "additionalProperties": false,
      "description": "What a sample store answers once it kept a value.",
      "properties": {
        "replaced": {
          "description": "Whether a value was already kept under the key.",
          "type": "boolean"
        }
      },
      "required": [
        "replaced"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "connection": {
    "hello": {
      "params": {
        "$ref": "#/$defs/HelloParams"
      }
    }
  },
  "documents": {
    "case_log_entry": {
      "$ref": "#/$defs/CaseLogEntry"
    },
    "result_document": {
      "$ref": "#/$defs/ResultDocument"
    }
  },
  "files": {
    "journeys/J-*.toml": {
      "$ref": "#/$defs/Journey"
    }
  },
  "formats": [
    {
      "hello_from": [],
      "name": "sample-store",
      "rule": "default",
      "schema": {
        "type": "object"
      },
      "storage": "sqlite",
      "version": "0.1"
    }
  ],
  "plugin": {
    "manifest": {
      "type": "object"
    }
  },
  "protocol_version": "0.1",
  "title": "Goodfetch protocol"
}
