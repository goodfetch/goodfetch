==> errors.py
"""The exception class of each of Collie's Error codes (ADR 0079).

Generated by `xtask codegen` from the catalog; never edit by hand.
"""

from __future__ import annotations

from collections.abc import Mapping
from typing import Final, Literal, Unpack

from goodfetch_collie_client.goodfetch_error import ErrorClass, ErrorFields, GoodfetchError

ErrorGroup = Literal["program", "refused", "page", "model", "deadline_exceeded", "unavailable", "internal"]
"""The seven groups of Error codes, named for their remedy."""


class ProgramError(GoodfetchError):
    """The program is wrong: its call, its settings or its own handler code. Fix the program."""


class RefusedError(GoodfetchError):
    """A policy, a Limit, a lock or a person refused. Change a setting, raise the Limit or ask the operator."""


class PageError(GoodfetchError):
    """The page or site never reached the state the call needed. Read the Run trace; change the step, the wait or the Access mode."""


class ModelError(GoodfetchError):
    """The Model provider's answer was unusable. Change the model or the strategy."""


class DeadlineExceededError(GoodfetchError):
    """The deadline passed. Raise it, or wait for the right thing."""


class UnavailableError(GoodfetchError):
    """Something Goodfetch depends on is unreachable or gone. Retry, or fix the setup."""


class InternalError(GoodfetchError):
    """A bug in Goodfetch. Report it."""


class SampleRefusedError(RefusedError):
    """The sample operation refused the text."""

    def __init__(self, message: str, **fields: Unpack[ErrorFields]) -> None:
        """Takes the message the engine rendered, and what it carries."""
        super().__init__(message, code="sample_refused", group="refused", retryable=False, **fields)


ERROR_GROUP_OF_WIRE_CLASS: Final[Mapping[int, ErrorGroup]] = {
    -32001: "program",
    -32002: "refused",
    -32003: "page",
    -32004: "model",
    -32005: "deadline_exceeded",
    -32006: "unavailable",
    -32007: "internal",
}
"""The group of each JSON-RPC error code the engine answers with, its wire class (ADR 0038)."""

ERROR_GROUP_OF_PROTOCOL_FAILURE: Final[Mapping[int, ErrorGroup]] = {
}
"""The group of each JSON-RPC code a failure of the protocol itself takes, which JSON-RPC 2.0 predefines (ADRs 0038 and 0079)."""

ERROR_GROUP_CLASSES: Final[Mapping[ErrorGroup, type[GoodfetchError]]] = {
    "program": ProgramError,
    "refused": RefusedError,
    "page": PageError,
    "model": ModelError,
    "deadline_exceeded": DeadlineExceededError,
    "unavailable": UnavailableError,
    "internal": InternalError,
}
"""The class of each group, which raises a code the SDK does not know, keeping the code (ADR 0079)."""


ERROR_CLASSES: Final[Mapping[str, ErrorClass]] = {
    "sample_refused": SampleRefusedError,
}
"""The exception class of each Error code."""
