==> errors.py
"""The exception class of each of Collie's Error codes (ADR 0079).

Generated by `xtask codegen` from the catalog; never edit by hand.
"""

from __future__ import annotations

from collections.abc import Callable, Mapping
from typing import Final, Literal

from goodfetch_collie_client.goodfetch_error import GoodfetchError

ErrorGroup = Literal["program", "refused", "page", "model", "deadline_exceeded", "unavailable", "internal"]
"""The seven groups of Error codes, named for their remedy."""


class ProgramError(GoodfetchError):
    """The program is wrong: its call, its settings or its own handler code. Fix the program."""


class RefusedError(GoodfetchError):
    """A policy, a Limit, a lock or a person refused. Change a setting, raise the Limit or ask the operator."""


class PageError(GoodfetchError):
    """The page or site never reached the state the call needed. Read the Run trace; change the step, the wait or the Access mode."""


class ModelError(GoodfetchError):
    """The Model provider's answer was unusable. Change the model or the strategy."""


class DeadlineExceededError(GoodfetchError):
    """The deadline passed. Raise it, or wait for the right thing."""


class UnavailableError(GoodfetchError):
    """Something Goodfetch depends on is unreachable or gone. Retry, or fix the setup."""


class InternalError(GoodfetchError):
    """A bug in Goodfetch. Report it."""


class SampleRefusedError(RefusedError):
    """The sample operation refused the text."""

    def __init__(self, message: str) -> None:
        """Takes the message the engine rendered."""
        super().__init__(message, code="sample_refused", group="refused", retryable=False)


ERROR_CLASSES: Final[Mapping[str, Callable[[str], GoodfetchError]]] = {
    "sample_refused": SampleRefusedError,
}
"""The exception class of each Error code."""
