from __future__ import annotations

from goodfetch_collie_client.caller import AsyncCaller, Caller, result_of

from .models import SampleCrawlParams, SampleCrawlResult


class AsyncFoxhoundOperations:
    """Foxhound's operations, each an async method."""

    def __init__(self, caller: AsyncCaller) -> None:
        """Takes the runtime that sends each call."""
        self._caller = caller

    async def sample_crawl(self, params: SampleCrawlParams) -> SampleCrawlResult:
        """Visits sample pages, each repeating a text."""
        return result_of(SampleCrawlResult, await self._caller.call("sample.crawl", params))


class FoxhoundOperations:
    """Foxhound's operations, each a sync method."""

    def __init__(self, caller: Caller) -> None:
        """Takes the runtime that sends each call."""
        self._caller = caller

    def sample_crawl(self, params: SampleCrawlParams) -> SampleCrawlResult:
        """Visits sample pages, each repeating a text."""
        return result_of(SampleCrawlResult, self._caller.call("sample.crawl", params))
