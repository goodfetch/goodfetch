==> operations.ts
// Generated by `xtask codegen` from the catalog; never edit by hand.

import type { SampleEchoParams, SampleEchoResult } from "./types.js";

/** The options of a call that can be cancelled (ADR 0038). */
export interface CallOptions {
  /** Cancels the call in flight when it aborts. */
  readonly signal?: AbortSignal | undefined;
}

/** The params and result of one operation. */
export interface OperationTypes {
  readonly params: unknown;
  readonly result: unknown;
}

/**
 * What sends a call and answers its result: the client package's runtime.
 * Results are not validated beyond the protocol version check (STYLE.md).
 */
export interface Caller<Types extends Record<keyof Types, OperationTypes>> {
  call<Name extends keyof Types & string>(
    operation: Name,
    params: Types[Name]["params"],
    options: CallOptions,
  ): Promise<Types[Name]["result"]>;
}

/** The params and result of each of Collie's operations. */
export interface CollieOperationTypes {
  "sample.echo": { params: SampleEchoParams; result: SampleEchoResult };
}

/** Collie's operations, each an async method. */
export class CollieOperations {
  readonly #caller: Caller<CollieOperationTypes>;

  constructor(caller: Caller<CollieOperationTypes>) {
    this.#caller = caller;
  }

  /**
   * Repeats a text back to the caller.
   *
   * @experimental
   * @deprecated Since 0.1: A sample entry, which the real catalog replaces.
   */
  sampleEcho(params: SampleEchoParams, options: CallOptions = {}): Promise<SampleEchoResult> {
    return this.#caller.call("sample.echo", params, options);
  }
}
