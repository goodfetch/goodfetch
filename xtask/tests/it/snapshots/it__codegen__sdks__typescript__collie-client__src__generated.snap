==> errors.ts
// Generated by `xtask codegen` from the catalog; never edit by hand.

import {
  GoodfetchError,
  isGoodfetchError,
  retryAfterOf,
  type ErrorClass,
  type ErrorFields,
  type ErrorIdentity,
  type ErrorLimit,
} from "../goodfetch-error.ts";

export {
  GoodfetchError,
  isGoodfetchError,
  retryAfterOf,
  type ErrorClass,
  type ErrorFields,
  type ErrorIdentity,
  type ErrorLimit,
};

/** The seven groups of Error codes, named for their remedy (ADR 0079). */
export type ErrorGroup = "program" | "refused" | "page" | "model" | "deadline_exceeded" | "unavailable" | "internal";

/**
 * The program is wrong: its call, its settings or its own handler code. Fix the program.
 */
export class ProgramError<Code extends string = string> extends GoodfetchError<Code> {
  declare readonly group: "program";

  constructor(message: string, init: ErrorFields & ErrorIdentity<Code>) {
    super(message, { name: "ProgramError", ...init });
  }
}

/**
 * A policy, a Limit, a lock or a person refused. Change a setting, raise the Limit or ask the operator.
 */
export class RefusedError<Code extends string = string> extends GoodfetchError<Code> {
  declare readonly group: "refused";

  constructor(message: string, init: ErrorFields & ErrorIdentity<Code>) {
    super(message, { name: "RefusedError", ...init });
  }
}

/**
 * The page or site never reached the state the call needed. Read the Run trace; change the step, the wait or the Access mode.
 */
export class PageError<Code extends string = string> extends GoodfetchError<Code> {
  declare readonly group: "page";

  constructor(message: string, init: ErrorFields & ErrorIdentity<Code>) {
    super(message, { name: "PageError", ...init });
  }
}

/**
 * The Model provider's answer was unusable. Change the model or the strategy.
 */
export class ModelError<Code extends string = string> extends GoodfetchError<Code> {
  declare readonly group: "model";

  constructor(message: string, init: ErrorFields & ErrorIdentity<Code>) {
    super(message, { name: "ModelError", ...init });
  }
}

/**
 * The deadline passed. Raise it, or wait for the right thing.
 */
export class DeadlineExceededError<Code extends string = string> extends GoodfetchError<Code> {
  declare readonly group: "deadline_exceeded";

  constructor(message: string, init: ErrorFields & ErrorIdentity<Code>) {
    super(message, { name: "DeadlineExceededError", ...init });
  }
}

/**
 * Something Goodfetch depends on is unreachable or gone. Retry, or fix the setup.
 */
export class UnavailableError<Code extends string = string> extends GoodfetchError<Code> {
  declare readonly group: "unavailable";

  constructor(message: string, init: ErrorFields & ErrorIdentity<Code>) {
    super(message, { name: "UnavailableError", ...init });
  }
}

/**
 * A bug in Goodfetch. Report it.
 */
export class InternalError<Code extends string = string> extends GoodfetchError<Code> {
  declare readonly group: "internal";

  constructor(message: string, init: ErrorFields & ErrorIdentity<Code>) {
    super(message, { name: "InternalError", ...init });
  }
}

/** The group of each JSON-RPC error code the engine answers with, its wire class (ADR 0038). */
export const errorGroupOfWireClass: Readonly<Record<number, ErrorGroup>> = {
  [-32001]: "program",
  [-32002]: "refused",
  [-32003]: "page",
  [-32004]: "model",
  [-32005]: "deadline_exceeded",
  [-32006]: "unavailable",
  [-32007]: "internal",
};

/** The group of each JSON-RPC code a failure of the protocol itself takes, which JSON-RPC 2.0 predefines (ADRs 0038 and 0079). */
export const errorGroupOfProtocolFailure: Readonly<Record<number, ErrorGroup>> = {
};

/** The class of each group, which raises a code the SDK does not know, keeping the code (ADR 0079). */
export const errorGroupClasses: Readonly<Record<ErrorGroup, typeof GoodfetchError>> = {
  program: ProgramError,
  refused: RefusedError,
  page: PageError,
  model: ModelError,
  deadline_exceeded: DeadlineExceededError,
  unavailable: UnavailableError,
  internal: InternalError,
};

/**
 * The sample operation refused the text.
 */
export class SampleRefusedError extends RefusedError<"sample_refused"> {
  constructor(message: string, fields: ErrorFields = {}) {
    super(message, { ...fields, name: "SampleRefusedError", code: "sample_refused", group: "refused", retryable: false });
  }
}

/** The error class of each of Collie's Error codes. */
export const collieErrorClasses: Readonly<Record<string, ErrorClass>> = {
  sample_refused: SampleRefusedError,
};

/** Collie's own Error codes. */
export type CollieErrorCode =
  | "sample_refused";

const collieErrorCodes: ReadonlySet<string> = new Set<CollieErrorCode>(["sample_refused"]);

/** An error with one of the Error codes Collie raises, which its `code` narrows to the code's class. */
export type CollieError =
  | SampleRefusedError;

/** Whether `value` is an error with one of the Error codes Collie raises, from any copy of the package. */
export function isCollieError(value: unknown): value is CollieError {
  return isGoodfetchError(value) && collieErrorCodes.has(value.code);
}
