==> errors.ts
// Generated by `xtask codegen` from the catalog; never edit by hand.

import { GoodfetchError, type ErrorClass, type ErrorFields } from "../goodfetch-error.ts";

export { GoodfetchError, type ErrorClass, type ErrorFields };

/** The seven groups of Error codes, named for their remedy (ADR 0079). */
export type ErrorGroup = "program" | "refused" | "page" | "model" | "deadline_exceeded" | "unavailable" | "internal";

/**
 * The program is wrong: its call, its settings or its own handler code. Fix the program.
 */
export class ProgramError extends GoodfetchError {}

/**
 * A policy, a Limit, a lock or a person refused. Change a setting, raise the Limit or ask the operator.
 */
export class RefusedError extends GoodfetchError {}

/**
 * The page or site never reached the state the call needed. Read the Run trace; change the step, the wait or the Access mode.
 */
export class PageError extends GoodfetchError {}

/**
 * The Model provider's answer was unusable. Change the model or the strategy.
 */
export class ModelError extends GoodfetchError {}

/**
 * The deadline passed. Raise it, or wait for the right thing.
 */
export class DeadlineExceededError extends GoodfetchError {}

/**
 * Something Goodfetch depends on is unreachable or gone. Retry, or fix the setup.
 */
export class UnavailableError extends GoodfetchError {}

/**
 * A bug in Goodfetch. Report it.
 */
export class InternalError extends GoodfetchError {}

/** The group of each JSON-RPC error code the engine answers with, its wire class (ADR 0038). */
export const errorGroupOfWireClass: Readonly<Record<number, ErrorGroup>> = {
  [-32001]: "program",
  [-32002]: "refused",
  [-32003]: "page",
  [-32004]: "model",
  [-32005]: "deadline_exceeded",
  [-32006]: "unavailable",
  [-32007]: "internal",
};

/** The class of each group, which raises a code the SDK does not know, keeping the code (ADR 0079). */
export const errorGroupClasses: Readonly<Record<ErrorGroup, typeof GoodfetchError>> = {
  program: ProgramError,
  refused: RefusedError,
  page: PageError,
  model: ModelError,
  deadline_exceeded: DeadlineExceededError,
  unavailable: UnavailableError,
  internal: InternalError,
};

/**
 * The sample operation refused the text.
 */
export class SampleRefusedError extends RefusedError {
  constructor(message: string, fields: ErrorFields = {}) {
    super(message, { ...fields, code: "sample_refused", group: "refused", retryable: false });
  }
}

/** The error class of each of Collie's Error codes. */
export const collieErrorClasses: Readonly<Record<string, ErrorClass>> = {
  sample_refused: SampleRefusedError,
};
