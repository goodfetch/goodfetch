==> connection.ts
// Generated by `xtask codegen` from the catalog; never edit by hand.

/** The protocol version `major.minor` this package's `hello` names (ADRs 0024 and 0066). */
export const PROTOCOL_VERSION = "0.1";

/** The WebSocket subprotocol a Client offers an Exposed Daemon, `goodfetch.v<major>` of the protocol version (ADR 0049). */
export const WEBSOCKET_SUBPROTOCOL = "goodfetch.v0";

/** The Product version this package carries, `hello`'s `product_version`, which each Product's package pins exactly (ADRs 0090 and 0095). */
export const PRODUCT_VERSION = "0.0.0";

/** The executable's hidden command that serves one Connection over stdio. */
export const ATTACHED_ENGINE_COMMAND = "attached-engine";

/** The prefix every deployment variable has, which ADR 0034 reserves. */
export const DEPLOYMENT_PREFIX = "GOODFETCH_";

/** The deployment variables, the closed list of `GOODFETCH_` variables `connect()` takes from its environment map (ADR 0083). */
export const DEPLOYMENT_VARIABLES = [
  "GOODFETCH_BROWSERS_PATH",
  "GOODFETCH_CHANNEL",
  "GOODFETCH_COLLIE_ENGINE_PATH",
  "GOODFETCH_DAEMON_ADDRESS",
  "GOODFETCH_DAEMON_DRAIN_GRACE",
  "GOODFETCH_FOXHOUND_ENGINE_PATH",
  "GOODFETCH_HOME",
  "GOODFETCH_OPS_ADDRESS",
  "GOODFETCH_TEST_SEED",
  "GOODFETCH_TOKEN",
  "GOODFETCH_URL",
] as const;

/** The variable naming Collie's executable (ADR 0090). */
export const COLLIE_ENGINE_PATH_VARIABLE = "GOODFETCH_COLLIE_ENGINE_PATH";

/** The name of Collie's executable (ADR 0090). */
export const COLLIE_EXECUTABLE = "goodfetch-collie";
==> operations.ts
// Generated by `xtask codegen` from the catalog; never edit by hand.

import type { CallOptions, Caller } from "../caller.ts";
import { type EntryMarkers, warnDeprecated, warnExperimental } from "../markers.ts";
import type { SampleEchoParams, SampleEchoResult } from "./types.ts";

export type { CallOptions, Caller, OperationTypes } from "../caller.ts";

/** The params and result of each of Collie's operations. */
export interface CollieOperationTypes {
  "sample.echo": { params: SampleEchoParams; result: SampleEchoResult };
}

/** The registry of Collie's operations, with their markers, which a hand-written member serving one warns of through `warnEntry` (ADR 0099). */
export const collieOperations: Readonly<Record<keyof CollieOperationTypes, EntryMarkers>> = {
  "sample.echo": { experimental: true, deprecated: "Since 0.1, removed no earlier than 1.0: A sample entry, which the real catalog replaces." },
};

/** The name of each of Collie's operations in TypeScript form, which the runtime's own errors head a call with (ADR 0079's note of 2026-11-19). */
export const collieOperationNames: Readonly<Record<keyof CollieOperationTypes, string>> = {
  "sample.echo": "sample.echo",
};

/** The class of each of Collie's operations (ADR 0011): after a reconnect, a call in flight is sent again only when it is a read or an idempotent write (ADR 0079). */
export const collieOperationClasses: Readonly<Record<keyof CollieOperationTypes, "read" | "idempotent_write" | "effect">> = {
  "sample.echo": "read",
};

/** Collie's operations that send a message, each an async method. */
export class CollieOperations {
  readonly #caller: Caller<CollieOperationTypes>;

  constructor(caller: Caller<CollieOperationTypes>) {
    this.#caller = caller;
  }

  /**
   * Repeats a text back to the caller.
   *
   * @experimental
   * @deprecated Since 0.1, removed no earlier than 1.0: A sample entry, which the real catalog replaces.
   */
  sampleEcho(params: SampleEchoParams, options: CallOptions = {}): Promise<SampleEchoResult> {
    warnExperimental("sample.echo");
    warnDeprecated("sample.echo", "Since 0.1, removed no earlier than 1.0: A sample entry, which the real catalog replaces.");
    return this.#caller.call("sample.echo", params, options);
  }
}
