==> errors.ts
// Generated by `xtask codegen` from the catalog; never edit by hand.

import { RefusedError, isCollieError, isGoodfetchError } from "@goodfetch/collie-client/generated";
import type { CollieError, ErrorClass, ErrorFields } from "@goodfetch/collie-client/generated";

/**
 * The sample crawl refused its pages.
 */
export class SampleCrawlRefusedError extends RefusedError<"sample_crawl_refused"> {
  constructor(message: string, fields: ErrorFields = {}) {
    super(message, { ...fields, name: "SampleCrawlRefusedError", code: "sample_crawl_refused", group: "refused", retryable: true });
  }
}

/** The error class of each of Foxhound's Error codes. */
export const foxhoundErrorClasses: Readonly<Record<string, ErrorClass>> = {
  sample_crawl_refused: SampleCrawlRefusedError,
};

/** Foxhound's own Error codes. */
export type FoxhoundErrorCode =
  | "sample_crawl_refused";

const foxhoundErrorCodes: ReadonlySet<string> = new Set<FoxhoundErrorCode>(["sample_crawl_refused"]);

/** An error with one of the Error codes Foxhound raises, which its `code` narrows to the code's class. */
export type FoxhoundError =
  | CollieError
  | SampleCrawlRefusedError;

/** Whether `value` is an error with one of the Error codes Foxhound raises, from any copy of the package. */
export function isFoxhoundError(value: unknown): value is FoxhoundError {
  return isCollieError(value) || (isGoodfetchError(value) && foxhoundErrorCodes.has(value.code));
}
