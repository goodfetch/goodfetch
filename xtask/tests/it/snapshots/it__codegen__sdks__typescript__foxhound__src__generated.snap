import type { CallOptions, Caller } from "@goodfetch/collie-client/generated";
import type { SampleCrawlParams, SampleCrawlResult } from "./types.ts";

/** The params and result of each of Foxhound's operations. */
export interface FoxhoundOperationTypes {
  "sample.crawl": { params: SampleCrawlParams; result: SampleCrawlResult };
}

/** Foxhound's operations, each an async method. */
export class FoxhoundOperations {
  readonly #caller: Caller<FoxhoundOperationTypes>;

  constructor(caller: Caller<FoxhoundOperationTypes>) {
    this.#caller = caller;
  }

  /**
   * Visits sample pages, each repeating a text.
   */
  sampleCrawl(params: SampleCrawlParams): Promise<SampleCrawlResult> {
    return this.#caller.call("sample.crawl", params, {});
  }
}
